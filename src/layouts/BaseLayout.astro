---
import "../styles/vars.css";
import "../styles/content.css";
import "../styles/layout.css";

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  subtitle?: string;
  bodyClass?: string;
}







const {
  title = "ELKE PFAFFMANN",
  subtitle = "GLAS – LICHT – ARCHITEKTUR",
  bodyClass = "",
} = Astro.props;

// Auto-versioning: Use timestamp to bust cache on every reload (FORCE_RELOAD_20240817)
const v = Date.now().toString();

---

<html lang="en">

	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
				<link rel="stylesheet" href="/styles/flipbook-modal.css" />
		<script is:inline>
			(function(){
				var v=Date.now();
				document.querySelector('link[rel="stylesheet"]').href+='?v='+v;
			})();
		</script>
		</head>

	<body class={`site-wrapper ${bodyClass}`.trim()}>
		<Header title={title} subtitle={subtitle} />
        <main id="site-main" class="site-main">
            <div id="swup" class="transition-fade">
                <slot />
            </div>
        </main>
		<Footer title={title} />
		
		<!-- Global Flipbook Modal -->
		<dialog id="fb-modal" class="fb-modal">
			<div class="fb-modal-inner">
				<div class="fb-modal-toolbar" id="fb-modal-toolbar">
					<a href="#" class="fb-btn fb-btn-download" id="fb-download" download aria-label="Katalog herunterladen">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
							<polyline points="7 10 12 15 17 10"/>
							<line x1="12" y1="15" x2="12" y2="3"/>
						</svg>
						<span>PDF</span>
					</a>
					<button class="fb-btn fb-btn-close" aria-label="Katalog schließen">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
						<span>Schließen</span>
					</button>
				</div>
				<div class="fb-progress-track" id="fb-progress-track" aria-hidden="true">
					<div class="fb-progress-fill" id="fb-progress-fill" style="width:0%"></div>
				</div>
				<div class="fb-modal-content" id="fb-modal-content"></div>
			</div>
		</dialog>
		
				<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
				<script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js"></script>
								<script is:inline>
															(function(){
																var v = Date.now();
																// Global version guard: prevent any previously cached scripts from running
																window.__FB_SCRIPT_VERSION = v;
								
																window.__CATALOGS={glas:{title:'Katalog Fusingglas',pdf:'/kataloge/glas_split_vertically_and_scaled.pdf'},malerei:{title:'Katalog Malerei',pdf:'/kataloge/malerei.pdf'}};
												
																// CRITICAL: Remove any previously loaded flipbook scripts from DOM
																// This prevents old cached versions from initializing the flipbook
																var oldScripts = document.querySelectorAll('script[src*="flipbook-"]');
																oldScripts.forEach(function(s) { s.remove(); });
												
																// CRITICAL: Reset Flipbook namespace to prevent old state from leaking
																window.Flipbook = null;
																window.__FB_VERSION = 0;
																window.__FB_CONFIG_LOADED = false;
												
																// Load flipbook scripts SEQUENTIALLY with cache-busting timestamp
																// This ensures config.js loads before main.js, preventing race conditions
																var scripts = ['config','pdf','stairs','spine-render','spine-state','events','init','main','modal'];
																var idx = 0;
																function loadNext() {
																	if (idx >= scripts.length) return;
																	var n = scripts[idx++];
																	var s = document.createElement('script');
																	s.src = '/js/flipbook-' + n + '.js?v=' + v;
																	s.onload = loadNext;
																	s.onerror = loadNext;
																	document.body.appendChild(s);
																}
																loadNext();
															})();
														</script>
	</body>

</html>
