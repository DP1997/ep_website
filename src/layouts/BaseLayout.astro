---
import "../styles/vars.css";
import "../styles/content.css";
import "../styles/layout.css";

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { FLIPBOOK_VERSION } from '../flipbook-version';

// Basis-Pfad (GitHub Pages: /ep_website/). Alle internen Links/Assets werden
// damit geprefixt, damit die Site unter einer Unter-URL korrekt funktioniert.
const BASE_URL = import.meta.env.BASE_URL;

interface Props {
  subtitle?: string;
  bodyClass?: string;
}








const {
  subtitle = "GLAS – LICHT – ARCHITEKTUR",
  bodyClass = "",
} = Astro.props;

// Der Webseiten-Titel ist überall konstant (Browser-Tab, Header-Logo, Footer)
// und ändert sich auf keiner Unterseite.
const SITE_TITLE = "Elke Pfaffmann";

---

<html lang="de">

	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${BASE_URL}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{SITE_TITLE}</title>
		<link rel="stylesheet" href={`${BASE_URL}styles/flipbook-modal.css?v=${FLIPBOOK_VERSION}`} />
		</head>

	<body class={`site-wrapper ${bodyClass}`.trim()}>
		<Header title={SITE_TITLE} subtitle={subtitle} />
        <main id="site-main" class="site-main">
            <div id="swup" class="transition-fade">
                <slot />
            </div>
        </main>
		<Footer title={SITE_TITLE} />
		
		<!-- Global Flipbook Modal -->
		<dialog id="fb-modal" class="fb-modal">
			<div class="fb-modal-inner">
				<div class="fb-modal-toolbar" id="fb-modal-toolbar">
					<a href="#" class="fb-btn fb-btn-download" id="fb-download" download aria-label="Katalog herunterladen">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
							<polyline points="7 10 12 15 17 10"/>
							<line x1="12" y1="15" x2="12" y2="3"/>
						</svg>
						<span>PDF</span>
					</a>
					<button class="fb-btn fb-btn-close" aria-label="Katalog schließen">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
						<span>Schließen</span>
					</button>
				</div>
				<div class="fb-progress-track" id="fb-progress-track" aria-hidden="true">
					<div class="fb-progress-fill" id="fb-progress-fill" style="width:0%"></div>
				</div>
				<div class="fb-modal-content" id="fb-modal-content"></div>
			</div>
		</dialog>
		
		<script type="module" src={`${BASE_URL}js/pdfjs-loader.mjs?v=${FLIPBOOK_VERSION}`}></script>
		<script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js"></script>
		<script is:inline define:vars={{ FLIPBOOK_VERSION, BASE_URL }}>
			(function(){
				window.__FLIPBOOK_VERSION = FLIPBOOK_VERSION;
				window.__BASE_URL = BASE_URL;
				window.__CATALOGS = {
					glas:    { title: 'Katalog Fusingglas', pdf: BASE_URL + 'kataloge/glas_split_vertically_and_scaled.pdf' },
					malerei: { title: 'Katalog Malerei',    pdf: BASE_URL + 'kataloge/malerei.pdf' }
				};

				// Load flipbook modules sequentially (config first) with a single
				// shared cache-busting version. The modules depend on window.pdfjsLib,
				// which is set asynchronously by pdfjs-loader.mjs, so we wait for the
				// 'pdfjs-ready' event before starting the load chain.
				var scripts = ['config','pdf','spine','events','init','modal'];
				var idx = 0;
				function loadNext() {
					if (idx >= scripts.length) return;
					var n = scripts[idx++];
					var s = document.createElement('script');
					s.src = BASE_URL + 'js/flipbook-' + n + '.js?v=' + FLIPBOOK_VERSION;
					s.onload = loadNext;
					s.onerror = loadNext;
					document.body.appendChild(s);
				}
				function start() {
					window.removeEventListener('pdfjs-ready', start);
					loadNext();
				}
				if (window.pdfjsLib) {
					loadNext();
				} else {
					window.addEventListener('pdfjs-ready', start);
				}
			})();
		</script>
	</body>

</html>
