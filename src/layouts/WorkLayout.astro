---
import BaseLayout from './BaseLayout.astro';
import WorkFigure from '../components/WorkFigure.astro';
import WorkCopy from '../components/WorkCopy.astro';
import WorkNav from '../components/WorkNav.astro';
import '../styles/components/work-contract.css';

interface Props {
  frontmatter: {
    title: string;
    location?: string;
    description?: string;
    date: string;
    client?: string;
    image_layout: string;
    image_dir: string;
    lightbox_max?: boolean;
    dim?: boolean;
    variant_of?: string;
  };
  category?: string;
  slug?: string;
}

const { frontmatter, category, slug } = Astro.props;
const dim = frontmatter.dim === true;

// Alle Bilder des Worktrees (für Massangaben und Lightbox).
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,JPG}',
  { eager: true }
);

function getImage(dir: string, num: number): ImageMetadata | null {
  const find = (suffix: string) => {
    const key = Object.keys(allImages).find((k) =>
      new RegExp(`/${dir}/${num}-${suffix}\\.jpe?g$`, 'i').test(k)
    );
    return key ? allImages[key].default : null;
  };
  return (
    find('16x') ??
    find('4x') ??
    (() => {
      const key = Object.keys(allImages).find((k) =>
        new RegExp(`/${dir}/${num}\\.jpe?g$`, 'i').test(k)
      );
      return key ? allImages[key].default : null;
    })()
  );
}

const dir = frontmatter.image_dir;
const galleryCount =
  frontmatter.image_layout === '1-3e'
    ? 4
    : parseInt(frontmatter.image_layout.split('-')[1] || '0', 10);

const heroImg = getImage(dir, 1);
const gallery = Array.from({ length: galleryCount }, (_, i) => ({
  img: getImage(dir, i + 2),
  index: i + 2
})).filter((g) => g.img !== null) as { img: ImageMetadata; index: number }[];

const C = gallery.length;
const arOf = (img: ImageMetadata) => img.width / img.height;
const galleryAR = gallery.map((g) => arOf(g.img));
const colsTemplate = galleryAR.map((a) => `${a}fr`).join(' ');
const arSum = galleryAR.reduce((a, b) => a + b, 0);

// Basis mit hohem Hero (Portrait): Hero in Strip-Spalte 1, Copy (Meta/Body
// via Subgrid) in den restlichen Strip-Spalten. Querformat/breite Hero:
// Copy als eigene Zeile.
const heroAR = heroImg ? arOf(heroImg) : 1;
const portraitHero = heroAR < 0.95 && C >= 2;
const heroFirstPct = arSum
  ? Math.round((galleryAR[0] / arSum) * 82)
  : 82;
const heroFirstSizes = `(min-width: 741px) ${heroFirstPct}vw, 92vw`;
const pairTemplate = C >= 1
  ? `grid-template-columns: ${heroAR}fr ${galleryAR[0]}fr;`
  : '';

// Dim: 2-Spalten-Stack ohne Crop. Hauptspalte = Hero (spannt alle Detailzeilen),
// Detailspalte = alle Galeriebilder untereinander; Copy als eigene Zeile.
// Spaltenbreiten werden so gelöst, dass Hero-Höhe = Summe der Detail-Höhen.
const stackSumInv = gallery.reduce((s, g) => s + 1 / arOf(g.img), 0);
const gapFrac = 0.015;
// Exakt: Hero-Höhe = Summe der Detailhöhen + (C-1) Gaps.
// s = (1/heroAR - gap*(C-1)) / (Σ1/ar_i + 1/heroAR)
const stackExact = C >= 1
  ? (1 / heroAR - gapFrac * (C - 1)) / (stackSumInv + 1 / heroAR)
  : 0;
const stackSFrac = C >= 1 ? Math.max(0.12, Math.min(0.6, stackExact)) : 0;
const stackMFrac = 1 - stackSFrac;
// Sehr breiter Hero oder sehr breites Detail: Band-Ordnung statt Stack,
// damit der Hero das größte Bild bleibt und nichts beschnitten wird.
const dimBand =
  heroAR >= 2.5 ||
  (C === 1 && stackExact > 0.6) ||
  stackExact < 0.12;
const pairC1 = C === 1 && galleryAR[0] <= heroAR * 1.2;
const stackTemplate = `grid-template-columns: ${stackMFrac}fr ${stackSFrac}fr; grid-template-rows: repeat(${C}, auto) auto;`;

// Lightbox: Hero + Galerie in Originalgröße.
const lightboxImages = [
  ...(heroImg ? [{ img: heroImg, alt: frontmatter.title }] : []),
  ...gallery.map((g) => ({
    img: g.img,
    alt: `${frontmatter.title} — Bild ${g.index}`
  }))
];
const lightboxData = lightboxImages.map((item) => ({
  src: item.img.src,
  alt: item.alt
}));

const heroSizes = '(min-width: 741px) 82vw, 92vw';
const pairSizes = '(min-width: 741px) 41vw, 46vw';
const stripSizes = '(min-width: 741px) 33vw, 46vw';
---

<BaseLayout>
  <div class="wc" data-layout={dim ? 'dim' : 'base'} data-work={frontmatter.variant_of ?? ''}>
    {dim ? (
      dimBand ? (
        <>
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              eager
              sizes={heroSizes}
              widths={[800, 1200, 1600, 2000]}
            />
          )}
          <div class="wc-strip" style={`grid-template-columns: ${colsTemplate};`}>
            {gallery.map((g, i) => (
              <WorkFigure
                img={g.img}
                alt={`${frontmatter.title} — Bild ${g.index}`}
                index={i + 1}
                sizes={stripSizes}
              />
            ))}
          </div>
          <WorkCopy frontmatter={frontmatter} dim={dim} variant="wide">
            <slot />
          </WorkCopy>
        </>
      ) : C >= 1 ? (
        <div class="wc-stack" style={`${stackTemplate}`}>
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              style={`grid-column: 1; grid-row: 1 / span ${C};`}
              eager
              sizes="(min-width: 741px) 55vw, 92vw"
              widths={[800, 1200, 1600]}
            />
          )}
          {gallery.map((g, i) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={i + 1}
              style={`grid-column: 2; grid-row: ${i + 1};`}
              sizes="(min-width: 741px) 25vw, 46vw"
            />
          ))}
          <WorkCopy
            frontmatter={frontmatter}
            dim={dim}
            variant="wide"
            style={`grid-column: 1 / span 2; grid-row: ${C + 1};`}
          >
            <slot />
          </WorkCopy>
        </div>
      ) : (
        <div class="wc-dim">
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              eager
              sizes={heroSizes}
              widths={[800, 1200, 1600, 2000]}
            />
          )}
          <div class="wc-row wc-row--copy">
            <WorkCopy frontmatter={frontmatter} dim={dim} variant="wide">
              <slot />
            </WorkCopy>
          </div>
        </div>
      )
    ) : C === 0 ? (
      <>
        <WorkCopy frontmatter={frontmatter} dim={dim} variant="wide">
          <slot />
        </WorkCopy>
        {heroImg && (
          <WorkFigure
            img={heroImg}
            alt={frontmatter.title}
            index={0}
            figureClass="wc-hero"
            eager
            sizes={heroSizes}
            widths={[800, 1200, 1600, 2000]}
          />
        )}
      </>
    ) : C === 1 ? (
      <>
        <WorkCopy frontmatter={frontmatter} dim={dim} variant="wide">
          <slot />
        </WorkCopy>
        {pairC1 ? (
          <div class="wc-pair" style={pairTemplate}>
            {heroImg && (
              <WorkFigure
                img={heroImg}
                alt={frontmatter.title}
                index={0}
                figureClass="wc-hero"
                eager
                sizes={pairSizes}
                widths={[600, 900, 1200]}
              />
            )}
            <WorkFigure
              img={gallery[0].img}
              alt={`${frontmatter.title} — Bild ${gallery[0].index}`}
              index={1}
              sizes={pairSizes}
            />
          </div>
        ) : (
          <>
            {heroImg && (
              <WorkFigure
                img={heroImg}
                alt={frontmatter.title}
                index={0}
                figureClass="wc-hero"
                eager
                sizes={heroSizes}
                widths={[800, 1200, 1600, 2000]}
              />
            )}
            <WorkFigure
              img={gallery[0].img}
              alt={`${frontmatter.title} — Bild ${gallery[0].index}`}
              index={1}
              sizes={heroSizes}
              widths={[800, 1200, 1600, 2000]}
            />
          </>
        )}
      </>
    ) : portraitHero ? (
      <>
        <div class="wc-top" style={`grid-template-columns: ${colsTemplate};`}>
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              style="grid-column: 1;"
              eager
              sizes={heroFirstSizes}
              widths={[800, 1200, 1600]}
            />
          )}
          <WorkCopy
            frontmatter={frontmatter}
            dim={dim}
            variant={C >= 3 ? 'subgrid' : 'beside'}
            style="grid-column: 2 / -1;"
          >
            <slot />
          </WorkCopy>
        </div>
        <div class="wc-strip" style={`grid-template-columns: ${colsTemplate};`}>
          {gallery.map((g, i) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={i + 1}
              sizes={stripSizes}
            />
          ))}
        </div>
      </>
    ) : (
      <>
        <WorkCopy frontmatter={frontmatter} dim={dim} variant="wide">
          <slot />
        </WorkCopy>
        {heroImg && (
          <WorkFigure
            img={heroImg}
            alt={frontmatter.title}
            index={0}
            figureClass="wc-hero"
            eager
            sizes={heroSizes}
            widths={[800, 1200, 1600, 2000]}
          />
        )}
        <div class="wc-strip" style={`grid-template-columns: ${colsTemplate};`}>
          {gallery.map((g, i) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={i + 1}
              sizes={stripSizes}
            />
          ))}
        </div>
      </>
    )}
  </div>

  {category && slug && <WorkNav category={category} slug={slug} />}

  <!-- Lightbox: Gesamtansicht des angeklickten Bildes (voll, unbeschnitten). -->
  <dialog class:list={[{ 'work-lightbox': true, 'work-lightbox--max': frontmatter.lightbox_max !== false }]} id="work-lightbox" aria-label="Bild in voller Größe">
    <div class="work-lightbox__stage">
      <img id="work-lightbox-img" alt="" />
    </div>
    <button type="button" class="work-lightbox__close" id="work-lightbox-close" aria-label="Schließen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <button type="button" class="work-lightbox__nav work-lightbox__nav--prev" id="work-lightbox-prev" aria-label="Vorheriges Bild">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="work-lightbox__nav work-lightbox__nav--next" id="work-lightbox-next" aria-label="Nächstes Bild">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </dialog>

  <script define:vars={{ lightboxData }}>
    const lightboxImages = lightboxData;
    const lightbox = document.getElementById('work-lightbox');
    const lightboxImg = document.getElementById('work-lightbox-img');
    const lightboxClose = document.getElementById('work-lightbox-close');
    const lightboxPrev = document.getElementById('work-lightbox-prev');
    const lightboxNext = document.getElementById('work-lightbox-next');
    let lightboxIndex = 0;

    function showLightbox(index) {
      if (!lightbox || !lightboxImages.length) return;
      if (!lightbox.open) lightbox.showModal();
      lightboxIndex = (index + lightboxImages.length) % lightboxImages.length;
      const item = lightboxImages[lightboxIndex];
      lightboxImg.src = item.src;
      lightboxImg.alt = item.alt;
      lightboxPrev.hidden = lightboxImages.length < 2;
      lightboxNext.hidden = lightboxImages.length < 2;
    }

    function closeLightbox() {
      if (lightbox && lightbox.open) lightbox.close();
    }

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-lightbox]');
      if (btn) showLightbox(parseInt(btn.dataset.lightbox, 10));
    });

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightboxPrev) lightboxPrev.addEventListener('click', () => showLightbox(lightboxIndex - 1));
    if (lightboxNext) lightboxNext.addEventListener('click', () => showLightbox(lightboxIndex + 1));

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (!lightbox || !lightbox.open) return;
      if (e.key === 'ArrowLeft') showLightbox(lightboxIndex - 1);
      if (e.key === 'ArrowRight') showLightbox(lightboxIndex + 1);
    });
  </script>
</BaseLayout>

<style>
  .work-lightbox {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: none;
    max-height: none;
    width: auto;
    height: auto;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .work-lightbox:not([open]) { display: none; }
  .work-lightbox::backdrop { background: rgba(0, 0, 0, 0.88); }
  .work-lightbox__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: calc(100vw - 171px);
    max-height: 92vh;
    line-height: 0;
  }
  .work-lightbox__stage img {
    display: block;
    max-width: calc(100vw - 171px);
    max-height: 92vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }
  .work-lightbox__close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .work-lightbox__close:hover { background: rgba(255, 255, 255, 0.25); }
  .work-lightbox__close svg { width: 20px; height: 20px; }
  .work-lightbox__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .work-lightbox__nav:hover { background: rgba(255, 255, 255, 0.25); }
  .work-lightbox__nav--prev { left: 1.5rem; }
  .work-lightbox__nav--next { right: 1.5rem; }
  .work-lightbox__nav svg { width: 22px; height: 22px; }
  .work-lightbox__nav[hidden] { display: none; }
  .work-lightbox--max .work-lightbox__stage,
  .work-lightbox--max .work-lightbox__stage img {
    max-width: 100vw;
    max-height: 100dvh;
  }
  @media (max-width: 740px) {
    .work-lightbox__close { top: 1rem; right: 1rem; }
    .work-lightbox__nav--prev { left: 0.75rem; }
    .work-lightbox__nav--next { right: 0.75rem; }
    .work-lightbox__stage,
    .work-lightbox__stage img { max-width: calc(100vw - 143px); }
  }
</style>
