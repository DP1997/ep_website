---
import BaseLayout from './BaseLayout.astro';
import WorkFigure from '../components/WorkFigure.astro';
import WorkCopy from '../components/WorkCopy.astro';
import WorkNav from '../components/WorkNav.astro';
import WorkVariant from '../components/WorkVariant.astro';
import { aspect as arOf, groupRows, heroSidePlan, villaDimFractions } from '../lib/work-rows';
import '../styles/components/work-contract.css';

interface Props {
  frontmatter: {
    title: string;
    location?: string;
    description?: string;
    date: string;
    client?: string;
    image_layout: string;
    image_dir: string;
    lightbox_max?: boolean;
    dim?: boolean;
    variant_of?: string;
  };
  category?: string;
  slug?: string;
}

const { frontmatter, category, slug } = Astro.props;
const dim = frontmatter.dim === true;

// Abgenommene Layouts: diese Seiten bleiben unverändert. Alle anderen
// Seiten bekommen die neue Variante (Textzeile im Raster der Bildzeile).
// Aus der OK-Liste sind die Seiten herausgenommen, die laut Künstlerin noch
// kaputt waren: Villa Fluss (beide), Arche (beide), Regenwald-Dim,
// Paragraph-Dim, Säulen-Dim, Marathon-Dim, Aufbruch-Dim, Glut-Dim.
const KEEP_LAYOUT = new Set([
  'schichtungen', 'maria', 'nimm', 'quell', 'glied', 'ernte', 'atem', 'lot',
  'säulen', 'bademaxx', 'bildungsspirale', 'platine', 'regenwald',
  'paragraph',
  'dornenkrone-dim', 'schwelle-dim', 'ecce_homo-dim', 'himmelspforten-dim',
  'himmelsband-dim', 'weite-dim', 'christophorus-dim',
  'scribere-dim', 'impuls-dim', 'gleiten-dim'
]);
const keep = KEEP_LAYOUT.has(`${slug ?? ''}${dim ? '-dim' : ''}`);

// Alle Bilder des Worktrees (für Massangaben und Lightbox).
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,JPG}',
  { eager: true }
);

function getImage(dir: string, num: number): ImageMetadata | null {
  const find = (suffix: string) => {
    const key = Object.keys(allImages).find((k) =>
      new RegExp(`/${dir}/${num}-${suffix}\\.jpe?g$`, 'i').test(k)
    );
    return key ? allImages[key].default : null;
  };
  return (
    find('16x') ??
    find('4x') ??
    (() => {
      const key = Object.keys(allImages).find((k) =>
        new RegExp(`/${dir}/${num}\\.jpe?g$`, 'i').test(k)
      );
      return key ? allImages[key].default : null;
    })()
  );
}

const dir = frontmatter.image_dir;

// Alle Bilder des Werksordners sammeln: pro Nummer genau eine Datei,
// bevorzugt die hochskalierte Variante (-16x, dann -4x, sonst Original).
// So werden geupscalte und Originaldateien nie doppelt gezeigt.
const prefix = `/src/assets/${dir}/`;
const fileRe = /^(\d+)(?:-(16x|4x))?\.(jpe?g)$/i;
const byIndex = new Map<number, { img: ImageMetadata; priority: number }>();
for (const [key, mod] of Object.entries(allImages)) {
  if (!key.startsWith(prefix)) continue;
  const file = key.slice(prefix.length);
  if (file.includes('/')) continue;
  const m = file.match(fileRe);
  if (!m) continue;
  const index = parseInt(m[1], 10);
  const priority = m[2] === '16x' ? 3 : m[2] === '4x' ? 2 : 1;
  const existing = byIndex.get(index);
  if (!existing || priority > existing.priority) {
    byIndex.set(index, { img: mod.default, priority });
  }
}

const ordered = [...byIndex.entries()]
  .sort((a, b) => a[0] - b[0])
  .map(([index, v]) => ({ index, img: v.img }));
const heroEntry = ordered.find((e) => e.index === 1) ?? ordered[0] ?? null;
const heroImg = heroEntry?.img ?? null;
const gallery = ordered
  .filter((e) => e !== heroEntry)
  .map(({ index, img }) => ({ img, index }));

const C = gallery.length;
const galleryAR = gallery.map((g) => arOf(g.img));
const colsTemplate = galleryAR.map((a) => `${a}fr`).join(' ');
const heroSpan = Math.max(1, Math.ceil(C / 2));
const copySpan = Math.max(0, C - heroSpan);

const heroAR = heroImg ? arOf(heroImg) : 1;

// Die sechs Contract-Test-Werke behalten ihr Basis-Layout aus dem Preview
// (Aufbruch: Band + Hero/Hochbild/Copy; Bademaxx: 5 gleiche Spalten;
// Säulen: 3-Spalten-Strip mit deklariertem Hero-Crop).
const isAufbruch = slug === 'aufbruch' || frontmatter.variant_of === 'aufbruch';
const isBademaxx = slug === 'bademaxx' || frontmatter.variant_of === 'bademaxx';
const isSaeulen = slug === 'säulen' || frontmatter.variant_of === 'säulen';
const tallImg = isAufbruch ? (gallery[3]?.img ?? getImage(dir, 5)) : null;

// Dim: 2-Spalten-Stack. Hauptspalte = Hero (spannt alle Detailzeilen),
// Detailspalte = alle Bilder untereinander; Copy als eigene Zeile.
// Spaltenbreiten werden so gelöst, dass Hero-Höhe = Summe der Detail-Höhen.
const stackSumInv = gallery.reduce((s, g) => s + 1 / arOf(g.img), 0);
const gapFrac = 0.015;
// Spalten-Gap wird von der Blattbreite abgezogen, bevor die fr-Spalten
// verteilt werden: g/(W-g). Die Zeilen-Gaps sind (C-1)*g.
const colGapFrac = gapFrac / (1 - gapFrac);
// Exakt: Hero-Höhe = Summe der Detailhöhen + (C-1) Gaps.
// s = (1/heroAR - g/(W-g)*(C-1)) / (Σ1/ar_i + 1/heroAR)
const stackExact = C >= 1
  ? (1 / heroAR - colGapFrac * (C - 1)) / (stackSumInv + 1 / heroAR)
  : 0;
const stackSFrac = C >= 1 ? Math.max(0.12, Math.min(0.6, stackExact)) : 0;
const stackMFrac = 1 - stackSFrac;
// Sehr breiter Hero oder sehr breites Detail: Band-Ordnung statt Stack,
// damit der Hero das größte Bild bleibt und nichts beschnitten wird.
const dimBand =
  heroAR >= 2.5 ||
  (C === 1 && stackExact > 0.6) ||
  stackExact < 0.12;
const stackTemplate = `grid-template-columns: ${stackMFrac}fr ${stackSFrac}fr; grid-template-rows: repeat(${C}, auto) auto;`;

// ---------------------------------------------------------------------------
// Bild-Constraint (auf einen Blick): Jedes Bild muss bei 100 % Zoom
// vollstaendig in den Viewport passen. Die Blattbreite W wird so gewaehlt,
// dass W <= viewportHoehe * fitAR gilt.
//
// Ein Bild mit Spaltenanteil k und m abgezogenen Spalten-Gaps hat die Breite
// W*(k - gapFrac*m); seine Hoehe ist Breite/Aspekt. Fuer jede Bildrolle wird
// der Faktor aspekt/(k - gapFrac*m) gebildet - das Minimum ist fitAR. Die
// Rollen (k, m) folgen exakt dem jeweiligen Layout (WorkVariant, Keep-Stack,
// Band, Bademaxx, Top-Zeile, Zwei-/Ein-Bild-Raster).
// ---------------------------------------------------------------------------
const fitLimits: number[] = [];
const fitAdd = (ar: number, k: number, m: number) => {
  const eff = k - gapFrac * m;
  if (Number.isFinite(ar) && ar > 0 && eff > 0.0001) fitLimits.push(ar / eff);
};

const sidePlan = frontmatter.hero_side === true && heroImg
  ? heroSidePlan(heroAR, gallery, 0.4, gapFrac)
  : null;
const sideUsable = sidePlan !== null && sidePlan.factor > 0.02;
const dimLayoutMode = dim ? frontmatter.dim_layout : undefined;

if (!keep && dimLayoutMode === 'band') {
  // Hero + alle Details in EINER Zeile (aspektproportional), Copy darunter.
  fitAdd(
    heroAR + galleryAR.reduce((a, b) => a + b, 0),
    1,
    gallery.length
  );
} else if (!keep && dimLayoutMode === 'kompakt') {
  // Hero-Spalte ist per CSS auf min(60 %, Viewporthoehe x Aspekt) begrenzt;
  // nur die Detailzeilen bestimmen die Blattbreite.
  const sortedFit = [...gallery].sort((a, b) => arOf(b.img) - arOf(a.img));
  const orderedFit = frontmatter.gallery_swap ? [...sortedFit].reverse() : sortedFit;
  for (const row of groupRows(orderedFit, 3).rows) {
    fitAdd(row.reduce((s, g) => s + arOf(g.img), 0), 1, row.length - 1);
  }
} else if (!keep && dimLayoutMode === 'stack') {
  if (heroImg) fitAdd(heroAR, stackMFrac, stackMFrac);
  for (const ar of galleryAR) fitAdd(ar, stackSFrac, stackSFrac);
} else if (!keep && dimLayoutMode === 'reihen') {
  if (heroImg) fitAdd(heroAR, 1, 0);
  for (const ar of galleryAR) fitAdd(ar, 1, 0);
} else if (!keep && frontmatter.impuls === true && heroImg && gallery.length) {
  const portraitAR = arOf(gallery[0].img);
  // Basis: Hero + Detail als eine Zeile (Aspekt-Anteile), darunter die
  // Copy-Zeile. Dim: Hochformat links per min(50 %, H x Aspekt), Querformat
  // rechts; Blattbreite entsprechend.
  fitLimits.push(
    dim
      ? heroAR + portraitAR
      : (heroAR + portraitAR) / (1 - gapFrac)
  );
} else if (!keep && frontmatter.villa === true && heroImg) {
  // Basis: zwei gleiche Spalten; Hero-Breite = (W - Gap)/2, daraus folgt
  // W <= H * 2 * HeroAspekt / (1 - Gap). Dim: drei Zeilen (Hero links, zwei
  // gleich breite Spalten rechts), Spaltenanteile exakt geloest.
  const dimFrac = villaDimFractions(
    heroAR,
    gallery.reduce((s, g) => s + 1 / arOf(g.img), 0),
    gapFrac
  );
  fitLimits.push(dim ? heroAR / dimFrac.heroFrac : (2 * heroAR) / (1 - gapFrac));
} else if (!keep && sideUsable) {
  // Width first: Hero + Copy + Hochformate in einer Zeile; ihre gemeinsame
  // Hoehe ist W * factor. Querformate darunter als eigene Zeilen.
  const landRows = groupRows(
    [...sidePlan!.landscapes].sort((a, b) => arOf(b.img) - arOf(a.img)),
    3
  ).rows;
  const topCols = 2 + sidePlan!.portraits.length;
  const bottomRow =
    frontmatter.hero_side_align === 'bottom' &&
    landRows[0] &&
    landRows[0].length === topCols
      ? landRows[0]
      : null;
  if (bottomRow) {
    // Untere Detailzeile definiert die Spalten: jedes Top-Bild sitzt in
    // seiner Spalte (Anteil = Aspekt/Summe) und darf den Viewport nicht
    // ueberschreiten.
    const sum = bottomRow.reduce((s, g) => s + arOf(g.img), 0);
    if (heroImg) fitAdd(heroAR, arOf(bottomRow[0].img) / sum, 0);
    sidePlan!.portraits.forEach((g, i) =>
      fitAdd(arOf(g.img), arOf(bottomRow[i + 2].img) / sum, 0)
    );
  } else {
    fitLimits.push(1 / sidePlan!.factor);
  }
  for (const row of landRows) {
    fitAdd(row.reduce((s, g) => s + arOf(g.img), 0), 1, row.length - 1);
  }
} else if (!keep) {
  // WorkVariant: Hero volle Breite, Detailbilder in aspect-proportionalen
  // Zeilen, copy_image als deklarierte Hoehe in der Textzeile.
  const perRow = dim ? 3 : 2;
  const sortedFit = [...gallery].sort((a, b) => arOf(b.img) - arOf(a.img));
  const orderedFit = frontmatter.gallery_swap ? [...sortedFit].reverse() : sortedFit;
  const copyNum = frontmatter.copy_image ?? null;
  const copyH = frontmatter.copy_image_h ?? null;
  const hasCopy =
    copyNum !== null && copyH !== null && orderedFit.some((g) => g.index === copyNum);

  if (heroImg) fitAdd(heroAR, 1, 0);

  if (hasCopy && copyH) {
    fitLimits.push(1 / copyH);
    const stripArs = orderedFit.filter((g) => g.index !== copyNum).map((g) => arOf(g.img));
    fitAdd(stripArs.reduce((a, b) => a + b, 0), 1, stripArs.length - 1);
  } else {
    const { rows: fitRows, asideImg } = groupRows(orderedFit, perRow);
    for (const row of fitRows) {
      fitAdd(row.reduce((s, g) => s + arOf(g.img), 0), 1, row.length - 1);
    }
    // Restbild sitzt in der Textzeile: Hoehe = (W - Gaps)/(Summe + Aspekt).
    if (asideImg && fitRows[0]) {
      const firstSum = fitRows[0].reduce((s, g) => s + arOf(g.img), 0);
      fitAdd(firstSum + arOf(asideImg.img), 1, fitRows[0].length);
    }
  }
} else if (dim) {
  if (heroImg) {
    if (dimBand) fitAdd(heroAR, 1, 0);
    else fitAdd(heroAR, stackMFrac, stackMFrac);
  }
  if (dimBand) {
    fitAdd(galleryAR.reduce((a, b) => a + b, 0), 1, gallery.length - 1);
  } else {
    for (const ar of galleryAR) fitAdd(ar, stackSFrac, stackSFrac);
  }
} else if (isBademaxx) {
  if (heroImg) fitAdd(heroAR, 0.6, 0.4);
  for (const ar of galleryAR) fitAdd(ar, 0.2, 0.8);
} else if (C >= 3) {
  const sum = galleryAR.reduce((a, b) => a + b, 0);
  if (heroImg) {
    const spanSum = galleryAR.slice(0, heroSpan).reduce((a, b) => a + b, 0);
    const k = spanSum / sum;
    fitAdd(heroAR, k, (C - 1) * k - (heroSpan - 1));
  }
  fitAdd(sum, 1, C - 1);
} else if (C === 2) {
  const sum = galleryAR[0] + galleryAR[1] + 1;
  if (heroImg) {
    const k = (galleryAR[0] + galleryAR[1]) / sum;
    fitAdd(heroAR, k, 2 * k - 1);
  }
  fitAdd(sum, 1, 2);
} else if (C === 1) {
  if (heroImg) fitAdd(heroAR, 0.5, 0.5);
  fitAdd(galleryAR[0], 0.5, 0.5);
} else if (heroImg) {
  fitAdd(heroAR, 0.5, 0.5);
}

const fitAR = fitLimits.length ? Math.min(...fitLimits) : 1;

// Lightbox: Hero + alle Bilder in Originalgröße.
const lightboxImages = [
  ...(heroImg ? [{ img: heroImg, alt: frontmatter.title }] : []),
  ...gallery.map((g) => ({
    img: g.img,
    alt: `${frontmatter.title} — Bild ${g.index}`
  }))
];
const lightboxData = lightboxImages.map((item) => ({
  src: item.img.src,
  alt: item.alt
}));

const heroSizes = '(min-width: 741px) 82vw, 92vw';
const stripSizes = '(min-width: 741px) 33vw, 46vw';
---

<BaseLayout>
  <div
    class="wc"
    data-layout={dim ? 'dim' : 'base'}
    data-work={frontmatter.variant_of ?? ''}
    data-copy-align={frontmatter.copy_align ?? 'top'}
    data-hero-fit={heroImg ? '' : undefined}
    style={[
      heroImg ? `--fit-ar: ${fitAR.toFixed(4)}; --hero-ar: ${heroAR.toFixed(4)};` : ''
    ].filter(Boolean).join(' ') || undefined}
  >
    {!keep ? (
      <WorkVariant
        frontmatter={frontmatter}
        heroImg={heroImg}
        gallery={gallery}
        dim={dim}
      >
        <slot />
      </WorkVariant>
    ) : dim ? (
      dimBand ? (
        <>
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              eager
              sizes={heroSizes}
              widths={[800, 1200, 1600, 2000]}
            />
          )}
          <div class="wc-strip" style={`grid-template-columns: ${colsTemplate};`}>
            {gallery.map((g, i) => (
              <WorkFigure
                img={g.img}
                alt={`${frontmatter.title} — Bild ${g.index}`}
                index={i + 1}
                sizes={stripSizes}
              />
            ))}
          </div>
          <WorkCopy frontmatter={frontmatter} dim={dim} variant="wide">
            <slot />
          </WorkCopy>
        </>
      ) : C >= 1 ? (
        <div class="wc-stack" style={`${stackTemplate}`}>
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              style={`grid-column: 1; grid-row: 1 / span ${C};`}
              eager
              sizes="(min-width: 741px) 55vw, 92vw"
              widths={[800, 1200, 1600]}
            />
          )}
          {gallery.map((g, i) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={i + 1}
              style={`grid-column: 2; grid-row: ${i + 1};`}
              sizes="(min-width: 741px) 25vw, 46vw"
            />
          ))}
          <WorkCopy
            frontmatter={frontmatter}
            dim={dim}
            variant="wide"
            style={`grid-column: 1 / span 2; grid-row: ${C + 1};`}
          >
            <slot />
          </WorkCopy>
        </div>
      ) : (
        <div class="wc-dim">
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              eager
              sizes={heroSizes}
              widths={[800, 1200, 1600, 2000]}
            />
          )}
          <div class="wc-row wc-row--copy">
            <WorkCopy frontmatter={frontmatter} dim={dim} variant="wide">
              <slot />
            </WorkCopy>
          </div>
        </div>
      )
    ) : isAufbruch && tallImg ? (
      <div class="wc-aufbruch">
        <div class="wc-band" style="grid-template-columns: 34.92fr 34.86fr 30.22fr;">
          {[2, 1, 0].map((pos) => {
            const g = gallery[pos];
            return (
              <WorkFigure
                img={g.img}
                alt={`${frontmatter.title} — Bild ${g.index}`}
                index={pos + 1}
                sizes={stripSizes}
              />
            );
          })}
        </div>
        <div class="wc-bottom" style="grid-template-columns: 34.92fr 34.86fr 30.22fr;">
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              style="grid-column: 1;"
              eager
              sizes={heroSizes}
              widths={[800, 1200, 1600]}
            />
          )}
          <WorkFigure
            img={tallImg}
            alt={`${frontmatter.title} — Bild 5`}
            index={4}
            crop
            style="grid-column: 2; aspect-ratio: 0.662;"
            sizes={stripSizes}
          />
          <WorkCopy frontmatter={frontmatter} dim={dim} style="grid-column: 3;">
            <slot />
          </WorkCopy>
        </div>
      </div>
    ) : isBademaxx ? (
      <>
        <div class="wc-top" style="grid-template-columns: repeat(5, minmax(0, 1fr));">
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass="wc-hero"
              style="grid-column: span 3;"
              eager
              sizes={heroSizes}
              widths={[800, 1200, 1600]}
            />
          )}
          <WorkCopy frontmatter={frontmatter} dim={dim} style="grid-column: span 2;">
            <slot />
          </WorkCopy>
        </div>
        <div class="wc-strip" style="grid-template-columns: repeat(5, minmax(0, 1fr));">
          {gallery.map((g, i) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={i + 1}
              crop={i === gallery.length - 1}
              sizes={stripSizes}
            />
          ))}
        </div>
      </>
    ) : C >= 3 ? (
      <>
        <div class="wc-top" style={`grid-template-columns: ${colsTemplate};`}>
          {heroImg && (
            <WorkFigure
              img={heroImg}
              alt={frontmatter.title}
              index={0}
              figureClass={`wc-hero${isSaeulen ? ' wc-hero--saeulen' : ''}`}
              crop={isSaeulen}
              style={`grid-column: 1 / span ${heroSpan};`}
              eager
              sizes={heroSizes}
              widths={[800, 1200, 1600]}
            />
          )}
          <WorkCopy
            frontmatter={frontmatter}
            dim={dim}
            style={heroImg ? `grid-column: ${heroSpan + 1} / span ${copySpan};` : undefined}
          >
            <slot />
          </WorkCopy>
        </div>
        <div class="wc-strip" style={`grid-template-columns: ${colsTemplate};`}>
          {gallery.map((g, i) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={i + 1}
              sizes={stripSizes}
            />
          ))}
        </div>
      </>
    ) : C === 2 ? (
      <div
        class="wc-grid2"
        style={`grid-template-columns: ${galleryAR[0]}fr ${galleryAR[1]}fr 1fr;`}
      >
        {heroImg && (
          <WorkFigure
            img={heroImg}
            alt={frontmatter.title}
            index={0}
            figureClass="wc-hero"
            style="grid-column: 1 / span 2; grid-row: 1;"
            eager
            sizes={heroSizes}
            widths={[800, 1200, 1600]}
          />
        )}
        <WorkCopy
          frontmatter={frontmatter}
          dim={dim}
          style="grid-column: 3; grid-row: 1 / span 2;"
        >
          <slot />
        </WorkCopy>
        <WorkFigure
          img={gallery[0].img}
          alt={`${frontmatter.title} — Bild ${gallery[0].index}`}
          index={1}
          style="grid-column: 1; grid-row: 2;"
          sizes={stripSizes}
        />
        <WorkFigure
          img={gallery[1].img}
          alt={`${frontmatter.title} — Bild ${gallery[1].index}`}
          index={2}
          style="grid-column: 2; grid-row: 2;"
          sizes={stripSizes}
        />
      </div>
    ) : C === 1 ? (
      <div class="wc-top" style="grid-template-columns: 1fr 1fr;">
        {heroImg && (
          <WorkFigure
            img={heroImg}
            alt={frontmatter.title}
            index={0}
            figureClass="wc-hero"
            eager
            sizes={heroSizes}
            widths={[800, 1200, 1600]}
          />
        )}
        <div class="wc-copycol">
          <WorkCopy frontmatter={frontmatter} dim={dim}>
            <slot />
          </WorkCopy>
          <WorkFigure
            img={gallery[0].img}
            alt={`${frontmatter.title} — Bild ${gallery[0].index}`}
            index={1}
            sizes={stripSizes}
          />
        </div>
      </div>
    ) : (
      <div class="wc-top" style="grid-template-columns: 1fr 1fr;">
        {heroImg && (
          <WorkFigure
            img={heroImg}
            alt={frontmatter.title}
            index={0}
            figureClass="wc-hero"
            eager
            sizes={heroSizes}
            widths={[800, 1200, 1600]}
          />
        )}
        <WorkCopy frontmatter={frontmatter} dim={dim}>
          <slot />
        </WorkCopy>
      </div>
    )}
  </div>

  {category && slug && <WorkNav category={category} slug={slug} />}

  <!-- Lightbox: Gesamtansicht des angeklickten Bildes (voll, unbeschnitten). -->
  <dialog class:list={[{ 'work-lightbox': true, 'work-lightbox--max': frontmatter.lightbox_max !== false }]} id="work-lightbox" aria-label="Bild in voller Größe">
    <div class="work-lightbox__stage">
      <img id="work-lightbox-img" alt="" />
    </div>
    <button type="button" class="work-lightbox__close" id="work-lightbox-close" aria-label="Schließen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <button type="button" class="work-lightbox__nav work-lightbox__nav--prev" id="work-lightbox-prev" aria-label="Vorheriges Bild">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="work-lightbox__nav work-lightbox__nav--next" id="work-lightbox-next" aria-label="Nächstes Bild">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </dialog>

  <script define:vars={{ lightboxData }}>
    const lightboxImages = lightboxData;
    const lightbox = document.getElementById('work-lightbox');
    const lightboxImg = document.getElementById('work-lightbox-img');
    const lightboxClose = document.getElementById('work-lightbox-close');
    const lightboxPrev = document.getElementById('work-lightbox-prev');
    const lightboxNext = document.getElementById('work-lightbox-next');
    let lightboxIndex = 0;

    function showLightbox(index) {
      if (!lightbox || !lightboxImages.length) return;
      if (!lightbox.open) lightbox.showModal();
      lightboxIndex = (index + lightboxImages.length) % lightboxImages.length;
      const item = lightboxImages[lightboxIndex];
      lightboxImg.src = item.src;
      lightboxImg.alt = item.alt;
      lightboxPrev.hidden = lightboxImages.length < 2;
      lightboxNext.hidden = lightboxImages.length < 2;
    }

    function closeLightbox() {
      if (lightbox && lightbox.open) lightbox.close();
    }

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-lightbox]');
      if (btn) showLightbox(parseInt(btn.dataset.lightbox, 10));
    });

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightboxPrev) lightboxPrev.addEventListener('click', () => showLightbox(lightboxIndex - 1));
    if (lightboxNext) lightboxNext.addEventListener('click', () => showLightbox(lightboxIndex + 1));

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (!lightbox || !lightbox.open) return;
      if (e.key === 'ArrowLeft') showLightbox(lightboxIndex - 1);
      if (e.key === 'ArrowRight') showLightbox(lightboxIndex + 1);
    });
  </script>
</BaseLayout>

