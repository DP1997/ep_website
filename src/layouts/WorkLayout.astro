---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';

type ImageLayout = "1-2" | "1-3" | "1-4" | "1-5";

interface Props {
  frontmatter: {
    title: string;
    location: string;
    description: string;
    date: string;
    client: string;
    image_layout: ImageLayout;
    image_dir: string;
    gallery_reverse?: boolean;
    gallery_max_height?: number;
    gallery_main_position?: 'top' | 'center' | 'bottom';
    tags: { kategorie: string[]; kontext: string[]; gebaeudetyp: string[]; material: string[] };
  };
}

const { frontmatter } = Astro.props;

// Import all images from src/assets eagerly to access dimensions
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,JPG}',
  { eager: true }
);

// Helper to find an image by its directory and number.
// Case-insensitive Endung (z. B. "6.JPG"), damit Großschreibung kein Bild
// stummschaltet.
function getImage(dir: string, num: number) {
  const key = Object.keys(allImages).find(k =>
    new RegExp(`/${dir}/${num}\\.jpe?g$`, 'i').test(k)
  );
  return key ? allImages[key].default : null;
}

const dir = frontmatter.image_dir;
const galleryCount = parseInt(frontmatter.image_layout.split("-")[1]);

// Gallery-Spalten tauschen (klein links, gross rechts): Das 1-3-Layout waehlt
// das hoechste Bild automatisch als Hauptbild links. `gallery_reverse` kehrt
// die Spalten um, damit das grosse Bild rechts steht — ohne Datei-Umbenennen
// oder Veraendern der fachlichen Bildreihenfolge.
const reverse = frontmatter.gallery_reverse === true;
// Obere Hoehenbegrenzung der Galerie (z. B. Maria: Bilder verkleinern,
// damit die Seite ohne Scrollen passt). Optional, nur bei Bedarf gesetzt.
const galleryMaxHeight = frontmatter.gallery_max_height;
// Ausrichtung des grossen Hauptbilds (z. B. Villa Fuss: oberen Foto-Ausschnitt
// zeigen). Optional, Standard ist zentriert.
const galleryMainPosition = frontmatter.gallery_main_position;

// Get hero image
const heroImg = getImage(dir, 1);

// Get gallery images
const galleryImages = Array.from(
  { length: galleryCount },
  (_, i) => ({ img: getImage(dir, i + 2), index: i + 2 })
).filter(g => g.img !== null);

// For 2-image layout: calculate flex proportions based on aspect ratios
// so both images have equal height
let gallery2Flex: number[] = [];
if (frontmatter.image_layout === "1-2" && galleryImages.length === 2) {
  const [a, b] = galleryImages;
  const arA = a.img!.width / a.img!.height;
  const arB = b.img!.width / b.img!.height;
  gallery2Flex = [arA, arB];
}

// For 3-image layout: tallest image is main, other two are stacked
// Stack images share height proportionally based on inverse aspect ratios
let mainImgIndex = 0;
let stackImgIndices: number[] = [];
let gallery3StackFlex: number[] = [];
let flexMain3 = 1;
let flexStack3 = 1;
if (frontmatter.image_layout === "1-3" && galleryImages.length === 3) {
  let maxH = 0;
  galleryImages.forEach((g, i) => {
    if (g.img!.height > maxH) {
      maxH = g.img!.height;
      mainImgIndex = i;
    }
  });
  stackImgIndices = galleryImages
    .map((_, i) => i)
    .filter(i => i !== mainImgIndex);
  // For 3-image layout column flex: main image height must equal combined stack height
  // Stack items: split height proportionally by inverse aspect ratio
    gallery3StackFlex = stackImgIndices.map(i => {
      const img = galleryImages[i].img!;
      return img.height / img.width;
    });
    // Column widths: main image height = combined stack height
    // h_main = flexMain * containerW / (flexMain+flexStack) / ar_main
    // h_stack = flexStack * containerW / (flexMain+flexStack) * sum(1/ar_i)
    // Setting equal and solving: flexStack/flexMain = 1 / (ar_main * sum(1/ar_i))
    const mainAR = galleryImages[mainImgIndex].img!.width / galleryImages[mainImgIndex].img!.height;
        const stackInvARSum = stackImgIndices.reduce((s, i) => s + galleryImages[i].img!.height / galleryImages[i].img!.width, 0);
        flexMain3 = 1;
        flexStack3 = 1 / (mainAR * stackInvARSum);
}

// Lightbox: alle Bilder (Hero + Galerie) in Originalgröße für die
// Gesamtansicht beim Klick auf ein Bild. Index 0 = Hero, danach die Galerie.
const lightboxOffset = heroImg ? 1 : 0;
const lightboxImages = [
  ...(heroImg ? [{ img: heroImg, alt: frontmatter.title }] : []),
  ...galleryImages.map(g => ({ img: g.img!, alt: `${frontmatter.title} — Bild ${g.index}` })),
];
// Fürs Browser-Script: nur src + alt, als JSON serialisierbar.
const lightboxData = lightboxImages.map(item => ({ src: item.img.src, alt: item.alt }));
---

<BaseLayout>

  <!-- Hero: full-width overview image -->
  <section class="work-hero">
    {heroImg && (
      <button type="button" class="work-hero__btn" data-lightbox="0" aria-label={`${frontmatter.title} in voller Größe anzeigen`}>
        <Image src={heroImg} alt={frontmatter.title} widths={[1600]} sizes="100vw" loading="eager" />
      </button>
    )}
  </section>

  <!-- Meta information -->
  <section class="work-meta">
    <h1 class="work-meta__title">{frontmatter.title}</h1>
    <p class="work-meta__description">{frontmatter.description}</p>
    <div class="work-meta__details">
      <div class="work-meta__detail">
        <span class="work-meta__label">Ort</span>
        <span class="work-meta__value">{frontmatter.location}</span>
      </div>
      <div class="work-meta__detail">
        <span class="work-meta__label">Jahr</span>
        <span class="work-meta__value">{frontmatter.date}</span>
      </div>
      <div class="work-meta__detail">
        <span class="work-meta__label">Auftraggeber</span>
        <span class="work-meta__value">{frontmatter.client}</span>
      </div>
      
    </div>
  </section>

  <!-- Text content from .md -->
  <section class="work-text">
    <slot />
  </section>

  <!-- Image gallery -->
  <section class="work-gallery" style={{ "--gallery-max-h": galleryMaxHeight ? `${galleryMaxHeight}px` : null, "--gallery-main-pos": galleryMainPosition ?? null }}>
    {frontmatter.image_layout === "1-2" && galleryImages.length === 2 && (
      <div class:list={[{ "gallery-row-2": true, "gallery-row-2--rev": reverse }]}>
        {galleryImages.map((g, i) => (
          <div class="gallery-item-2" style={`flex: ${gallery2Flex[i]};`}>
            <button type="button" class="gallery-btn" data-lightbox={lightboxOffset + i} aria-label={`${frontmatter.title} — Bild ${g.index} in voller Größe anzeigen`}>
              <Image src={g.img!} alt={`${frontmatter.title} — Bild ${g.index}`} loading="lazy" />
            </button>
          </div>
        ))}
      </div>
    )}

    {frontmatter.image_layout === "1-3" && galleryImages.length === 3 && (
      <div class:list={[{ "gallery-row-3": true, "gallery-row-3--rev": reverse }]}>
        {!reverse && (
          <>
            <div class="gallery-main" style={`flex: ${flexMain3};`}>
              <button type="button" class="gallery-btn" data-lightbox={lightboxOffset + mainImgIndex} aria-label={`${frontmatter.title} — Bild ${galleryImages[mainImgIndex].index} in voller Größe anzeigen`}>
                <Image src={galleryImages[mainImgIndex].img!} alt={`${frontmatter.title} — Bild ${galleryImages[mainImgIndex].index}`} loading="lazy" />
              </button>
            </div>
            <div class="gallery-stack" style={`flex: ${flexStack3};`}>
              {stackImgIndices.map((si, i) => (
                <div class="gallery-stack-item" style={`flex: ${gallery3StackFlex[i]};`}>
                  <button type="button" class="gallery-btn" data-lightbox={lightboxOffset + si} aria-label={`${frontmatter.title} — Bild ${galleryImages[si].index} in voller Größe anzeigen`}>
                    <Image src={galleryImages[si].img!} alt={`${frontmatter.title} — Bild ${galleryImages[si].index}`} loading="lazy" />
                  </button>
                </div>
              ))}
            </div>
          </>
        )}
        {reverse && (
          <>
            <div class="gallery-stack" style={`flex: ${flexStack3};`}>
              {stackImgIndices.map((si, i) => (
                <div class="gallery-stack-item" style={`flex: ${gallery3StackFlex[i]};`}>
                  <button type="button" class="gallery-btn" data-lightbox={lightboxOffset + si} aria-label={`${frontmatter.title} — Bild ${galleryImages[si].index} in voller Größe anzeigen`}>
                    <Image src={galleryImages[si].img!} alt={`${frontmatter.title} — Bild ${galleryImages[si].index}`} loading="lazy" />
                  </button>
                </div>
              ))}
            </div>
            <div class="gallery-main" style={`flex: ${flexMain3};`}>
              <button type="button" class="gallery-btn" data-lightbox={lightboxOffset + mainImgIndex} aria-label={`${frontmatter.title} — Bild ${galleryImages[mainImgIndex].index} in voller Größe anzeigen`}>
                <Image src={galleryImages[mainImgIndex].img!} alt={`${frontmatter.title} — Bild ${galleryImages[mainImgIndex].index}`} loading="lazy" />
              </button>
            </div>
          </>
        )}
      </div>
    )}

    {frontmatter.image_layout === "1-4" && galleryImages.length === 4 && (
      <div class="gallery-grid-4">
        {galleryImages.map((g, i) => (
          <div class="gallery-item-4">
            <button type="button" class="gallery-btn" data-lightbox={lightboxOffset + i} aria-label={`${frontmatter.title} — Bild ${g.index} in voller Größe anzeigen`}>
              <Image src={g.img!} alt={`${frontmatter.title} — Bild ${g.index}`} loading="lazy" />
            </button>
          </div>
        ))}
      </div>
    )}

    {frontmatter.image_layout === "1-5" && galleryImages.length === 5 && (
      <div class="gallery-grid-5">
        {galleryImages.map((g, i) => (
          <div class="gallery-item-5">
            <button type="button" class="gallery-btn" data-lightbox={lightboxOffset + i} aria-label={`${frontmatter.title} — Bild ${g.index} in voller Größe anzeigen`}>
              <Image src={g.img!} alt={`${frontmatter.title} — Bild ${g.index}`} loading="lazy" />
            </button>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- Lightbox: Gesamtansicht des angeklickten Bildes (voll, unbeschnitten).
       Native <dialog> für Fokus-Trap + Escape-Schließen, Bild per JS befüllt. -->
  <dialog class="work-lightbox" id="work-lightbox" aria-label="Bild in voller Größe">
    <div class="work-lightbox__stage">
      <img id="work-lightbox-img" alt="" />
    </div>
    <button type="button" class="work-lightbox__close" id="work-lightbox-close" aria-label="Schließen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <button type="button" class="work-lightbox__nav work-lightbox__nav--prev" id="work-lightbox-prev" aria-label="Vorheriges Bild">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="work-lightbox__nav work-lightbox__nav--next" id="work-lightbox-next" aria-label="Nächstes Bild">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </dialog>

  <script define:vars={{ lightboxData }}>
    // Lightbox: Klick auf ein Bild (Hero oder Galerie) öffnet die Gesamtansicht.
    // Bilder werden als Astro-optimierte URLs eingebettet; Navigation + Schließen
    // per Klick, Escape (natives <dialog>) und Pfeiltasten.
    const lightboxImages = lightboxData;
    const lightbox = document.getElementById('work-lightbox');
    const lightboxImg = document.getElementById('work-lightbox-img');
    const lightboxClose = document.getElementById('work-lightbox-close');
    const lightboxPrev = document.getElementById('work-lightbox-prev');
    const lightboxNext = document.getElementById('work-lightbox-next');
    let lightboxIndex = 0;

    function showLightbox(index) {
      if (!lightbox || !lightboxImages.length) return;
      if (!lightbox.open) lightbox.showModal();
      lightboxIndex = (index + lightboxImages.length) % lightboxImages.length;
      const item = lightboxImages[lightboxIndex];
      lightboxImg.src = item.src;
      lightboxImg.alt = item.alt;
      lightboxPrev.hidden = lightboxImages.length < 2;
      lightboxNext.hidden = lightboxImages.length < 2;
    }

    function closeLightbox() {
      if (lightbox && lightbox.open) lightbox.close();
    }

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      const btn = e.target.closest('[data-lightbox]');
      if (btn) showLightbox(parseInt(btn.dataset.lightbox, 10));
    });

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightboxPrev) lightboxPrev.addEventListener('click', () => showLightbox(lightboxIndex - 1));
    if (lightboxNext) lightboxNext.addEventListener('click', () => showLightbox(lightboxIndex + 1));

    // Klick auf den Backdrop (außerhalb des Bildes) schließt die Lightbox.
    if (lightbox) lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Pfeiltasten: links/rechts navigieren, Escape schließt (nativ).
    document.addEventListener('keydown', (e) => {
      if (!lightbox || !lightbox.open) return;
      if (e.key === 'ArrowLeft') showLightbox(lightboxIndex - 1);
      if (e.key === 'ArrowRight') showLightbox(lightboxIndex + 1);
    });
  </script>

</BaseLayout>

<style>
  /* Hero */
  /* Hero: startet bündig unterhalb des einheitlichen #site-main-Paddings. */
  .work-hero {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    max-height: 60vh;
    overflow: hidden;
  }

  .work-hero img {
    width: 100%;
    height: 60vh;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Klickbare Bildflächen: Button ohne Default-Styling, Bild füllt die Fläche. */
  .work-hero__btn,
  .gallery-btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    line-height: 0;
  }

  .work-hero__btn {
    height: 60vh;
  }

  .work-hero__btn img,
  .gallery-btn img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .work-hero__btn img {
    object-fit: cover;
    object-position: center;
  }

  /* Meta */
  .work-meta {
    max-width: var(--large);
    margin: 0 auto;
    padding: var(--margin) 0 calc(var(--margin) * 2) 0;
  }

  .work-meta__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    line-height: 1.2;
    margin: 0 0 1.5rem;
  }

  .work-meta__description {
    font-family: var(--font-sans-serif);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.5;
    margin: 0 0 1.5rem;
    color: var(--color-base);
  }

  .work-meta__details {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .work-meta__detail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .work-meta__label {
    font-family: var(--font-sans-serif);
    font-size: 1.05rem;
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    font-weight: 400;
  }

  .work-meta__value {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-base);
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  

  /* Text */
  .work-text {
    max-width: var(--large);
    margin-left: auto;
    margin-right: auto;
    padding: 0 0 var(--margin);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.7;
    color: var(--color-base);
  }

  /* Override .post-content that Astro wraps around markdown slot content */
  .work-text :global(.post-content) {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  /* Gallery base */
  .work-gallery {
    max-width: var(--large);
    margin-left: auto;
    margin-right: auto;
  }

  .work-gallery img {
      display: block;
      width: 100%;
      height: auto;
    }

  /* Optionale obere Hoehenbegrenzung (z. B. Maria): haelt die Galerie
     kompakt, damit die Seite ohne Scrollen passt. Die Bilder werden
     proportional verkleinert (contain statt cover), die Spalten bleiben
     gleich hoch. Nur Desktop — auf Mobile ist die Spalte gestapelt und
     Scrollen ist normal. */
  @media (min-width: 741px) {
    .work-gallery[style*="--gallery-max-h"] .gallery-row-3 {
      height: var(--gallery-max-h);
      overflow: hidden;
    }

    .work-gallery[style*="--gallery-max-h"] .gallery-row-3 .gallery-main img,
    .work-gallery[style*="--gallery-max-h"] .gallery-row-3 .gallery-stack-item img {
      width: auto;
      max-width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

    .gallery-stack-item img {
      height: 100%;
    }

  /* 2 images: same height, widths proportional to aspect ratio */
  .gallery-row-2 {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  /* 1-2-Reverse: kleines (Details) Bild links, breites Gesamtbild rechts */
  .gallery-row-2--rev {
    flex-direction: row-reverse;
  }

  .gallery-item-2 {
    display: flex;
  }

  .gallery-item-2 img {
    width: 100%;
    height: auto;
  }

  /* 3 images: main on left, 2 stacked on right matching total height */
    .gallery-row-3 {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .gallery-main {
    /* flex set inline via style */
    display: flex;
    justify-content: center;
  }

  .gallery-main img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--gallery-main-pos, center);
    }

    .gallery-stack {
      /* flex set inline via style */
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      overflow: hidden;
    }

  .gallery-stack-item {
    display: flex;
    overflow: hidden;
  }

  .gallery-stack-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

    /* 4 images: 2x2 grid, equal height */
  .gallery-grid-4 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr;
    gap: 0.5rem;
  }

  .gallery-item-4 {
    overflow: hidden;
  }

  .gallery-item-4 img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 5 images: 3-2-Kombination (erste Reihe 3, zweite Reihe 2, zentriert) */
  .gallery-grid-5 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 1fr;
    gap: 0.5rem;
  }

  .gallery-item-5 {
    overflow: hidden;
  }

  .gallery-item-5:nth-child(4) {
    grid-column: 1;
  }

  .gallery-item-5:nth-child(5) {
    grid-column: 2;
  }

  .gallery-item-5 img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 740px) {
    .gallery-row-2,
    .gallery-row-3 {
      flex-direction: column;
    }

    .gallery-main img,
    .gallery-stack img {
      height: auto;
    }

    .work-meta__details {
      flex-direction: column;
      gap: 1rem;
    }
  }

  /* Lightbox: dunkler Backdrop, Bild voll und unbeschnitten zentriert.
     Native <dialog> liefert Fokus-Trap + Escape-Schließen. */
  .work-lightbox {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: none;
    max-height: none;
    width: auto;
    height: auto;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .work-lightbox:not([open]) {
    display: none;
  }

  .work-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.88);
  }

  .work-lightbox__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 96vw;
    max-height: 92vh;
    line-height: 0;
  }

  .work-lightbox__stage img {
    display: block;
    max-width: 96vw;
    max-height: 92vh;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }

  .work-lightbox__close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .work-lightbox__close:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .work-lightbox__close svg {
    width: 20px;
    height: 20px;
  }

  .work-lightbox__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .work-lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .work-lightbox__nav--prev {
    left: 1.5rem;
  }

  .work-lightbox__nav--next {
    right: 1.5rem;
  }

  .work-lightbox__nav svg {
    width: 22px;
    height: 22px;
  }

  .work-lightbox__nav[hidden] {
    display: none;
  }

  @media (max-width: 740px) {
    .work-lightbox__close {
      top: 1rem;
      right: 1rem;
    }

    .work-lightbox__nav--prev {
      left: 0.75rem;
    }

    .work-lightbox__nav--next {
      right: 0.75rem;
    }
  }
</style>