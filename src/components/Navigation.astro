---
const BASE_URL = import.meta.env.BASE_URL;

// Aktiver Navigationszustand: erste Pfadstufe nach dem Basis-Pfad.
// Projektstudien und Katalog gehoeren zum Bereich WERKE.
const path = Astro.url.pathname;
const rel = (path.startsWith(BASE_URL) ? path.slice(BASE_URL.length) : path).replace(/^\//, '');
const seg = rel.split('/')[0];
const is = (...sections) => (sections.includes(seg) ? 'nav-current' : '');
---

<div id="main-menu" class="nav-links">
    <ul class="nav">
        <li class={`nav-home ${is('')}`.trim()}>
            <a href={BASE_URL} aria-current={seg === '' ? 'page' : undefined}>HOME</a>
        </li>
        <li class={`nav-home ${is('news')}`.trim()}>
            <a href={`${BASE_URL}news`} aria-current={seg === 'news' ? 'page' : undefined}>AKTUELL</a>
        </li>
        <li class={`nav-home ${is('work', 'projektstudien', 'katalog', 'glas', 'malerei')}`.trim()}>
            <a href={`${BASE_URL}work`} aria-current={seg === 'work' ? 'page' : undefined}>WERKE</a>
        </li>
                <li class={`nav-home ${is('bio')}`.trim()}>
            <a href={`${BASE_URL}bio`} aria-current={seg === 'bio' ? 'page' : undefined}>BIOGRAPHIE</a>
        </li>
        <li class={`nav-home ${is('impressum')}`.trim()}>
            <a href={`${BASE_URL}impressum`} aria-current={seg === 'impressum' ? 'page' : undefined}>KONTAKT</a>
        </li>
    </ul>
</div>
