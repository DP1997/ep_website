---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const BASE_URL = import.meta.env.BASE_URL;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projektstudien/**/*.{png,jpg}',
  { eager: true }
);

// Blättern in derselben Reihenfolge wie die Uebersicht auf /work
// (glob-Sortierung = alphabetisch nach Dateiname), mit Rundlauf.
const entries = (await getCollection('projektstudien'))
  .slice()
  .sort((a, b) => a.id.localeCompare(b.id));

const currentIndex = entries.findIndex((entry) => entry.id.split('/').pop() === slug);

function previewImage(entry: (typeof entries)[number]) {
  const first = entry.data.images?.[0];
  if (!first) return null;
  const key = Object.keys(allImages).find((path) =>
    path.endsWith(`/${entry.data.image_dir}/${first}`)
  );
  return key ? allImages[key].default : null;
}

const prevEntry =
  currentIndex > -1 && entries.length > 1
    ? entries[(currentIndex - 1 + entries.length) % entries.length]
    : null;
const nextEntry =
  currentIndex > -1 && entries.length > 1
    ? entries[(currentIndex + 1) % entries.length]
    : null;

const prevImage = prevEntry ? previewImage(prevEntry) : null;
const nextImage = nextEntry ? previewImage(nextEntry) : null;

const hrefFor = (entry: (typeof entries)[number]) =>
  `${BASE_URL}projektstudien/${entry.id.split('/').pop()}`;
---

{prevEntry && prevImage && (
  <a
    href={hrefFor(prevEntry)}
    class="ps-nav ps-nav--prev"
    aria-label={`Vorherige Projektstudie: ${prevEntry.data.title}`}
  >
    <svg class="ps-nav__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="14.5 18 8.5 12 14.5 6"/></svg>
    <span class="ps-nav__preview">
      <span class="bio-art-card ps-nav__card">
        <span class="bio-art-card-image">
          <Image src={prevImage} alt="" width={400} sizes="280px" loading="lazy" />
        </span>
        <span class="bio-art-card-year">{prevEntry.data.year || '–'}</span>
        <span class="bio-art-card-title">{prevEntry.data.title}</span>
        {prevEntry.data.location && (
          <span class="bio-art-card-location">{prevEntry.data.location}</span>
        )}
      </span>
    </span>
  </a>
)}
{nextEntry && nextImage && (
  <a
    href={hrefFor(nextEntry)}
    class="ps-nav ps-nav--next"
    aria-label={`Nächste Projektstudie: ${nextEntry.data.title}`}
  >
    <span class="ps-nav__preview">
      <span class="bio-art-card ps-nav__card">
        <span class="bio-art-card-image">
          <Image src={nextImage} alt="" width={400} sizes="280px" loading="lazy" />
        </span>
        <span class="bio-art-card-year">{nextEntry.data.year || '–'}</span>
        <span class="bio-art-card-title">{nextEntry.data.title}</span>
        {nextEntry.data.location && (
          <span class="bio-art-card-location">{nextEntry.data.location}</span>
        )}
      </span>
    </span>
    <svg class="ps-nav__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9.5 18 15.5 12 9.5 6"/></svg>
  </a>
)}

<script>
  // Pfeile sitzen mittig zwischen Viewport-Aussenkante und Blattkante
  // (im 9vw-Rahmen also im mittleren 3vw-Band), vertikal auf halber
  // Blatthoehe. Position setzt das JS, weil das Blatt seine Hoehe aus dem
  // Viewport ableitet.
  function setupProjektstudienNav() {
    const prev = document.querySelector('.ps-nav--prev');
    const next = document.querySelector('.ps-nav--next');
    if (!prev && !next) return;

    // position:fixed braucht einen untransformierten Vorfahren; deshalb
    // haengen die Navigationsknoten direkt am <body>.
    [prev, next].forEach((node) => {
      if (node && node.parentElement !== document.body) document.body.appendChild(node);
    });

    const sheet = document.querySelector('.ps-detail > div');
    if (!sheet) return;

    const rect = sheet.getBoundingClientRect();
    const half = 22;
    const size = 44;
    const air = 8;
    const top = Math.round(rect.top + rect.height / 2 - half);
    const contentLeft = rect.left;
    const contentRight = rect.right;

    function place(node, left) {
      if (!node) return;
      node.style.left = `${Math.round(left)}px`;
      node.style.top = `${top}px`;
      node.style.visibility = 'visible';
    }

    [prev, next].forEach((node) => {
      if (node) {
        node.style.display = '';
        node.style.visibility = 'hidden';
      }
    });

    const fits = contentLeft >= size + air && window.innerWidth - contentRight >= size + air;
    if (!fits) {
      if (prev) prev.style.display = 'none';
      if (next) next.style.display = 'none';
      return;
    }

    if (prev) place(prev, (contentLeft - size) / 2);
    if (next) place(next, (contentRight + window.innerWidth) / 2 - half);
  }

  function scheduleProjektstudienNav() {
    requestAnimationFrame(setupProjektstudienNav);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleProjektstudienNav);
  } else {
    scheduleProjektstudienNav();
  }
  window.addEventListener('load', scheduleProjektstudienNav);
  window.addEventListener('resize', scheduleProjektstudienNav);
  if (document.fonts?.ready) document.fonts.ready.then(scheduleProjektstudienNav);
</script>

<script is:inline>
  (() => {
    const gapPx = () => Math.max(24, window.innerWidth * 0.03);
    const apply = () => {
      const article = document.querySelector('.ps-detail');
      const foot = document.querySelector('.site-foot');
      if (!article || !foot) return;
      foot.style.marginTop = '0px';
      const els = [...article.querySelectorAll('figure, figcaption, [class*="-text"], [class*="-side"]')];
      const low = els.length
        ? Math.max(...els.map(el => el.getBoundingClientRect().bottom))
        : article.getBoundingClientRect().bottom;
      const footTop0 = foot.getBoundingClientRect().top;
      foot.style.marginTop = (low + gapPx() - footTop0) + 'px';
    };
    window.addEventListener('load', apply);
    window.addEventListener('resize', apply);
    apply();
  })();
</script>
<style>
  .ps-nav {
    position: fixed;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    text-decoration: none;
    color: rgba(20, 20, 20, 0.7);
    background: transparent;
    border: 1px solid rgba(20, 20, 20, 0.2);
    border-radius: 50%;
    box-shadow: none;
    visibility: hidden;
    z-index: 40;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .ps-nav:hover,
  .ps-nav:focus-visible {
    color: var(--ps-petrol-text);
    background: rgba(45, 111, 111, 0.07);
    border-color: rgba(45, 111, 111, 0.45);
  }

  .ps-nav:focus-visible {
    outline: 2px solid var(--ps-petrol-text);
    outline-offset: 3px;
  }

  .ps-nav__arrow {
    display: block;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .ps-nav--prev:hover .ps-nav__arrow {
    transform: translateX(-2px);
  }

  .ps-nav--next:hover .ps-nav__arrow {
    transform: translateX(2px);
  }

  /* Vorschau = Karteikarte aus der Werkeuebersicht (bio-art-card). Der
     Wrapper positioniert und blendet ein; die Karte selbst bringt Weiss,
     Rahmen, Rundung und Hover-Lift mit. */
  .ps-nav__preview {
    position: absolute;
    top: 50%;
    width: 280px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
  }

  .ps-nav--prev .ps-nav__preview {
    left: 100%;
    margin-left: 0.65rem;
    transform: translateY(-50%) translateX(-6px);
  }

  .ps-nav--next .ps-nav__preview {
    right: 100%;
    margin-right: 0.65rem;
    transform: translateY(-50%) translateX(6px);
  }

  .ps-nav:hover .ps-nav__preview,
  .ps-nav:focus-visible .ps-nav__preview {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .ps-nav__card {
    display: block;
    width: 280px;
    text-align: left;
  }

  .ps-nav__card .bio-art-card-year,
  .ps-nav__card .bio-art-card-title,
  .ps-nav__card .bio-art-card-location {
    display: block;
  }

  /* Bildkopf der Karteikarte (identisch zur Werkeuebersicht). */
  .ps-nav__preview .bio-art-card-image {
    display: block;
    margin: -1.5rem -1.5rem 1rem -1.5rem;
    line-height: 0;
    overflow: hidden;
    height: 200px;
    border-radius: 0.9rem 0.9rem 0 0;
  }

  .ps-nav__preview .bio-art-card-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0 !important;
  }

  @media (max-width: 900px) {
    .ps-nav {
      display: none;
    }
  }
</style>

<script>
  // TEMPORAER: Zellrahmen (einzelne Bild-/Textelemente) zur Rasterpruefung.
  const drawStudioGrid = () => {
    const article = document.querySelector('.ps-detail');
    if (!article) return;
    const sheet = article.querySelector(':scope > div[class^="ps-"]');
    if (!sheet) return;
    article.querySelectorAll('.ps-grid-overlay').forEach((e) => e.remove());
    const sb = sheet.getBoundingClientRect();
    const seen = new Set();
    const addFrame = (el) => {
      if (!el) return;
      const b = el.getBoundingClientRect();
      if (b.width < 2 || b.height < 2) return;
      const key = [Math.round(b.left), Math.round(b.top), Math.round(b.width), Math.round(b.height)].join(',');
      if (seen.has(key)) return;
      seen.add(key);
      const d = document.createElement('div');
      d.className = 'ps-grid-overlay';
      Object.assign(d.style, {
        position: 'absolute',
        left: (b.left - sb.left) + 'px',
        top: (b.top - sb.top) + 'px',
        width: b.width + 'px',
        height: b.height + 'px',
        border: '2px solid #d40000',
        boxSizing: 'border-box',
        translate: 'none',
        zIndex: '5000',
        pointerEvents: 'none'
      });
      sheet.appendChild(d);
    };
    article.querySelectorAll('figure').forEach((f) => addFrame(f.querySelector('img') || f));
    article.querySelectorAll('img').forEach((img) => { if (!img.closest('figure')) addFrame(img); });
    article.querySelectorAll('[class*="-text"]').forEach((el) => {
      if (el.querySelector('figure, [class*="-text"]')) return;
      addFrame(el);
    });
  };
  const scheduleStudioGrid = () => requestAnimationFrame(() => requestAnimationFrame(drawStudioGrid));
  window.addEventListener('resize', scheduleStudioGrid);
  window.addEventListener('load', scheduleStudioGrid);
  document.fonts?.ready.then(scheduleStudioGrid);
  scheduleStudioGrid();
</script>
