---

// FlipbookModal.astro
// Modal wrapper for FlipbookViewer using native <dialog> element.
// Triggered by data attributes on catalog cards in the parent page.
// Styles moved to src/styles/components/flipbook-modal.css
// Script moved to public/js/flipbook-modal.js

const CATALOGS = {
  glas: {
    title: 'Katalog Fusingglas',
    pdf: '/kataloge/glas_split_vertically_and_scaled.pdf',
  },
  malerei: {
    title: 'Katalog Malerei',
    pdf: '/kataloge/malerei.pdf',
  },
};
---

{/* Backdrop + dialog shell — initially hidden, opened via JS */}
<dialog id="fb-modal" class="fb-modal">
  <div class="fb-modal-inner">
    <div class="fb-modal-toolbar" id="fb-modal-toolbar">
      <a href="#" class="fb-btn fb-btn-download" id="fb-download" download aria-label="Katalog herunterladen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>PDF</span>
      </a>
      <button class="fb-btn fb-btn-close" aria-label="Katalog schließen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span>Schließen</span>
      </button>
    </div>

    <div class="fb-progress-track" id="fb-progress-track" aria-hidden="true">
      <div class="fb-progress-fill" id="fb-progress-fill" style="width:0%"></div>
    </div>

    <div class="fb-modal-content" id="fb-modal-content">
      {/* Flipbook shell gets injected here */}
    </div>
  </div>
</dialog>

{/* Catalog data available to client JS */}
<script is:inline src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js"></script>
<script is:inline define:vars={{ catalogs: CATALOGS }}>
  window.__CATALOGS = catalogs;
</script>

{/* Flipbook core scripts — versioned for cache busting */}
<script is:inline src="/js/flipbook-config.js?v=75"></script>
<script is:inline src="/js/flipbook-pdf.js?v=75"></script>
<script is:inline src="/js/flipbook-stairs.js?v=75"></script>
<script is:inline src="/js/flipbook-spine-render.js?v=75"></script>
<script is:inline src="/js/flipbook-spine-state.js?v=75"></script>
<script is:inline src="/js/flipbook-events.js?v=75"></script>
<script is:inline src="/js/flipbook-init.js?v=75"></script>
<script is:inline src="/js/flipbook-main.js?v=75"></script>

{/* Modal chrome logic: open/close, progress bar, download link */}
<link rel="stylesheet" href="/styles/flipbook-modal.css?v=73" />
<script is:inline src="/js/flipbook-modal.js?v=75"></script>
