---
// FlipbookModal.astro
// Modal wrapper for FlipbookViewer using native <dialog> element.
// Triggered by data attributes on catalog cards in the parent page.

const CATALOGS = {
  glas: {
    title: 'Katalog Fusingglas',
    pdf: '/kataloge/glas_split_vertically_and_scaled.pdf',
  },
  malerei: {
    title: 'Katalog Malerei',
    pdf: '/kataloge/malerei.pdf',
  },
};
---

{/* Backdrop + dialog shell — initially hidden, opened via JS */}
<dialog id="fb-modal" class="fb-modal">
  <div class="fb-modal-inner">
    <button class="fb-modal-close" aria-label="Katalog schließen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="fb-modal-content" id="fb-modal-content">
      {/* Flipbook shell gets injected here */}
    </div>
  </div>
</dialog>

{/* Catalog data available to client JS */}
<script is:inline src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js"></script>
<script is:inline define:vars={{ catalogs: CATALOGS }}>
  window.__CATALOGS = catalogs;
</script>

<style is:global>
  .fb-modal {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: none;
    max-height: none;
    width: auto;
    height: auto;
    overflow: visible;
    /* Center child (.fb-modal-inner) in viewport both axes */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* CRITICAL: hide dialog contents when not open — overrides UA default
     because our display:flex above would otherwise keep it visible */
  .fb-modal:not([open]) {
    display: none;
  }

  /* Backdrop: brighter, frosted glass behind the modal.
     Lighter gray + heavier blur makes dark stripes pop instead of
     blending into a near-black background. */
  .fb-modal::backdrop {
    background: rgba(80, 80, 80, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* Firefox fallback for backdrop-filter */
  @supports not (backdrop-filter: blur(8px)) {
    .fb-modal::backdrop {
      background: rgba(0, 0, 0, 0.55);
    }
  }

  .fb-modal-inner {
    position: relative;
    width: 98vw;
    height: 96vh;
    max-width: 98vw;
    max-height: 96vh;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
    overflow: visible;
  }

  .fb-modal-close {
    position: fixed;
    top: 1.5vh;
    right: 1.5vw;
    z-index: 200;
    width: 2.4rem;
    height: 2.4rem;
    min-width: 2.4rem;
    min-height: 2.4rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.95);
    border: 2px solid rgba(0,0,0,0.15);
    border-radius: 50%;
    cursor: pointer;
    color: #333;
    transition: background 0.15s, transform 0.15s, border-color 0.15s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    padding: 0;
    margin: 0;
    overflow: hidden;
    -webkit-appearance: none;
    appearance: none;
  }

  .fb-modal-close:hover {
    background: #fff;
    border-color: rgba(0,0,0,0.25);
    transform: scale(1.08);
  }

  .fb-modal-close svg {
    width: 1.1rem;
    height: 1.1rem;
    stroke: #333;
    display: block;
  }

  .fb-modal-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: visible;
  }

  /* The shell inside modal: explicit height so StPageFlip can size itself,
     but centered within the modal content area */
  .fb-modal-content .flipbook-shell {
    width: 100%;
    height: 96vh;
    min-height: 350px;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Loader inside modal: transparent so backdrop shows through,
     but loader elements still visible via their own backgrounds */
  .fb-modal-content .fb-loader {
    background: transparent;
  }

  /* StPageFlip wrapper inside modal — StPageFlip manages its own positioning */
  .fb-modal-content .stf__wrapper {
    margin: 0 auto;
  }

  /* Spine shadow — MUST be global since modal injects HTML dynamically */
  #fb-spine {
    position: absolute;
    pointer-events: none;
    z-index: 5;
    width: 120px;
    background: linear-gradient(
      90deg,
      rgba(0,0,0,0.00) 0%,
      rgba(0,0,0,0.01) 10%,
      rgba(0,0,0,0.03) 20%,
      rgba(0,0,0,0.06) 30%,
      rgba(0,0,0,0.10) 40%,
      rgba(0,0,0,0.16) 48%,
      rgba(0,0,0,0.18) 50%,
      rgba(0,0,0,0.16) 52%,
      rgba(0,0,0,0.10) 60%,
      rgba(0,0,0,0.06) 70%,
      rgba(0,0,0,0.03) 80%,
      rgba(0,0,0,0.01) 90%,
      rgba(0,0,0,0.00) 100%
    );
    opacity: 1;
  }

  /* Fore-edge staircase strips */
  #fb-strip-left,
  #fb-strip-right {
    position: absolute;
    pointer-events: none;
    z-index: 45;
  }

  /* Mobile: nearly full-screen */
  @media (max-width: 640px) {
    .fb-modal-inner {
      width: 98vw;
      height: 96vh;
      max-width: 98vw;
      max-height: 96vh;
    }
    .fb-modal-close {
      top: 1vh;
      right: 1.5vw;
      width: 2rem;
      height: 2rem;
    }
    .fb-modal-close svg {
      width: 1rem;
      height: 1rem;
    }
  }
</style>

<script is:inline>
  (function() {
    var modal = document.getElementById('fb-modal');
    var content = document.getElementById('fb-modal-content');
    var closeBtn = modal.querySelector('.fb-modal-close');

    if (!modal || !content) return;

    var currentCleanup = null;

    function openModal(catalogId) {
      var cfg = window.__CATALOGS && window.__CATALOGS[catalogId];
      if (!cfg) return;

      document.body.style.overflow = 'hidden';

      // Build flipbook HTML inside modal
      content.innerHTML =
        '<div class="flipbook-shell" data-pdf-url="' + cfg.pdf + '">' +
          '<div class="fb-loader" id="fb-loader"><div class="fb-loader-anim">' +
            '<div class="fb-lp fb-lp--back"></div>' +
            '<div class="fb-lp fb-lp--front"></div>' +
          '</div></div>' +
          '<div id="fb-book"></div>' +
          '<div id="fb-spine" class="spine-hidden"></div>' +
          '<div id="fb-strip-left"><canvas></canvas></div>' +
          '<div id="fb-strip-right"><canvas></canvas></div>' +
        '</div>';

      modal.showModal();

      requestAnimationFrame(function() {
        initFlipbookInModal();
      });
    }

    function closeModal() {
      if (!modal.open) return;
      modal.close();
      document.body.style.overflow = '';
      if (currentCleanup) {
        currentCleanup();
        currentCleanup = null;
      }
      content.innerHTML = '';
    }

    window.openCatalogModal = openModal;
    window.closeCatalogModal = closeModal;

    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    modal.addEventListener('close', function() {
      document.body.style.overflow = '';
      if (currentCleanup) {
        currentCleanup();
        currentCleanup = null;
      }
      content.innerHTML = '';
    });

    function initFlipbookInModal() {
      // Destroy any existing flipbook instance
      if (window.Flipbook && window.Flipbook.flip) {
        try { window.Flipbook.flip.destroy(); } catch(e) {}
      }
      window.Flipbook = null;

      // Wait for PDF.js and StPageFlip to be available, then init
      function waitForLibs(cb, tries) {
        if (tries == null) tries = 0;
        if (window.pdfjsLib && window.St && window.St.PageFlip) {
          cb();
          return;
        }
        if (tries > 60) { // ~3s timeout
          console.error('Flipbook: PDF.js or StPageFlip failed to load');
          return;
        }
        setTimeout(function() { waitForLibs(cb, tries + 1); }, 50);
      }

      function doInit() {
        // If modules are already loaded, just call __initFlipbook
        var hasModules = window.Flipbook && typeof window.Flipbook.loadAndInit === 'function';
        if (hasModules && typeof window.__initFlipbook === 'function') {
          window.__initFlipbook();
          return;
        }
        // Load module scripts fresh
        var scripts = [
          '/js/flipbook-config.js?v=47',
          '/js/flipbook-pdf.js?v=47',
          '/js/flipbook-stairs.js?v=47',
          '/js/flipbook-spine.js?v=47',
          '/js/flipbook-main.js?v=47'
        ];
        var loaded = 0;
        function checkDone() {
          loaded++;
          if (loaded === scripts.length && typeof window.__initFlipbook === 'function') {
            window.__initFlipbook();
          }
        }
        scripts.forEach(function(src) {
          var s = document.createElement('script');
          s.src = src;
          s.onload = checkDone;
          s.onerror = function() {
            console.error('Failed to load flipbook module:', src);
            checkDone();
          };
          document.head.appendChild(s);
        });
      }

      waitForLibs(doInit);

      currentCleanup = function() {
        if (window.Flipbook && window.Flipbook.flip) {
          try { window.Flipbook.flip.destroy(); } catch(e) {}
        }
        window.Flipbook = null;
      };
    }
  })();
</script>
