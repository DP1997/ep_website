---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { compareWorks } from '../lib/sort';

interface Props {
  category: string;
  slug: string;
}

const { category, slug } = Astro.props;
const BASE_URL = import.meta.env.BASE_URL;

const allWorkImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png}',
  { eager: true }
);

function previewImage(work: { data: { image_dir: string } }) {
  const dir = work.data.image_dir;
  const keys = Object.keys(allWorkImages);
  const key =
    keys.find((path) => path.endsWith(`/${dir}/1.jpg`)) ??
    keys.find((path) => path.includes(`/${dir}/`));
  return key ? allWorkImages[key].default : null;
}

// Blättern in derselben Reihenfolge wie die Kategorie-Übersicht (Rundlauf).
const works = (await getCollection('works', ({ id }) => id.startsWith(category + '/')))
  .slice()
  .sort(compareWorks);

const currentIndex = works.findIndex((work) => work.id.split('/').pop() === slug);
const prevWork =
  currentIndex > -1 && works.length > 1
    ? works[(currentIndex - 1 + works.length) % works.length]
    : null;
const nextWork =
  currentIndex > -1 && works.length > 1
    ? works[(currentIndex + 1) % works.length]
    : null;
const prevImage = prevWork ? previewImage(prevWork) : null;
const nextImage = nextWork ? previewImage(nextWork) : null;

const hrefFor = (work: (typeof works)[number]) =>
  `${BASE_URL}${category}/${work.id.split('/').pop()}`;
---

{prevWork && prevImage && (
  <a
    href={hrefFor(prevWork)}
    class="wc-nav wc-nav--prev"
    aria-label={`Vorheriges Werk: ${prevWork.data.title}`}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="14.5 18 8.5 12 14.5 6"/></svg>
    <span class="wc-nav__preview">
      <span class="bio-art-card wc-nav__card">
        <span class="bio-art-card-image">
          <Image src={prevImage} alt="" width={400} sizes="280px" loading="lazy" />
        </span>
        <span class="bio-art-card-year">{prevWork.data.date || '–'}</span>
        <span class="bio-art-card-title">{prevWork.data.title}</span>
        {prevWork.data.location && (
          <span class="bio-art-card-location">{prevWork.data.location}</span>
        )}
      </span>
    </span>
  </a>
)}
{nextWork && nextImage && (
  <a
    href={hrefFor(nextWork)}
    class="wc-nav wc-nav--next"
    aria-label={`Nächstes Werk: ${nextWork.data.title}`}
  >
    <span class="wc-nav__preview">
      <span class="bio-art-card wc-nav__card">
        <span class="bio-art-card-image">
          <Image src={nextImage} alt="" width={400} sizes="280px" loading="lazy" />
        </span>
        <span class="bio-art-card-year">{nextWork.data.date || '–'}</span>
        <span class="bio-art-card-title">{nextWork.data.title}</span>
        {nextWork.data.location && (
          <span class="bio-art-card-location">{nextWork.data.location}</span>
        )}
      </span>
    </span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9.5 18 15.5 12 9.5 6"/></svg>
  </a>
)}

<script>
  // Pfeile sitzen im 3-%-Band zwischen Viewport und Blatt, vertikal in der
  // Viewport-Mitte (die Werkseiten scrollen, anders als die PS-Blätter).
  function setupWorkNav() {
    const prev = document.querySelector('.wc-nav--prev');
    const next = document.querySelector('.wc-nav--next');
    if (!prev && !next) return;

    // position:fixed braucht einen untransformierten Vorfahren.
    [prev, next].forEach((node) => {
      if (node && node.parentElement !== document.body) document.body.appendChild(node);
    });

    const sheet = document.querySelector('.wc');
    if (!sheet) return;

    const size = 44;
    const half = size / 2;
    const air = 8;
    const rect = sheet.getBoundingClientRect();
    const top = Math.round(window.innerHeight / 2 - half);

    [prev, next].forEach((node) => {
      if (!node) return;
      node.style.display = '';
      node.style.visibility = 'hidden';
    });

    const fits =
      window.innerWidth > 900 &&
      rect.left >= size + air &&
      window.innerWidth - rect.right >= size + air;
    if (!fits) {
      if (prev) prev.style.display = 'none';
      if (next) next.style.display = 'none';
      return;
    }

    const place = (node: Element | null, left: number) => {
      if (!node) return;
      (node as HTMLElement).style.left = `${Math.round(left)}px`;
      (node as HTMLElement).style.top = `${top}px`;
      (node as HTMLElement).style.visibility = 'visible';
    };

    place(prev, (rect.left - size) / 2);
    place(next, (rect.right + window.innerWidth) / 2 - half);
  }

  const scheduleWorkNav = () => requestAnimationFrame(setupWorkNav);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleWorkNav);
  } else {
    scheduleWorkNav();
  }
  window.addEventListener('load', scheduleWorkNav);
  window.addEventListener('resize', scheduleWorkNav);
  if (document.fonts?.ready) document.fonts.ready.then(scheduleWorkNav);
</script>

<style>
  .wc-nav {
    position: fixed;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    text-decoration: none;
    color: rgba(20, 20, 20, 0.7);
    background: transparent;
    border: 1px solid rgba(20, 20, 20, 0.2);
    border-radius: 50%;
    box-shadow: none;
    visibility: hidden;
    z-index: 40;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .wc-nav:hover,
  .wc-nav:focus-visible {
    color: var(--ps-petrol-text);
    background: rgba(45, 111, 111, 0.07);
    border-color: rgba(45, 111, 111, 0.45);
  }

  .wc-nav:focus-visible {
    outline: 2px solid var(--ps-petrol-text);
    outline-offset: 3px;
  }

  .wc-nav svg {
    display: block;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .wc-nav--prev:hover svg { transform: translateX(-2px); }
  .wc-nav--next:hover svg { transform: translateX(2px); }

  /* Goldstandard-Vorschau: Karteikarte aus der Werkeübersicht. */
  .wc-nav__preview {
    position: absolute;
    top: 50%;
    width: 280px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
  }

  .wc-nav--prev .wc-nav__preview {
    left: 100%;
    margin-left: 0.65rem;
    transform: translateY(-50%) translateX(-6px);
  }

  .wc-nav--next .wc-nav__preview {
    right: 100%;
    margin-right: 0.65rem;
    transform: translateY(-50%) translateX(6px);
  }

  .wc-nav:hover .wc-nav__preview,
  .wc-nav:focus-visible .wc-nav__preview {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .wc-nav__card {
    display: block;
    width: 280px;
    text-align: left;
  }

  .wc-nav__card .bio-art-card-year,
  .wc-nav__card .bio-art-card-title,
  .wc-nav__card .bio-art-card-location {
    display: block;
  }

  .wc-nav__preview .bio-art-card-image {
    display: block;
    margin: -1.5rem -1.5rem 1rem -1.5rem;
    line-height: 0;
    overflow: hidden;
    height: 200px;
    border-radius: 0.9rem 0.9rem 0 0;
  }

  .wc-nav__preview .bio-art-card-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0 !important;
  }

  @media (max-width: 900px) {
    .wc-nav { display: none; }
  }
</style>
