---
import { Image } from 'astro:assets';

interface Props {
  href: string;
  src: string | ImageMetadata;
  alt: string;
  label?: string;
}

const { href, src, alt, label = "" } = Astro.props;
---

<a href={href} class="linked-image">
  <div class="linked-image__wrapper">
    {typeof src === 'string' ? (
      <img src={src} alt={alt} class="linked-image__img" />
    ) : (
      <Image src={src} alt={alt} class="linked-image__img" />
    )}
    <div class="linked-image__overlay">
      <span class="linked-image__label">{label || alt}</span>
    </div>
  </div>
</a>

<style>
  .linked-image {
    display: block;
    text-decoration: none;
    line-height: 0;
  }

  .linked-image__wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    line-height: 0;
    aspect-ratio: 1 / 1;
    width: 100%;
  }

  .linked-image__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
    transition: filter 0.3s ease;
  }

  .linked-image__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: var(--radius);
  }

  .linked-image__label {
    color: #fff;
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: 1.6rem;
    text-align: center;
    padding: 10px 12px;
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
  }

  @media (max-width: 1250px) {
    .linked-image__label {
      font-size: 1.6rem;
    }
  }

  @media (max-width: 740px) {
    .linked-image__label {
      font-size: 1.4rem;
    }
  }

  .linked-image:hover .linked-image__img,
  .linked-image:focus .linked-image__img {
    filter: grayscale(60%) brightness(0.7);
  }

  .linked-image:hover .linked-image__overlay,
  .linked-image:focus .linked-image__overlay {
    opacity: 1;
  }
</style>