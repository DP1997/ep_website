---
import type { ImageMetadata } from 'astro';
import WorkFigure from './WorkFigure.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    location?: string;
    date: string;
    client?: string;
  };
  dim?: boolean;
  variant?: 'stacked' | 'wide' | 'beside' | 'subgrid' | 'split';
  style?: string;
  /** Optionales Bild in der Textzeile (Restbild neben Meta und Text). */
  aside?: ImageMetadata | null;
  /** Spalte des Bildes in der Textzeile (Default: letzte Spalte). */
  asideCol?: string;
  /** Lightbox-Index des Bildes in der Textzeile. */
  asideIndex?: number;
  /** Bild zwischen Meta und Text (Villa Fluss). */
  between?: ImageMetadata | null;
  betweenIndex?: number;
  copyClass?: string;
}

const { frontmatter, dim, variant = 'stacked', style, aside = null, asideCol, asideIndex = -1, between = null, betweenIndex = -1, copyClass } = Astro.props;
---

<div class:list={['wc-copy', `wc-copy--${variant}`, copyClass]} style={style}>
  <div class="wc-meta">
    <h1 class="wc-title">
      {frontmatter.title}{dim && <>{' '}<span class="wc-dim-badge">dim</span></>}
    </h1>
    {frontmatter.description && <p class="wc-desc">{frontmatter.description}</p>}
    <div class="wc-labels">
      {frontmatter.location && (
        <div class="wc-label">
          <span class="wc-label__key">Ort</span>
          <span class="wc-label__value">{frontmatter.location}</span>
        </div>
      )}
      <div class="wc-label">
        <span class="wc-label__key">Jahr</span>
        <span class="wc-label__value">{frontmatter.date}</span>
      </div>
      {frontmatter.client && (
        <div class="wc-label">
          <span class="wc-label__key">Auftraggeber</span>
          <span class="wc-label__value">{frontmatter.client}</span>
        </div>
      )}
    </div>
  </div>
  {between && (
    <WorkFigure
      img={between}
      alt={`${frontmatter.title} — Bild`}
      index={betweenIndex}
      figureClass="wc-between"
      eager
      sizes="(min-width: 741px) 45vw, 46vw"
      widths={[600, 900, 1200]}
    />
  )}
  <div class="wc-body"><slot /></div>
  {/* copy_image: mittig, wenn die Textzeile hoeher ist als das deklarierte
      Bild (Villa Fluss, deklariert in ps-contract.json deviations). */}
  {aside && (
    <WorkFigure
      img={aside}
      alt={`${frontmatter.title} — Bild`}
      index={asideIndex}
      figureClass="wc-aside"
      style={asideCol ? `grid-column: ${asideCol}; grid-row: 1; align-self: center;` : undefined}
      eager
      sizes="(min-width: 741px) 20vw, 46vw"
      widths={[400, 800, 1200]}
    />
  )}
</div>
