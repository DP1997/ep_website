---
import type { ImageMetadata } from 'astro';
import WorkFigure from './WorkFigure.astro';
import WorkCopy from './WorkCopy.astro';
import { aspect as arOf, groupRows, heroSidePlan, villaDimFractions } from '../lib/work-rows';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    location?: string;
    date: string;
    client?: string;
    dim?: boolean;
    gallery_swap?: boolean;
    meta_span?: number;
    hero_side?: boolean;
    villa?: boolean;
    impuls?: boolean;
    stack_copy_stacked?: boolean;
    stack_copy_style?: string;
    stack_copy_swapped?: boolean;
    stack_swap_columns?: boolean;
    band_narrow_first?: boolean;
    dim_layout?: 'kompakt' | 'stack' | 'reihen' | 'band' | 'heroleft' | 'threecol' | 'underhero' | 'mosaic4';
  };
  heroImg: ImageMetadata | null;
  gallery: { img: ImageMetadata; index: number }[];
  dim: boolean;
}

const { frontmatter, heroImg, gallery, dim } = Astro.props;

// ---------------------------------------------------------------------------
// Aufbau (Contract A1/A2, §8 Strip-Solver):
//
//   Zeile 1   Hero                     volle Breite
//   Zeile 2   Meta | Text | (Bild)     eine Textzeile
//   Zeile 3+  Detailbilder              Strips, hoehengleich, volle Breite
//
// Die Textzeile steht im Spaltenraster der ersten Bildzeile darunter: Meta
// belegt Spalte 1 und hat damit horizontal genau die Ausdehnung des ersten
// Bildes, das Textfeld nimmt die restlichen Spalten und endet buendig rechts
// wie das letzte Bild (A2: gleiche Spalte = gleiche Kanten).
//
// Spaltenbreiten kommen aus den Aspekten (Strip-Solver): die Bilder einer
// Zeile sind dadurch hoehengleich und die Zeile fuellt die volle Breite.
// Ein breites Querformat bekommt automatisch eine breitere Spalte - es zieht
// also ueber mehrere Spalten, statt auf eine gestutzt zu werden.
//
// Bilder: absteigend nach Aspekt sortiert. Spalte 1 traegt damit das
// breiteste Bild - dort steht das Meta-Feld, es braucht Breite fuer Titel
// und Labels. Weil aufeinanderfolgende Bilder aehnliche Aspekte haben,
// stimmen auch die Spaltengrenzen der Bildzeilen ueberein.
//
// Bilder, die in keine vollstaendige Zeile passen, stehen in der Textzeile -
// dort stoeren sie die Buendigkeit der Bildzeilen nicht.
// ---------------------------------------------------------------------------

const perRow = dim ? 3 : 2;

// Absteigend nach Aspekt: breite Bilder zuerst. Damit traegt Spalte 1 das
// breiteste Bild - dort steht das Meta-Feld, es braucht Breite fuer Titel
// und Labels.
//
// Fuer die Buendigkeit der Bildzeilen untereinander (gleiche Spalten-
// grenzen) ist entscheidend, dass die Zeilen dieselbe Spaltenverteilung
// haben. Das gelingt, wenn Bilder mit aehnlichem Aspekt in derselben
// Spaltenposition landen: die Zeilen werden dann spaltenweise (nicht
// zeilenweise) aus der sortierten Liste gefuellt, sodass jede Spalte
// ueber alle Zeilen hinweg aehnliche Aspekte hat.
const sorted = [...gallery].sort((a, b) => arOf(b.img) - arOf(a.img));

// gallery_swap: die Bilder tauschen die Plaetze innerhalb ihrer Zeile(n).
// Die Spaltenbreite folgt weiter dem Aspekt des jeweiligen Bildes - getauscht
// wird nur die Position, nicht die Proportion. Dadurch bleiben die Bilder
// hoehengleich und die Kanten buendig; das Textfeld darueber uebernimmt das
// neue Raster der ersten Bildzeile.
const ordered = frontmatter.gallery_swap ? [...sorted].reverse() : sorted;

// Spaltenbreiten einer Bildzeile: proportional zum Aspekt (Strip-Solver).
// Die Bilder einer Zeile sind dadurch hoehengleich und die Zeile fuellt die
// volle Breite.
const rowTemplate = (row: { img: ImageMetadata }[]) => {
  const ars = row.map((g) => arOf(g.img));
  const sum = ars.reduce((a, b) => a + b, 0);
  return ars.map((a) => `${a / sum}fr`).join(' ');
};

// Zeilen: hoechstens perRow Bilder pro Zeile.
//
// Entscheidend fuer die Buendigkeit (A2): die Bilder einer Zeile teilen
// sich ein aspect-proportionales Raster (Strip-Solver) - dadurch sind sie
// hoehengleich und die Zeile fuellt die volle Breite.
//
// Mehrere Bildzeilen koennen ihre Spaltengrenzen nur uebereinstimmen
// lassen, wenn ihre Aspekte aehnlich sind. Deshalb:
// - bis vier Bilder: alle in EINE Zeile (kein Grenz-Problem, Bilder noch
//   gross genug),
// - ab fuenf Bildern: gleich viele Bilder je Zeile, und ein Restbild geht
//   in die Textzeile. So haben alle Bildzeilen dieselbe Spaltenzahl und
//   ihre Grenzen liegen uebereinander.
// Restbild in die Textzeile, damit alle Bildzeilen gleich viele Bilder
// haben. Das Restbild ist das schmalste (Portrait) - in der Textzeile
// stoert es die Buendigkeit nicht.
const { rows, asideImg } = groupRows(ordered, perRow);

// Spaltenraster der ersten Bildzeile: die Breiten sind die Aspektanteile
// der Bilder dieser Zeile. Das Textfeld uebernimmt genau diese Breiten, das
// Meta-Feld die erste Spalte.
const firstRow = rows[0] ?? [];
const firstArs = firstRow.map((g) => arOf(g.img));
const firstSum = firstArs.reduce((a, b) => a + b, 0);
// Ein einzelnes Detailbild liefert nur eine Spalte. Die Textzeile braucht
// aber zwei (Meta | Text) - sonst kollabiert die Meta-Spalte auf 0 px und
// Meta und Text ueberlappen (Glut, Impuls, Zeichen). Dort daher 1:2.
const colTemplate =
  firstArs.length === 1
    ? '1fr 2fr'
    : firstArs.length
      ? firstArs.map((a) => `${a / firstSum}fr`).join(' ')
      : '1fr 1fr';

// Textzeile: Spalte 1 hat exakt die Breite des ersten Bildes (Meta-Feld =
// erstes Bild, A2). Das Textfeld nimmt die restlichen Bildspalten und endet
// buendig rechts. Ein Bild in der Textzeile steht in eigenen Spalten ganz
// rechts, der Text endet dann an dessen linker Kante.
const asideAr = asideImg ? arOf(asideImg.img) : 0;
const asideTemplate = asideImg ? `${(asideAr / firstSum).toFixed(4)}fr` : '';
const copyTemplate = [colTemplate, asideTemplate].filter(Boolean).join(' ');

// meta_span: das Meta-Feld belegt die ersten n Bildspalten. Seine Kanten
// bleiben damit auf den Kanten der ersten n Bilder (A2); das Textfeld
// beginnt an der linken Kante des naechsten Bildes.
const metaSpan = Math.min(
  Math.max(1, frontmatter.meta_span ?? 1),
  Math.max(1, firstRow.length)
);
const copyStyle = [
  `grid-template-columns: ${copyTemplate};`,
  `--meta-col: 1 / ${metaSpan + 1};`,
  `--body-col: ${metaSpan + 1} / ${asideImg ? -2 : -1};`
].filter(Boolean).join(' ');

// --- Deklariert: ein Detailbild rueckt in die Textzeile ---------------------
// copy_image:   Bildnummer, die aus der Bildzeile in die Textzeile rueckt
// copy_image_h: Hoehe der Textzeile als Anteil der Blattbreite. Daraus folgt
//               die Breite des Bildes ueber seinen Aspekt - das Bild ist damit
//               oben und unten buendig mit der Textzeile.
// strip_break:  die Bildzeile bekommt ein eigenes Zwei-Spalten-Raster. Das ist
//               ein deklarierter Raster-Bruch (A2-Ausnahme): die Grenze der
//               Bildzeile liegt dann nicht auf der Grenze der Textzeile.
const gapFrac = 0.015; // 1,5 cqw Gap, bezogen auf die Blattbreite
const copyImageNum = frontmatter.copy_image ?? null;
const copyImageH = frontmatter.copy_image_h ?? null;
const useCopyImage = copyImageNum !== null && copyImageH !== null;

let copyImg: { img: ImageMetadata; index: number } | null = null;
let strip = ordered;
let layoutStyle = copyStyle;
let stripTemplate: string | null = null;
let stripCols: string[] = [];

if (useCopyImage) {
  const ci = ordered.findIndex((g) => g.index === copyImageNum);
  if (ci >= 0) {
    copyImg = ordered[ci];
    strip = ordered.filter((_, i) => i !== ci);
    const arC = arOf(copyImg.img);
    const wImg = copyImageH * arC;
    const stripArs = strip.map((g) => arOf(g.img));
    const stripSum = stripArs.reduce((a, b) => a + b, 0);
    const avail = 1 - gapFrac * 2 - wImg;
    const weights = stripArs.map((a) => avail * (a / stripSum));
    // fr-Faktoren muessen zusammen 1 ergeben, sonst bleibt rechts Restbreite.
    const cols = [weights[0], wImg, ...weights.slice(1)];
    const colSum = cols.reduce((a, b) => a + b, 0);
    const template = cols
      .map((w) => `${(w / colSum).toFixed(5)}fr`)
      .join(' ');
    layoutStyle = [
      `grid-template-columns: ${template};`,
      '--meta-col: 1 / 2;',
      '--body-col: 3 / -1;'
    ].join(' ');
    // Ohne Raster-Bruch teilen Textzeile und Bildzeile dasselbe Raster; die
    // mittlere Zelle der Bildzeile bleibt dann frei (lokale Luecke, A3).
    stripTemplate = frontmatter.strip_break
      ? stripArs.map((a) => `${a}fr`).join(' ')
      : template;
    stripCols = frontmatter.strip_break
      ? []
      : ['1 / 2', '3 / 4'];
  }
}

// --- Width first: Hero links, Copy rechts, Hochformate in dritter Spalte ----
// Wenn das Hero (bzw. ein Detailbild) hochkant ist, wuerde die reine
// Hero-Fit-Regel das ganze Blatt schmal und hoch zwingen. Auf dem Desktop
// waechst das Layout stattdessen zuerst in die Breite: Hero links, Copy in
// Spalte 2, hochformatige Detailbilder als weitere Spalten. Querformate
// folgen in Zeilen darunter. Die Spalten werden auf eine gemeinsame
// Oberkante h geloest (h = W * factor).
const heroSide = frontmatter.hero_side === true && heroImg !== null;
const heroSideCopyFrac = 0.4;
const heroSidePlanResult = heroSide
  ? heroSidePlan(arOf(heroImg as ImageMetadata), gallery, heroSideCopyFrac, gapFrac)
  : null;
const heroSideUsable = heroSidePlanResult !== null && heroSidePlanResult.factor > 0.02;
// fr-Gewichte muessen sich zu 1 summieren, sonst bleibt rechts Restbreite
// (CSS multipliziert bei Summe < 1 nur mit der freien Breite).
const heroSideNorm = heroSidePlanResult
  ? 1 - heroSidePlanResult.columns * gapFrac
  : 1;
const heroSideTemplate = heroSideUsable
  ? [
      `${(heroSidePlanResult!.factor * arOf(heroImg as ImageMetadata) / heroSideNorm).toFixed(5)}fr`,
      `${(heroSideCopyFrac / heroSideNorm).toFixed(5)}fr`,
      ...heroSidePlanResult!.portraits.map(
        (g) => `${(heroSidePlanResult!.factor * arOf(g.img) / heroSideNorm).toFixed(5)}fr`
      )
    ].join(' ')
  : '';
const heroSideRows = heroSideUsable
  ? groupRows(
      [...heroSidePlanResult!.landscapes].sort((a, b) => arOf(b.img) - arOf(a.img)),
      3
    ).rows
  : [];

// Spalten aus der unteren Detailzeile uebernehmen (hero_side_align: bottom):
// die drei unteren Bilder definieren die Spalten, Hero/Copy/Hochbild stehen
// darueber in genau diesen Spalten. Die Copy-Hoehe wird auf die Hero-Hoehe
// begrenzt, damit ihre Unterkante mit der Hero-Unterkante schliesst.
const heroSideTopCols = heroSidePlanResult
  ? 2 + heroSidePlanResult.portraits.length
  : 0;
const heroSideBottomRow =
  frontmatter.hero_side_align === 'bottom' &&
  heroSideRows[0] &&
  heroSideRows[0].length === heroSideTopCols
    ? heroSideRows[0]
    : null;
let heroSideFinalTemplate = heroSideTemplate;
let heroSideCopyHeight = '';
let heroSidePortraitAspect: number[] = [];
if (heroSideBottomRow && heroImg) {
  const sum = heroSideBottomRow.reduce((s, g) => s + arOf(g.img), 0);
  heroSideFinalTemplate = heroSideBottomRow
    .map((g) => `${(arOf(g.img) / sum).toFixed(5)}fr`)
    .join(' ');
  // Hero-Hoehe in cqw: Spaltenanteil x verfuegbare Breite / Hero-Aspekt.
  const heroHcqw =
    (arOf(heroSideBottomRow[0].img) / sum) *
    (1 - 2 * gapFrac) /
    arOf(heroImg) *
    100;
  heroSideCopyHeight = `height: ${heroHcqw.toFixed(2)}cqw;`;
  // Hochbilder exakt auf Hero-Hoehe beschneiden (Breite = Spalte): das
  // Seitenverhaeltnis der Spalte ist ar_j/ar_0 * Hero-Aspekt.
  heroSidePortraitAspect = heroSidePlanResult!.portraits.map(
    (g, i) => (arOf(heroSideBottomRow[i + 2].img) / arOf(heroSideBottomRow[0].img)) * arOf(heroImg)
  );
}

// --- Villa Fuss: Width first mit Detailband ---------------------------------
// Basis: Hero links (Spalte 1), Copy rechts (Spalte 2). Unter dem Hero zwei
// Detailbilder nebeneinander, unter der Copy das dritte - das Band beginnt
// an der Hero-Unterkante.
// Dim: gleiche Idee, aber drei Spalten (Hero | Copy | gestapelte Details),
// also eine andere Spalten-/Zeilenzahl.
const villaLayout =
  frontmatter.villa === true && heroImg !== null && gallery.length >= 3;
const villaHeroFrac = 0.45;
const villaHeroAR = heroImg ? arOf(heroImg) : 1;
const villaUnder = villaLayout && !dim ? gallery.slice(0, 2) : [];
const villaRight = villaLayout && !dim ? gallery[2] : null;
const villaBetween = villaLayout
  ? dim
    ? gallery[1] ?? null
    : villaRight
  : null;
// Dim: die Summe der Detailhoehen in Spalte 3 muss der Hero-Hoehe
// entsprechen (erste Bildoberkante = Hero-Oberkante, dritte Bildunterkante =
// Hero-Unterkante). Die Spaltenbreite folgt daraus exakt.
const villaDimSumInv = gallery.reduce((s, g) => s + 1 / arOf(g.img), 0);
const villaDimFrac = villaDimFractions(villaHeroAR, villaDimSumInv, gapFrac);
const villaDimHeroHcqw = (villaDimFrac.heroFrac * 100) / villaHeroAR;
const villaBaseHeroHcqw = (50 * (1 - gapFrac)) / villaHeroAR;
const villaCopyHeroHcqw = dim ? villaDimHeroHcqw : villaBaseHeroHcqw;
const villaDimRowTemplate = gallery
  .map((g) => `${((1 / arOf(g.img)) / villaDimSumInv).toFixed(5)}fr`)
  .join(' ');
const villaTemplate = villaLayout
  ? dim
    ? `${(villaDimFrac.heroFrac * 100).toFixed(4)}% ${(villaDimFrac.sideFrac * 100).toFixed(4)}% ${(villaDimFrac.sideFrac * 100).toFixed(4)}%`
    : 'minmax(0, 1fr) minmax(0, 1fr)'
  : '';

// --- Impuls: Width first ----------------------------------------------------
// Basis: 2x2 - Hero | Meta / Body | Detail. Das Hochformat sitzt rechts unten.
// Dim: Hochformat gross links (wie Hero), rechts Meta + Text + Querformat
// gestapelt. Andere Zeilen-/Spaltenzahl als die Basis.
const impulsLayout =
  frontmatter.impuls === true && heroImg !== null && gallery.length >= 1;
const impulsPortrait = impulsLayout ? gallery[0] : null;
const impulsPortraitAR = impulsPortrait ? arOf(impulsPortrait.img) : 1;
const impulsBand = [
  ...(impulsPortrait ? [impulsPortrait] : []),
  ...(heroImg ? [{ img: heroImg, index: 0 }] : [])
];
const impulsDimTemplate = '32% minmax(0, 1fr)';
const impulsDimHeroHcqw = 32 / impulsPortraitAR;

// --- Dim-Vergleichsvarianten -------------------------------------------------
// 'kompakt': Hero | Copy in einer Zeile, Details in Zeilen darunter.
// 'stack':   Hero links ueber alle Zeilen, Details rechts gestapelt, Copy unten.
// 'reihen':  Hero, Copy, dann jedes Detail in einer eigenen Zeile.
const dimMode = dim ? frontmatter.dim_layout : undefined;
const dimCropOf = (g: { img: ImageMetadata; index: number }) =>
  frontmatter.dim_crops?.[String(g.index)] ?? arOf(g.img);
const dimStackHeroAR = heroImg
  ? frontmatter.hero_crop ?? arOf(heroImg)
  : 1;
const dimStackSumInv = gallery.reduce((s, g) => s + 1 / dimCropOf(g), 0);
const dimColGapFrac = gapFrac / (1 - gapFrac);
const dimStackExact =
  heroImg && gallery.length
    ? (1 / dimStackHeroAR - dimColGapFrac * (gallery.length - 1)) /
      (dimStackSumInv + 1 / dimStackHeroAR)
    : 0;
const dimStackS = Math.max(0.12, Math.min(0.6, dimStackExact));
const dimStackM = 1 - dimStackS;
const stackCopyVariant = frontmatter.stack_copy_stacked
  ? 'stacked'
  : frontmatter.stack_copy_swapped || frontmatter.stack_swap_columns
    ? 'split'
    : 'wide';
const stackCopyStyle = frontmatter.stack_copy_swapped
  ? `grid-template-columns: ${dimStackM}fr ${dimStackS}fr; --meta-col: 2 / 3; --body-col: 1 / 2;`
  : frontmatter.stack_swap_columns
    ? `grid-template-columns: ${dimStackS}fr ${dimStackM}fr; --meta-col: 1 / 2; --body-col: 2 / -1;`
    : frontmatter.stack_copy_style;
const dimBandRow =
  dimMode === 'band' && heroImg
    ? [{ img: heroImg, index: 0 }, ...gallery].sort((a, b) =>
        frontmatter.band_narrow_first
          ? arOf(a.img) - arOf(b.img)
          : arOf(b.img) - arOf(a.img)
      )
    : [];
const dimBandMetaSpan = Math.min(frontmatter.meta_span ?? 0, dimBandRow.length);
const dimBandCopyStyle =
  dimBandMetaSpan > 0
    ? `grid-template-columns: ${rowTemplate(dimBandRow)}; --meta-col: 1 / ${dimBandMetaSpan + 1}; --body-col: ${dimBandMetaSpan + 1} / -1;`
    : 'grid-template-columns: 34% minmax(0, 1fr); --meta-col: 1 / 2; --body-col: 2 / -1;';

// threecol: Hochformat gross in Spalte 1, die übrigen Details gestapelt in
// Spalte 2, Hero in Spalte 3 - alle gleich hoch (H). Copy: Meta unter dem
// Hochformat, Body über die restlichen zwei Spalten (voller Span).
const threePortrait =
  dimMode === 'threecol' ? gallery.find((g) => arOf(g.img) < 1) ?? null : null;
const threeOthers =
  dimMode === 'threecol' ? gallery.filter((g) => arOf(g.img) >= 1) : [];
const threeOK =
  dimMode === 'threecol' && heroImg !== null && threePortrait !== null && threeOthers.length >= 1;
const threeHeroAR = heroImg ? arOf(heroImg) : 1;
const threePortraitAR = threePortrait ? arOf(threePortrait.img) : 1;
const threeOthersInv = threeOthers.reduce((s, g) => s + 1 / arOf(g.img), 0);
const threeHFrac = threeOK
  ? (1 + gapFrac / threeOthersInv - 2 * gapFrac) /
    (threePortraitAR + 1 / threeOthersInv + threeHeroAR)
  : 0;
const threeH = threeHFrac * 100;
const threeCols = threeOK
  ? `${(threePortraitAR * threeH).toFixed(3)}cqw ${((threeH - 1.5) / threeOthersInv).toFixed(3)}cqw ${(threeHeroAR * threeH).toFixed(3)}cqw`
  : '';

// mosaic4: Hero allein oben; darunter 4 Spalten: Hochformat (Zeilen 2-3),
// Meta (2-3), Text (2-3), zwei Querformate (je eine Zeile).
const mosPortrait =
  dimMode === 'mosaic4' ? gallery.find((g) => arOf(g.img) < 1) ?? null : null;
const mosLand =
  dimMode === 'mosaic4' ? gallery.filter((g) => arOf(g.img) >= 1) : [];
const mosOK =
  dimMode === 'mosaic4' && heroImg !== null && mosPortrait !== null && mosLand.length === 2;
const mosHFrac = 0.24;
const mosGap = 1.5;
const mosInv = mosLand.reduce((s, g) => s + 1 / arOf(g.img), 0);
const mosCol1 = (mosPortrait ? arOf(mosPortrait.img) : 1) * mosHFrac * 100;
const mosCol4 = (mosHFrac * 100 - mosGap) / (mosInv || 1);
const mosRemaining = 100 - mosCol1 - mosCol4 - 3 * mosGap;
const mosCols = `${mosCol1.toFixed(3)}cqw ${(mosRemaining * 0.33).toFixed(3)}cqw ${mosCol4.toFixed(3)}cqw ${(mosRemaining * 0.67).toFixed(3)}cqw`;
const mosRow1 = (100 / (heroImg ? arOf(heroImg) : 1)).toFixed(3);
const mosRow2 = (mosCol4 / (mosLand[0] ? arOf(mosLand[0].img) : 1)).toFixed(3);
const mosRow3 = (mosCol4 / (mosLand[1] ? arOf(mosLand[1].img) : 1)).toFixed(3);
---

<div class="wv" data-variant={dim ? 'dim' : 'base'}>
  {heroSideUsable ? (
    <>
      <div class="wv-heroside" style={`grid-template-columns: ${heroSideFinalTemplate};`}>
        {heroImg && (
          <WorkFigure
            img={heroImg}
            alt={frontmatter.title}
            index={0}
            figureClass="wc-hero"
            style="grid-column: 1;"
            eager
            sizes="(min-width: 741px) 45vw, 92vw"
            widths={[800, 1200, 1600, 2000]}
          />
        )}
        <WorkCopy
          frontmatter={frontmatter}
          dim={dim}
          variant="stacked"
          style={`grid-column: 2; justify-content: space-between; ${heroSideCopyHeight}`}
        >
          <slot />
        </WorkCopy>
        {heroSidePlanResult!.portraits.map((g, i) => (
          <WorkFigure
            img={g.img}
            alt={`${frontmatter.title} — Bild ${g.index}`}
            index={g.index}
            figureClass={heroSidePortraitAspect[i] ? 'wc-fit-crop' : undefined}
            crop={Boolean(heroSidePortraitAspect[i])}
            style={`grid-column: ${i + 3}; ${heroSidePortraitAspect[i] ? `aspect-ratio: ${heroSidePortraitAspect[i].toFixed(4)};` : ''}`}
            sizes="(min-width: 741px) 20vw, 46vw"
            widths={[400, 800, 1200]}
          />
        ))}
      </div>
      {heroSideRows.map((row) => (
        <div class="wv-strip" style={`grid-template-columns: ${rowTemplate(row)};`}>
          {row.map((g) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={g.index}
              sizes="(min-width: 741px) 27vw, 46vw"
              widths={[600, 900, 1200]}
            />
          ))}
        </div>
      ))}
    </>
  ) : mosOK ? (
    <div
      class="wv"
      style={`display: grid; grid-template-columns: ${mosCols}; grid-template-rows: ${mosRow1}cqw ${mosRow2}cqw ${mosRow3}cqw; column-gap: var(--gap); row-gap: var(--gap); align-items: start;`}
    >
      {heroImg && (
        <WorkFigure
          img={heroImg}
          alt={frontmatter.title}
          index={0}
          figureClass="wc-hero"
          style="grid-column: 1 / -1; grid-row: 1;"
          eager
          sizes="(min-width: 741px) 82vw, 92vw"
          widths={[800, 1200, 1600, 2000]}
        />
      )}
      {mosPortrait && (
        <WorkFigure
          img={mosPortrait.img}
          alt={`${frontmatter.title} — Bild ${mosPortrait.index}`}
          index={mosPortrait.index}
          style="grid-column: 1; grid-row: 2 / span 2;"
          eager
          sizes="(min-width: 741px) 20vw, 46vw"
          widths={[400, 800, 1200]}
        />
      )}
      <WorkCopy
        frontmatter={frontmatter}
        dim={dim}
        variant="stacked"
        copyClass="wc-copy--mosaic"
      >
        <slot />
      </WorkCopy>
      {mosLand.map((g, i) => (
        <WorkFigure
          img={g.img}
          alt={`${frontmatter.title} — Bild ${g.index}`}
          index={g.index}
          style={`grid-column: 3; grid-row: ${i + 2};`}
          sizes="(min-width: 741px) 25vw, 46vw"
          widths={[600, 900, 1200]}
        />
      ))}
    </div>
  ) : threeOK ? (
    <>
      <div
        class="wv"
        style={`display: grid; grid-template-columns: ${threeCols}; column-gap: var(--gap); align-items: start;`}
      >
        {threePortrait && (
          <WorkFigure
            img={threePortrait.img}
            alt={`${frontmatter.title} — Bild ${threePortrait.index}`}
