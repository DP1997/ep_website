---
import type { ImageMetadata } from 'astro';
import WorkFigure from './WorkFigure.astro';
import WorkCopy from './WorkCopy.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    location?: string;
    date: string;
    client?: string;
    dim?: boolean;
    gallery_swap?: boolean;
  };
  heroImg: ImageMetadata | null;
  gallery: { img: ImageMetadata; index: number }[];
  dim: boolean;
}

const { frontmatter, heroImg, gallery, dim } = Astro.props;
const arOf = (img: ImageMetadata) => img.width / img.height;

// ---------------------------------------------------------------------------
// Aufbau (Contract A1/A2, §8 Strip-Solver):
//
//   Zeile 1   Hero                     volle Breite
//   Zeile 2   Meta | Text | (Bild)     eine Textzeile
//   Zeile 3+  Detailbilder              Strips, hoehengleich, volle Breite
//
// Die Textzeile steht im Spaltenraster der ersten Bildzeile darunter: Meta
// belegt Spalte 1 und hat damit horizontal genau die Ausdehnung des ersten
// Bildes, das Textfeld nimmt die restlichen Spalten und endet buendig rechts
// wie das letzte Bild (A2: gleiche Spalte = gleiche Kanten).
//
// Spaltenbreiten kommen aus den Aspekten (Strip-Solver): die Bilder einer
// Zeile sind dadurch hoehengleich und die Zeile fuellt die volle Breite.
// Ein breites Querformat bekommt automatisch eine breitere Spalte - es zieht
// also ueber mehrere Spalten, statt auf eine gestutzt zu werden.
//
// Bilder: absteigend nach Aspekt sortiert. Spalte 1 traegt damit das
// breiteste Bild - dort steht das Meta-Feld, es braucht Breite fuer Titel
// und Labels. Weil aufeinanderfolgende Bilder aehnliche Aspekte haben,
// stimmen auch die Spaltengrenzen der Bildzeilen ueberein.
//
// Bilder, die in keine vollstaendige Zeile passen, stehen in der Textzeile -
// dort stoeren sie die Buendigkeit der Bildzeilen nicht.
// ---------------------------------------------------------------------------

const perRow = dim ? 3 : 2;

// Absteigend nach Aspekt: breite Bilder zuerst. Damit traegt Spalte 1 das
// breiteste Bild - dort steht das Meta-Feld, es braucht Breite fuer Titel
// und Labels.
//
// Fuer die Buendigkeit der Bildzeilen untereinander (gleiche Spalten-
// grenzen) ist entscheidend, dass die Zeilen dieselbe Spaltenverteilung
// haben. Das gelingt, wenn Bilder mit aehnlichem Aspekt in derselben
// Spaltenposition landen: die Zeilen werden dann spaltenweise (nicht
// zeilenweise) aus der sortierten Liste gefuellt, sodass jede Spalte
// ueber alle Zeilen hinweg aehnliche Aspekte hat.
const sorted = [...gallery].sort((a, b) => arOf(b.img) - arOf(a.img));

// gallery_swap: die Bilder tauschen die Plaetze innerhalb ihrer Zeile(n).
// Die Spaltenbreite folgt weiter dem Aspekt des jeweiligen Bildes - getauscht
// wird nur die Position, nicht die Proportion. Dadurch bleiben die Bilder
// hoehengleich und die Kanten buendig; das Textfeld darueber uebernimmt das
// neue Raster der ersten Bildzeile.
const ordered = frontmatter.gallery_swap ? [...sorted].reverse() : sorted;

// Spaltenbreiten einer Bildzeile: proportional zum Aspekt (Strip-Solver).
// Die Bilder einer Zeile sind dadurch hoehengleich und die Zeile fuellt die
// volle Breite.
const rowTemplate = (row: { img: ImageMetadata }[]) => {
  const ars = row.map((g) => arOf(g.img));
  const sum = ars.reduce((a, b) => a + b, 0);
  return ars.map((a) => `${a / sum}fr`).join(' ');
};

// Zeilen: hoechstens perRow Bilder pro Zeile.
//
// Entscheidend fuer die Buendigkeit (A2): die Bilder einer Zeile teilen
// sich ein aspect-proportionales Raster (Strip-Solver) - dadurch sind sie
// hoehengleich und die Zeile fuellt die volle Breite.
//
// Mehrere Bildzeilen koennen ihre Spaltengrenzen nur uebereinstimmen
// lassen, wenn ihre Aspekte aehnlich sind. Deshalb:
// - bis vier Bilder: alle in EINE Zeile (kein Grenz-Problem, Bilder noch
//   gross genug),
// - ab fuenf Bildern: gleich viele Bilder je Zeile, und ein Restbild geht
//   in die Textzeile. So haben alle Bildzeilen dieselbe Spaltenzahl und
//   ihre Grenzen liegen uebereinander.
const rows: { img: ImageMetadata; index: number }[][] = [];
let asideImg: { img: ImageMetadata; index: number } | null = null;
if (ordered.length <= 4) {
  if (ordered.length) rows.push(ordered);
} else {
  // Restbild in die Textzeile, damit alle Bildzeilen gleich viele Bilder
  // haben. Das Restbild ist das schmalste (Portrait) - in der Textzeile
  // stoert es die Buendigkeit nicht.
  const rest = ordered.length % perRow;
  const keep = rest === 1 ? ordered.length - 1 : ordered.length;
  if (rest === 1) asideImg = ordered[ordered.length - 1];
  const usable = ordered.slice(0, keep);
  const rowSize = usable.length / Math.floor(usable.length / perRow);
  const rowCount = Math.round(usable.length / rowSize);
  for (let r = 0; r < rowCount; r += 1) {
    rows.push(usable.slice(r * rowSize, (r + 1) * rowSize));
  }
}

// Spaltenraster der ersten Bildzeile: die Breiten sind die Aspektanteile
// der Bilder dieser Zeile. Das Textfeld uebernimmt genau diese Breiten, das
// Meta-Feld die erste Spalte.
const firstRow = rows[0] ?? [];
const firstArs = firstRow.map((g) => arOf(g.img));
const firstSum = firstArs.reduce((a, b) => a + b, 0);
const colTemplate = firstArs.length
  ? firstArs.map((a) => `${a / firstSum}fr`).join(' ')
  : '1fr 1fr';

// Textzeile: Spalte 1 hat exakt die Breite des ersten Bildes (Meta-Feld =
// erstes Bild, A2). Das Textfeld nimmt die restlichen Bildspalten und endet
// buendig rechts. Ein Bild in der Textzeile steht in eigenen Spalten ganz
// rechts, der Text endet dann an dessen linker Kante.
const asideAr = asideImg ? arOf(asideImg.img) : 0;
const asideTemplate = asideImg ? `${(asideAr / firstSum).toFixed(4)}fr` : '';
const copyTemplate = [colTemplate, asideTemplate].filter(Boolean).join(' ');
const copyStyle = [
  `grid-template-columns: ${copyTemplate};`,
  '--meta-col: 1 / 2;',
  `--body-col: 2 / ${asideImg ? -2 : -1};`
].filter(Boolean).join(' ');
---

<div class="wv" data-variant={dim ? 'dim' : 'base'}>
  {heroImg && (
    <WorkFigure
      img={heroImg}
      alt={frontmatter.title}
      index={0}
      figureClass="wc-hero"
      eager
      sizes="(min-width: 741px) 82vw, 92vw"
      widths={[800, 1200, 1600, 2000]}
    />
  )}

  <WorkCopy
    frontmatter={frontmatter}
    dim={dim}
    variant="split"
    style={copyStyle}
    aside={asideImg?.img ?? null}
  >
    <slot />
  </WorkCopy>

  {rows.map((row) => (
    <div class="wv-strip" style={`grid-template-columns: ${rowTemplate(row)};`}>
      {row.map((g) => (
        <WorkFigure
          img={g.img}
          alt={`${frontmatter.title} — Bild ${g.index}`}
          index={g.index}
          sizes={perRow === 2 ? '(min-width: 741px) 41vw, 46vw' : '(min-width: 741px) 27vw, 46vw'}
          widths={perRow === 2 ? [600, 900, 1200] : [400, 800, 1200]}
        />
      ))}
    </div>
  ))}
</div>

<style>
  .wv {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* Bildzeile im selben Raster wie die Textzeile. */
  .wv-strip {
    display: grid;
    column-gap: var(--gap);
    align-items: start;
  }
</style>
