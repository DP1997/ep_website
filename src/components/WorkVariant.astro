---
import type { ImageMetadata } from 'astro';
import WorkFigure from './WorkFigure.astro';
import WorkCopy from './WorkCopy.astro';
import { aspect as arOf, groupRows, heroSidePlan } from '../lib/work-rows';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    location?: string;
    date: string;
    client?: string;
    dim?: boolean;
    gallery_swap?: boolean;
    meta_span?: number;
    hero_side?: boolean;
  };
  heroImg: ImageMetadata | null;
  gallery: { img: ImageMetadata; index: number }[];
  dim: boolean;
}

const { frontmatter, heroImg, gallery, dim } = Astro.props;

// ---------------------------------------------------------------------------
// Aufbau (Contract A1/A2, §8 Strip-Solver):
//
//   Zeile 1   Hero                     volle Breite
//   Zeile 2   Meta | Text | (Bild)     eine Textzeile
//   Zeile 3+  Detailbilder              Strips, hoehengleich, volle Breite
//
// Die Textzeile steht im Spaltenraster der ersten Bildzeile darunter: Meta
// belegt Spalte 1 und hat damit horizontal genau die Ausdehnung des ersten
// Bildes, das Textfeld nimmt die restlichen Spalten und endet buendig rechts
// wie das letzte Bild (A2: gleiche Spalte = gleiche Kanten).
//
// Spaltenbreiten kommen aus den Aspekten (Strip-Solver): die Bilder einer
// Zeile sind dadurch hoehengleich und die Zeile fuellt die volle Breite.
// Ein breites Querformat bekommt automatisch eine breitere Spalte - es zieht
// also ueber mehrere Spalten, statt auf eine gestutzt zu werden.
//
// Bilder: absteigend nach Aspekt sortiert. Spalte 1 traegt damit das
// breiteste Bild - dort steht das Meta-Feld, es braucht Breite fuer Titel
// und Labels. Weil aufeinanderfolgende Bilder aehnliche Aspekte haben,
// stimmen auch die Spaltengrenzen der Bildzeilen ueberein.
//
// Bilder, die in keine vollstaendige Zeile passen, stehen in der Textzeile -
// dort stoeren sie die Buendigkeit der Bildzeilen nicht.
// ---------------------------------------------------------------------------

const perRow = dim ? 3 : 2;

// Absteigend nach Aspekt: breite Bilder zuerst. Damit traegt Spalte 1 das
// breiteste Bild - dort steht das Meta-Feld, es braucht Breite fuer Titel
// und Labels.
//
// Fuer die Buendigkeit der Bildzeilen untereinander (gleiche Spalten-
// grenzen) ist entscheidend, dass die Zeilen dieselbe Spaltenverteilung
// haben. Das gelingt, wenn Bilder mit aehnlichem Aspekt in derselben
// Spaltenposition landen: die Zeilen werden dann spaltenweise (nicht
// zeilenweise) aus der sortierten Liste gefuellt, sodass jede Spalte
// ueber alle Zeilen hinweg aehnliche Aspekte hat.
const sorted = [...gallery].sort((a, b) => arOf(b.img) - arOf(a.img));

// gallery_swap: die Bilder tauschen die Plaetze innerhalb ihrer Zeile(n).
// Die Spaltenbreite folgt weiter dem Aspekt des jeweiligen Bildes - getauscht
// wird nur die Position, nicht die Proportion. Dadurch bleiben die Bilder
// hoehengleich und die Kanten buendig; das Textfeld darueber uebernimmt das
// neue Raster der ersten Bildzeile.
const ordered = frontmatter.gallery_swap ? [...sorted].reverse() : sorted;

// Spaltenbreiten einer Bildzeile: proportional zum Aspekt (Strip-Solver).
// Die Bilder einer Zeile sind dadurch hoehengleich und die Zeile fuellt die
// volle Breite.
const rowTemplate = (row: { img: ImageMetadata }[]) => {
  const ars = row.map((g) => arOf(g.img));
  const sum = ars.reduce((a, b) => a + b, 0);
  return ars.map((a) => `${a / sum}fr`).join(' ');
};

// Zeilen: hoechstens perRow Bilder pro Zeile.
//
// Entscheidend fuer die Buendigkeit (A2): die Bilder einer Zeile teilen
// sich ein aspect-proportionales Raster (Strip-Solver) - dadurch sind sie
// hoehengleich und die Zeile fuellt die volle Breite.
//
// Mehrere Bildzeilen koennen ihre Spaltengrenzen nur uebereinstimmen
// lassen, wenn ihre Aspekte aehnlich sind. Deshalb:
// - bis vier Bilder: alle in EINE Zeile (kein Grenz-Problem, Bilder noch
//   gross genug),
// - ab fuenf Bildern: gleich viele Bilder je Zeile, und ein Restbild geht
//   in die Textzeile. So haben alle Bildzeilen dieselbe Spaltenzahl und
//   ihre Grenzen liegen uebereinander.
// Restbild in die Textzeile, damit alle Bildzeilen gleich viele Bilder
// haben. Das Restbild ist das schmalste (Portrait) - in der Textzeile
// stoert es die Buendigkeit nicht.
const { rows, asideImg } = groupRows(ordered, perRow);

// Spaltenraster der ersten Bildzeile: die Breiten sind die Aspektanteile
// der Bilder dieser Zeile. Das Textfeld uebernimmt genau diese Breiten, das
// Meta-Feld die erste Spalte.
const firstRow = rows[0] ?? [];
const firstArs = firstRow.map((g) => arOf(g.img));
const firstSum = firstArs.reduce((a, b) => a + b, 0);
// Ein einzelnes Detailbild liefert nur eine Spalte. Die Textzeile braucht
// aber zwei (Meta | Text) - sonst kollabiert die Meta-Spalte auf 0 px und
// Meta und Text ueberlappen (Glut, Impuls, Zeichen). Dort daher 1:2.
const colTemplate =
  firstArs.length === 1
    ? '1fr 2fr'
    : firstArs.length
      ? firstArs.map((a) => `${a / firstSum}fr`).join(' ')
      : '1fr 1fr';

// Textzeile: Spalte 1 hat exakt die Breite des ersten Bildes (Meta-Feld =
// erstes Bild, A2). Das Textfeld nimmt die restlichen Bildspalten und endet
// buendig rechts. Ein Bild in der Textzeile steht in eigenen Spalten ganz
// rechts, der Text endet dann an dessen linker Kante.
const asideAr = asideImg ? arOf(asideImg.img) : 0;
const asideTemplate = asideImg ? `${(asideAr / firstSum).toFixed(4)}fr` : '';
const copyTemplate = [colTemplate, asideTemplate].filter(Boolean).join(' ');

// meta_span: das Meta-Feld belegt die ersten n Bildspalten. Seine Kanten
// bleiben damit auf den Kanten der ersten n Bilder (A2); das Textfeld
// beginnt an der linken Kante des naechsten Bildes.
const metaSpan = Math.min(
  Math.max(1, frontmatter.meta_span ?? 1),
  Math.max(1, firstRow.length)
);
const copyStyle = [
  `grid-template-columns: ${copyTemplate};`,
  `--meta-col: 1 / ${metaSpan + 1};`,
  `--body-col: ${metaSpan + 1} / ${asideImg ? -2 : -1};`
].filter(Boolean).join(' ');

// --- Deklariert: ein Detailbild rueckt in die Textzeile ---------------------
// copy_image:   Bildnummer, die aus der Bildzeile in die Textzeile rueckt
// copy_image_h: Hoehe der Textzeile als Anteil der Blattbreite. Daraus folgt
//               die Breite des Bildes ueber seinen Aspekt - das Bild ist damit
//               oben und unten buendig mit der Textzeile.
// strip_break:  die Bildzeile bekommt ein eigenes Zwei-Spalten-Raster. Das ist
//               ein deklarierter Raster-Bruch (A2-Ausnahme): die Grenze der
//               Bildzeile liegt dann nicht auf der Grenze der Textzeile.
const gapFrac = 0.015; // 1,5 cqw Gap, bezogen auf die Blattbreite
const copyImageNum = frontmatter.copy_image ?? null;
const copyImageH = frontmatter.copy_image_h ?? null;
const useCopyImage = copyImageNum !== null && copyImageH !== null;

let copyImg: { img: ImageMetadata; index: number } | null = null;
let strip = ordered;
let layoutStyle = copyStyle;
let stripTemplate: string | null = null;
let stripCols: string[] = [];

if (useCopyImage) {
  const ci = ordered.findIndex((g) => g.index === copyImageNum);
  if (ci >= 0) {
    copyImg = ordered[ci];
    strip = ordered.filter((_, i) => i !== ci);
    const arC = arOf(copyImg.img);
    const wImg = copyImageH * arC;
    const stripArs = strip.map((g) => arOf(g.img));
    const stripSum = stripArs.reduce((a, b) => a + b, 0);
    const avail = 1 - gapFrac * 2 - wImg;
    const weights = stripArs.map((a) => avail * (a / stripSum));
    // fr-Faktoren muessen zusammen 1 ergeben, sonst bleibt rechts Restbreite.
    const cols = [weights[0], wImg, ...weights.slice(1)];
    const colSum = cols.reduce((a, b) => a + b, 0);
    const template = cols
      .map((w) => `${(w / colSum).toFixed(5)}fr`)
      .join(' ');
    layoutStyle = [
      `grid-template-columns: ${template};`,
      '--meta-col: 1 / 2;',
      '--body-col: 3 / -1;'
    ].join(' ');
    // Ohne Raster-Bruch teilen Textzeile und Bildzeile dasselbe Raster; die
    // mittlere Zelle der Bildzeile bleibt dann frei (lokale Luecke, A3).
    stripTemplate = frontmatter.strip_break
      ? stripArs.map((a) => `${a}fr`).join(' ')
      : template;
    stripCols = frontmatter.strip_break
      ? []
      : ['1 / 2', '3 / 4'];
  }
}

// --- Width first: Hero links, Copy rechts, Hochformate in dritter Spalte ----
// Wenn das Hero (bzw. ein Detailbild) hochkant ist, wuerde die reine
// Hero-Fit-Regel das ganze Blatt schmal und hoch zwingen. Auf dem Desktop
// waechst das Layout stattdessen zuerst in die Breite: Hero links, Copy in
// Spalte 2, hochformatige Detailbilder als weitere Spalten. Querformate
// folgen in Zeilen darunter. Die Spalten werden auf eine gemeinsame
// Oberkante h geloest (h = W * factor).
const heroSide = frontmatter.hero_side === true && heroImg !== null;
const heroSideCopyFrac = 0.4;
const heroSidePlanResult = heroSide
  ? heroSidePlan(arOf(heroImg as ImageMetadata), gallery, heroSideCopyFrac, gapFrac)
  : null;
const heroSideUsable = heroSidePlanResult !== null && heroSidePlanResult.factor > 0.02;
// fr-Gewichte muessen sich zu 1 summieren, sonst bleibt rechts Restbreite
// (CSS multipliziert bei Summe < 1 nur mit der freien Breite).
const heroSideNorm = heroSidePlanResult
  ? 1 - heroSidePlanResult.columns * gapFrac
  : 1;
const heroSideTemplate = heroSideUsable
  ? [
      `${(heroSidePlanResult!.factor * arOf(heroImg as ImageMetadata) / heroSideNorm).toFixed(5)}fr`,
      `${(heroSideCopyFrac / heroSideNorm).toFixed(5)}fr`,
      ...heroSidePlanResult!.portraits.map(
        (g) => `${(heroSidePlanResult!.factor * arOf(g.img) / heroSideNorm).toFixed(5)}fr`
      )
    ].join(' ')
  : '';
const heroSideRows = heroSideUsable
  ? groupRows(
      [...heroSidePlanResult!.landscapes].sort((a, b) => arOf(b.img) - arOf(a.img)),
      3
    ).rows
  : [];
---

<div class="wv" data-variant={dim ? 'dim' : 'base'}>
  {heroSideUsable ? (
    <>
      <div class="wv-heroside" style={`grid-template-columns: ${heroSideTemplate};`}>
        {heroImg && (
          <WorkFigure
            img={heroImg}
            alt={frontmatter.title}
            index={0}
            figureClass="wc-hero"
            style="grid-column: 1;"
            eager
            sizes="(min-width: 741px) 45vw, 92vw"
            widths={[800, 1200, 1600, 2000]}
          />
        )}
        <WorkCopy
          frontmatter={frontmatter}
          dim={dim}
          variant="stacked"
          style="grid-column: 2;"
        >
          <slot />
        </WorkCopy>
        {heroSidePlanResult!.portraits.map((g, i) => (
          <WorkFigure
            img={g.img}
            alt={`${frontmatter.title} — Bild ${g.index}`}
            index={g.index}
            style={`grid-column: ${i + 3};`}
            sizes="(min-width: 741px) 20vw, 46vw"
            widths={[400, 800, 1200]}
          />
        ))}
      </div>
      {heroSideRows.map((row) => (
        <div class="wv-strip" style={`grid-template-columns: ${rowTemplate(row)};`}>
          {row.map((g) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={g.index}
              sizes="(min-width: 741px) 27vw, 46vw"
              widths={[600, 900, 1200]}
            />
          ))}
        </div>
      ))}
    </>
  ) : (
    <>
      {heroImg && (
        <WorkFigure
          img={heroImg}
          alt={frontmatter.title}
          index={0}
          figureClass="wc-hero"
          eager
          sizes="(min-width: 741px) 82vw, 92vw"
          widths={[800, 1200, 1600, 2000]}
        />
      )}

      <WorkCopy
        frontmatter={frontmatter}
        dim={dim}
        variant="split"
        style={layoutStyle}
        aside={copyImg?.img ?? asideImg?.img ?? null}
        asideCol={copyImg ? '2 / 3' : undefined}
        asideIndex={copyImg?.index}
      >
        <slot />
      </WorkCopy>

      {useCopyImage && stripTemplate ? (
        <div class="wv-strip" style={`grid-template-columns: ${stripTemplate};`}>
          {strip.map((g, i) => (
            <WorkFigure
              img={g.img}
              alt={`${frontmatter.title} — Bild ${g.index}`}
              index={g.index}
              style={stripCols[i] ? `grid-column: ${stripCols[i]};` : undefined}
              sizes={perRow === 2 ? '(min-width: 741px) 41vw, 46vw' : '(min-width: 741px) 27vw, 46vw'}
              widths={perRow === 2 ? [600, 900, 1200] : [400, 800, 1200]}
            />
          ))}
        </div>
      ) : (
        rows.map((row) => (
          <div class="wv-strip" style={`grid-template-columns: ${rowTemplate(row)};`}>
            {row.map((g) => (
              <WorkFigure
                img={g.img}
                alt={`${frontmatter.title} — Bild ${g.index}`}
                index={g.index}
                sizes={perRow === 2 ? '(min-width: 741px) 41vw, 46vw' : '(min-width: 741px) 27vw, 46vw'}
                widths={perRow === 2 ? [600, 900, 1200] : [400, 800, 1200]}
              />
            ))}
          </div>
        ))
      )}
    </>
  )}
</div>

<style>
  .wv {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* Bildzeile im selben Raster wie die Textzeile. */
  .wv-strip {
    display: grid;
    column-gap: var(--gap);
    align-items: start;
  }

  /* Width first: Hero | Copy | Hochformate in einer Zeile. */
  .wv-heroside {
    display: grid;
    column-gap: var(--gap);
    align-items: start;
  }
</style>
