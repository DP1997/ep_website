<style>
  .wv {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* Bildzeile im selben Raster wie die Textzeile. */
  .wv-strip {
    display: grid;
    column-gap: var(--gap);
    align-items: start;
  }

  /* Width first: Hero | Copy | Hochformate in einer Zeile. */
  .wv-heroside {
    display: grid;
    column-gap: var(--gap);
    align-items: start;
  }

  /* Villa Fuss: Hero | Copy, darunter das Detailband. */
  .wv-villa {
    display: grid;
    column-gap: var(--gap);
    align-items: start;
  }

  /* Hero und die zwei kleinen Bilder darunter: gleicher Abstand wie im Rest. */
  .wv-villa-col {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .wv-villa-under {
    display: grid;
    column-gap: var(--gap);
    align-items: start;
  }

  .wv-villa-stack {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* Impuls: 2x2 (Basis) bzw. Hochformat links + rechte Stapelspalte (Dim). */
  .wv-impuls {
    display: grid;
    column-gap: var(--gap);
    row-gap: var(--gap);
    align-items: stretch;
  }

  .wv-impuls-side {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* Dim 'stack': Hero links ueber alle Zeilen, Details rechts gestapelt. */
  .wv-dstack {
    display: grid;
    column-gap: var(--gap);
    row-gap: var(--gap);
    align-items: stretch;
  }
</style>
