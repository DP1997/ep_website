---
import Navigation from "./Navigation.astro";
import Social from "./Social.astro"
import Menu from "./Menu.astro";

export interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
const BASE_URL = import.meta.env.BASE_URL;
---

<header class="site-head">
    <div class="site-head-container">

        <Menu />

        <nav id="swup" class="site-head-left">
            <Navigation />
        </nav>

        <div class="site-head-center">
                    <a class="site-head-logo" href={BASE_URL}>
                       {title}
                    </a>
                    {subtitle && <span class="site-head-subtitle">{subtitle}</span>}
                </div>

        <div class="site-head-right">
            <div class="social-links">
                <Social platform="instagram" url="https://www.instagram.com/elkepfaffmann?igsh=MWRwaTk4YXhrOWhxaw==" />
                <Social platform="facebook" url="https://www.facebook.com/share/1DrRtCgqQd/" />
            </div>
        </div>

    </div>
</header>

<style>
  .site-head-center {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .site-head-subtitle {
      display: block;
      font-family: var(--font-serif);
      font-size: 1.3rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--color-base);
      opacity: 0.6;
      text-align: center;
      margin-top: 0.25rem;
    }
</style>
