---
import '../styles/components/hamburger.css';
---

<button class="nav-burger" aria-label="Menü öffnen" aria-expanded="false" aria-controls="site-head">
    <span class="hamburger hamburger--collapse">
        <span class="hamburger-box">
            <span class="hamburger-inner"></span>
        </span>
    </span>
</button>

<script>
  // Mobile-Menü: togglet .site-head-open auf dem Header und pflegt aria-expanded.
  const burger = document.querySelector('.nav-burger');
  const head = document.querySelector('.site-head');
  if (burger && head) {
    burger.addEventListener('click', () => {
      const open = head.classList.toggle('site-head-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    });
  }
</script>