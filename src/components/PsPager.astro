---
const BASE_URL = import.meta.env.BASE_URL;

const PAGES = [
  { slug: 'balla-balla', title: 'Balla Balla' },
  { slug: 'bubbles', title: 'Bubbles' },
  { slug: 'dschungel', title: 'Dschungel' },
  { slug: 'entwicklung', title: 'Entwicklung' },
  { slug: 'skydance', title: 'Skydance' },
  { slug: 'sportler-in-bewegung', title: 'Sportler in Bewegung' },
  { slug: 'stadttor', title: 'Stadttor' },
  { slug: 'stoerche-froesche', title: 'Störche & Frösche' },
];

const { slug } = Astro.props;
const i = Math.max(0, PAGES.findIndex((p) => p.slug === slug));
const prev = PAGES[(i - 1 + PAGES.length) % PAGES.length];
const next = PAGES[(i + 1) % PAGES.length];
const url = (s) => `${BASE_URL}projektstudien/${s}`;
---
<nav class="ps-pager" aria-label="Weitere Projektstudien">
  <a class="ps-pager__prev" href={url(prev.slug)}><span aria-hidden="true">←</span> {prev.title}</a>
  <a class="ps-pager__all" href={`${BASE_URL}work`}>Alle Projektstudien</a>
  <a class="ps-pager__next" href={url(next.slug)}>{next.title} <span aria-hidden="true">→</span></a>
</nav>
