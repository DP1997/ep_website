---
// FlipbookViewer.astro
// StPageFlip-based PDF flipbook — embeddable in normal page flow.
import { FLIPBOOK_VERSION } from '../flipbook-version';

const BASE_URL = import.meta.env.BASE_URL;

interface Props { pdfUrl: string; }
const { pdfUrl } = Astro.props;
---

<div class="flipbook-shell" data-pdf-url={pdfUrl}>
  <div class="fb-loader" id="fb-loader">
    <div class="fb-loader-anim">
      <div class="fb-lp fb-lp--back"></div>
      <div class="fb-lp fb-lp--front"></div>
    </div>
  </div>
  <div id="fb-book"></div>
  <div id="fb-spine" class="spine-hidden"></div>
  <div id="fb-fold-shadow" aria-hidden="true"></div>
  <div id="fb-gloss" aria-hidden="true"></div>
  <div id="fb-ground-shadow" aria-hidden="true"></div>
  <div id="fb-strip-left"><canvas></canvas></div>
  <div id="fb-strip-right"><canvas></canvas></div>
  <div id="fb-ripple" class="fb-ripple" aria-hidden="true"><span class="fb-ripple-wave"></span></div>
</div>

<style>
.flipbook-shell {
  position: relative;
  width: 100%;
  height: 75vh;
  min-height: 350px;
  margin: auto 0;          /* vertical centering within parent */
  background: transparent;
  overflow: hidden;
  font-family: 'DM Sans','Helvetica Neue',sans-serif;
  -webkit-font-smoothing: antialiased;
  display: flex;
  justify-content: center;
  align-items: center;
}

.fb-loader {
  position: absolute; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center;
  background: #fff;
  transition: opacity .35s, visibility .35s;
}
.fb-loader.out { opacity: 0; visibility: hidden; pointer-events: none; }
.fb-loader-anim { position: relative; width: 52px; height: 68px; }
.fb-lp {
  position: absolute; inset: 0;
  border-radius: 2px 4px 4px 2px;
  border: 1px solid rgba(0,0,0,0.08);
}
.fb-lp--back  { background: #f5f5f1; transform: rotate(4deg) translateX(4px); }
.fb-lp--front {
  background: #fafaf6;
  animation: pgflip 1.3s ease-in-out infinite;
  transform-origin: left center;
}
@keyframes pgflip {
  0%   { transform: rotateY(0deg)    scaleX(1); }
  50%  { transform: rotateY(-160deg) scaleX(0.04); }
  100% { transform: rotateY(0deg)    scaleX(1); }
}

#fb-book {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* Fore-edge staircase strips — absolute to shell, not fixed to viewport.
   z-index 0: the book (.stf__parent) sits at z-index 1 above them, so the
   hardcover's white edge covers the innermost strip line at rest. The
   lifted hardcover then physically covers the strips it passes over. */
#fb-strip-left,
#fb-strip-right {
  position: absolute;
  pointer-events: none;
  z-index: 0;
}

/* Spine shadow element — absolute to shell */
#fb-spine {
  position: absolute;
  pointer-events: none;
  z-index: 5;
  width: 120px;
  transition: opacity 0.15s linear;
  background: linear-gradient(
    90deg,
    rgba(0,0,0,0.00) 0%,
    rgba(0,0,0,0.01) 10%,
    rgba(0,0,0,0.03) 20%,
    rgba(0,0,0,0.06) 30%,
    rgba(0,0,0,0.10) 40%,
    rgba(0,0,0,0.16) 48%,
    rgba(0,0,0,0.18) 50%,
    rgba(0,0,0,0.16) 52%,
    rgba(0,0,0,0.10) 60%,
    rgba(0,0,0,0.06) 70%,
    rgba(0,0,0,0.03) 80%,
    rgba(0,0,0,0.01) 90%,
    rgba(0,0,0,0.00) 100%
  );
  opacity: 1;
}

/* Initial hidden state — removed by syncSpine() once the book is laid out */
#fb-spine.spine-hidden {
  opacity: 0;
}

/* Soft drop shadow under the whole book — anchors it to the page. Sized and
   positioned by syncGroundShadow() from the wrapper bounds. */
#fb-ground-shadow {
  position: absolute;
  pointer-events: none;
  z-index: 0;
  opacity: 0.55;
  background: radial-gradient(ellipse at center, rgba(0,0,0,0.28) 0%, rgba(0,0,0,0.10) 55%, rgba(0,0,0,0) 75%);
}

/* Shadow cast by the lifted/folding page onto the opposite half. Positioned
   and scaled by updateFoldShadow() each frame; width scales with progress. */
#fb-fold-shadow {
  position: absolute;
  pointer-events: none;
  z-index: 3;
  opacity: 0;
  transition: opacity 0.12s linear;
  background: linear-gradient(
    90deg,
    rgba(0,0,0,0.16) 0%,
    rgba(0,0,0,0.06) 40%,
    rgba(0,0,0,0) 100%
  );
}

/* Gloss band that sweeps across the folding page's curvature while flipping. */
#fb-gloss {
  position: absolute;
  pointer-events: none;
  z-index: 6;
  opacity: 0;
  background: linear-gradient(
    90deg,
    rgba(255,255,255,0) 0%,
    rgba(255,255,255,0.28) 50%,
    rgba(255,255,255,0) 100%
  );
}

/* The softly curved top of the folded page gets a subtle paper sheen: the
   inner pages receive a faint left-edge shading for paper thickness. */
#fb-book .stf__item canvas {
  box-shadow: inset 1px 0 0 rgba(255,255,255,0.10), inset -1px 0 0 rgba(0,0,0,0.05);
}

/* Ripple hint — concentric water-drop waves on the top-right corner,
   played once to signal "grab and flip here". */
.fb-ripple {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 60;
  opacity: 0;
}
.fb-ripple::before,
.fb-ripple::after,
.fb-ripple-wave {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid rgba(0, 0, 0, 0.35);
  transform: translate(50%, -50%);
}
.fb-ripple.play {
  opacity: 1;
}
.fb-ripple.play::before {
  animation: fb-ripple 1.6s ease-out 0s 1 forwards;
}
.fb-ripple.play::after {
  animation: fb-ripple 1.6s ease-out 0.5s 1 forwards;
}
.fb-ripple.play .fb-ripple-wave {
  animation: fb-ripple 1.6s ease-out 1s 1 forwards;
}
@keyframes fb-ripple {
  0%   { width: 12px; height: 12px; opacity: 0.6; }
  100% { width: 90px; height: 90px; opacity: 0; }
}

/* Force wrapper to establish positioning context so .stf__block
   is constrained to wrapper dimensions, preventing item overflow
   and eliminating the 59px centering-offset jump during hardcover flips. */
:global(.stf__wrapper) {
  position: relative !important;
}
:global(.stf__parent) {
  position: relative !important;
  z-index: 1;
}
:global(.stf__item) {
  background: transparent;
}
:global(.stf__item canvas) {
  display: block;
  width: 100%;
  height: 100%;
}
</style>

<script type="module" src={`${BASE_URL}js/pdfjs-loader.mjs?v=${FLIPBOOK_VERSION}`}></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js"></script>
<script is:inline define:vars={{ FLIPBOOK_VERSION, BASE_URL }}>
  (function(){
    window.__FLIPBOOK_VERSION = FLIPBOOK_VERSION;
    // Load flipbook modules sequentially, gated on window.pdfjsLib being ready
    // (set asynchronously by pdfjs-loader.mjs).
    var scripts = ['config','pdf','spine','events','init'];
    var idx = 0;
    function loadNext() {
      if (idx >= scripts.length) return;
      var n = scripts[idx++];
      var s = document.createElement('script');
      s.src = BASE_URL + 'js/flipbook-' + n + '.js?v=' + FLIPBOOK_VERSION;
      s.onload = loadNext;
      s.onerror = loadNext;
      document.body.appendChild(s);
    }
    function start() {
      window.removeEventListener('pdfjs-ready', start);
      loadNext();
    }
    if (window.pdfjsLib) {
      loadNext();
    } else {
      window.addEventListener('pdfjs-ready', start);
    }
  })();
</script>
