---
// FlipbookViewer.astro
// Turn.js flipbook — minimal, no chrome, just the book.
interface Props { pdfUrl: string; }
const { pdfUrl } = Astro.props;
---

<div class="flipbook-shell" data-pdf-url={pdfUrl}>
  <div class="fb-loader" id="fb-loader">
    <div class="fb-loader-anim">
      <div class="fb-lp fb-lp--back"></div>
      <div class="fb-lp fb-lp--front"></div>
    </div>
  </div>
  <div id="fb-book"></div>
  <div id="fb-spine" aria-hidden="true"></div>
</div>

<style>
.flipbook-shell {
  position: fixed;
  inset: 0;
  background: #fff;
  overflow: hidden;
  font-family: 'DM Sans','Helvetica Neue',sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---- loader ------------------------------------------------------ */
.fb-loader {
  position: absolute; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center;
  background: #fff;
  transition: opacity .35s, visibility .35s;
}
.fb-loader.out { opacity: 0; visibility: hidden; pointer-events: none; }
.fb-loader-anim { position: relative; width: 52px; height: 68px; }
.fb-lp {
  position: absolute; inset: 0;
  border-radius: 2px 4px 4px 2px;
  border: 1px solid rgba(0,0,0,0.08);
}
.fb-lp--back  { background: #f5f5f1; transform: rotate(4deg) translateX(4px); }
.fb-lp--front {
  background: #fafaf6;
  animation: pgflip 1.3s ease-in-out infinite;
  transform-origin: left center;
}
@keyframes pgflip {
  0%   { transform: rotateY(0deg)    scaleX(1); }
  50%  { transform: rotateY(-160deg) scaleX(0.04); }
  100% { transform: rotateY(0deg)    scaleX(1); }
}

/* ---- spine overlay ------------------------------------------------ */
#fb-spine {
  position: absolute;
  pointer-events: none;
  z-index: 50;
  opacity: 0;
  transition: opacity 0.3s;
  background: linear-gradient(to right,
    transparent 0%,
    transparent calc(50% - 60px),
    rgba(0,0,0,0.02) calc(50% - 40px),
    rgba(0,0,0,0.06) calc(50% - 15px),
    rgba(0,0,0,0.12) calc(50% - 4px),
    rgba(0,0,0,0.20) 50%,
    rgba(0,0,0,0.12) calc(50% + 4px),
    rgba(0,0,0,0.06) calc(50% + 15px),
    rgba(0,0,0,0.02) calc(50% + 40px),
    transparent calc(50% + 60px),
    transparent 100%
  );
}
#fb-spine.visible { opacity: 1; }

/* ---- all pages --------------------------------------------------- */
#fb-book .page {
  background: #fff;
}

/* ---- page-turn depth gradients ----------------------------------- */
#fb-book .even .inner-gradient,
#fb-book .odd .inner-gradient,
#fb-book .page-wrapper .inner-gradient {
  position: absolute;
  top: 0; bottom: 0; left: 0;
  width: 40px;
  pointer-events: none;
  z-index: 2;
  background: linear-gradient(to right,
    rgba(0,0,0,0.15) 0%,
    rgba(0,0,0,0.05) 30%,
    transparent 100%);
}

#fb-book .even .outer-gradient,
#fb-book .odd .outer-gradient,
#fb-book .page-wrapper .outer-gradient {
  position: absolute;
  top: 0; bottom: 0; right: 0;
  width: 40px;
  pointer-events: none;
  z-index: 2;
  background: linear-gradient(to left,
    rgba(0,0,0,0.12) 0%,
    rgba(0,0,0,0.03) 30%,
    transparent 100%);
}

/* ---- canvas ------------------------------------------------------ */
#fb-book .page canvas {
  display: block;
  position: relative;
  z-index: 1;
}

/* ---- page numbers ------------------------------------------------ */
#fb-book .page-number {
  color: #999;
  width: 100%;
  bottom: 25px;
  position: absolute;
  display: block;
  text-align: center;
  font-size: 11px;
  z-index: 3;
}
</style>

<script is:inline src="/js/jquery.min.js"></script>
<script is:inline src="/js/turn.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline src="/js/flipbook-init.js"></script>
