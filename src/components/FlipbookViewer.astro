---
// FlipbookViewer.astro
// StPageFlip-based PDF flipbook — minimal, no chrome, just the book.
interface Props { pdfUrl: string; }
const { pdfUrl } = Astro.props;
---

<div class="flipbook-shell" data-pdf-url={pdfUrl}>
  <div class="fb-loader" id="fb-loader">
    <div class="fb-loader-anim">
      <div class="fb-lp fb-lp--back"></div>
      <div class="fb-lp fb-lp--front"></div>
    </div>
  </div>
  <div id="fb-book"></div>
  <div id="fb-spine" class="spine-hidden"></div>
  <div id="fb-strip-left"><canvas></canvas></div>
  <div id="fb-strip-right"><canvas></canvas></div>
</div>

<style>
.flipbook-shell {
  position: fixed;
  inset: 0;
  background: #fff;
  overflow: hidden;
  font-family: 'DM Sans','Helvetica Neue',sans-serif;
  -webkit-font-smoothing: antialiased;
}

.fb-loader {
  position: absolute; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center;
  background: #fff;
  transition: opacity .35s, visibility .35s;
}
.fb-loader.out { opacity: 0; visibility: hidden; pointer-events: none; }
.fb-loader-anim { position: relative; width: 52px; height: 68px; }
.fb-lp {
  position: absolute; inset: 0;
  border-radius: 2px 4px 4px 2px;
  border: 1px solid rgba(0,0,0,0.08);
}
.fb-lp--back  { background: #f5f5f1; transform: rotate(4deg) translateX(4px); }
.fb-lp--front {
  background: #fafaf6;
  animation: pgflip 1.3s ease-in-out infinite;
  transform-origin: left center;
}
@keyframes pgflip {
  0%   { transform: rotateY(0deg)    scaleX(1); }
  50%  { transform: rotateY(-160deg) scaleX(0.04); }
  100% { transform: rotateY(0deg)    scaleX(1); }
}

#fb-book {
  position: absolute;
  inset: 0;
}

/* Left / right page-stack shadows — staircase effect at OUTER edges */
#fb-left-stack,
#fb-right-stack {
  position: fixed;
  pointer-events: none;
  z-index: 4;
}

/* Each stripe is a thin dark line representing page thickness */
#fb-left-stack .stack-stripe,
#fb-right-stack .stack-stripe {
  position: absolute;
  top: 0;
  height: 100%;
  width: 1px;
  background: rgba(0,0,0,0.10);
}

/* Left stack: container sits at left page outer edge, stripes stack rightward (inward) */
/* Stripe positions are px offsets from the left edge of the container */
#fb-left-stack .stack-stripe:nth-child(1)  { left: 0px;   opacity: 0.50; }
#fb-left-stack .stack-stripe:nth-child(2)  { left: 1px;   opacity: 0.45; }
#fb-left-stack .stack-stripe:nth-child(3)  { left: 3px;   opacity: 0.40; }
#fb-left-stack .stack-stripe:nth-child(4)  { left: 6px;   opacity: 0.35; }
#fb-left-stack .stack-stripe:nth-child(5)  { left: 10px;  opacity: 0.30; }
#fb-left-stack .stack-stripe:nth-child(6)  { left: 15px;  opacity: 0.25; }
#fb-left-stack .stack-stripe:nth-child(7)  { left: 21px;  opacity: 0.20; }
#fb-left-stack .stack-stripe:nth-child(8)  { left: 28px;  opacity: 0.15; }
#fb-left-stack .stack-stripe:nth-child(9)  { left: 36px;  opacity: 0.10; }
#fb-left-stack .stack-stripe:nth-child(10) { left: 45px;  opacity: 0.06; }

/* Right stack: container sits at right page outer edge, stripes stack leftward (inward) */
#fb-right-stack .stack-stripe:nth-child(1)  { right: 0px;   opacity: 0.50; }
#fb-right-stack .stack-stripe:nth-child(2)  { right: 1px;   opacity: 0.45; }
#fb-right-stack .stack-stripe:nth-child(3)  { right: 3px;   opacity: 0.40; }
#fb-right-stack .stack-stripe:nth-child(4)  { right: 6px;   opacity: 0.35; }
#fb-right-stack .stack-stripe:nth-child(5)  { right: 10px;  opacity: 0.30; }
#fb-right-stack .stack-stripe:nth-child(6)  { right: 15px;  opacity: 0.25; }
#fb-right-stack .stack-stripe:nth-child(7)  { right: 21px;  opacity: 0.20; }
#fb-right-stack .stack-stripe:nth-child(8)  { right: 28px;  opacity: 0.15; }
#fb-right-stack .stack-stripe:nth-child(9)  { right: 36px;  opacity: 0.10; }
#fb-right-stack .stack-stripe:nth-child(10) { right: 45px;  opacity: 0.06; }

/* Fore-edge staircase strips */
#fb-strip-left,
#fb-strip-right {
  position: absolute;
  pointer-events: none;
  z-index: 45;
}

/* Spine shadow element — positioned via JS to match book bounds */
#fb-spine {
  position: fixed;
  pointer-events: none;
  z-index: 5;
  width: 120px;                    /* Wider for soft bleed-out */
  margin-left: -60px;              /* Center the wider element */
  /* the  Realistic book gutter: smooth horizontal fade from dark center to transparent edges */
  background: linear-gradient(
    90deg,
    rgba(0,0,0,0.00) 0%,
    rgba(0,0,0,0.01) 10%,
    rgba(0,0,0,0.03) 20%,
    rgba(0,0,0,0.06) 30%,
    rgba(0,0,0,0.10) 40%,
    rgba(0,0,0,0.16) 48%,          /* Darkest at spine center */
    rgba(0,0,0,0.18) 50%,
    rgba(0,0,0,0.16) 52%,
    rgba(0,0,0,0.10) 60%,
    rgba(0,0,0,0.06) 70%,
    rgba(0,0,0,0.03) 80%,
    rgba(0,0,0,0.01) 90%,
    rgba(0,0,0,0.00) 100%
  );
  opacity: 1;
  /* No CSS transition — JS rAF sets opacity directly for frame-sync with flip */
}

:global(.stf__item) {
  background: #fff;
}
:global(.stf__item canvas) {
  display: block;
  width: 100%;
  height: 100%;
}
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js"></script>
<script is:inline src="/js/flipbook-stpageflip.js?v=24"></script>
