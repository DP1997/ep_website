---
// FlipbookViewer.astro
// Turn.js flipbook — minimal, no chrome, just the book.
interface Props { pdfUrl: string; }
const { pdfUrl } = Astro.props;
---

<div class="flipbook-shell" data-pdf-url={pdfUrl}>
  <div class="fb-loader" id="fb-loader">
    <div class="fb-loader-anim">
      <div class="fb-lp fb-lp--back"></div>
      <div class="fb-lp fb-lp--front"></div>
    </div>
  </div>
  <div id="fb-book"></div>
  <div id="fb-spine" aria-hidden="true"></div>
</div>

<style>
.flipbook-shell {
  position: fixed;
  inset: 0;
  background: #fff;
  overflow: hidden;
  font-family: 'DM Sans','Helvetica Neue',sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---- loader ------------------------------------------------------ */
.fb-loader {
  position: absolute; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center;
  background: #fff;
  transition: opacity .35s, visibility .35s;
}
.fb-loader.out { opacity: 0; visibility: hidden; pointer-events: none; }
.fb-loader-anim { position: relative; width: 52px; height: 68px; }
.fb-lp {
  position: absolute; inset: 0;
  border-radius: 2px 4px 4px 2px;
  border: 1px solid rgba(0,0,0,0.08);
}
.fb-lp--back  { background: #f5f5f1; transform: rotate(4deg) translateX(4px); }
.fb-lp--front {
  background: #fafaf6;
  animation: pgflip 1.3s ease-in-out infinite;
  transform-origin: left center;
}
@keyframes pgflip {
  0%   { transform: rotateY(0deg)    scaleX(1); }
  50%  { transform: rotateY(-160deg) scaleX(0.04); }
  100% { transform: rotateY(0deg)    scaleX(1); }
}

/* ---- spine overlay ------------------------------------------------ */
#fb-spine {
  position: absolute;
  pointer-events: none;
  z-index: 100;
  opacity: 1; /* starts visible, RAF loop controls during flips */
  /* transition disabled — RAF drives opacity directly */
  background: linear-gradient(to right,
    transparent 0%,
    transparent calc(50% - 50px),
    rgba(0,0,0,0.04) calc(50% - 35px),
    rgba(0,0,0,0.10) calc(50% - 12px),
    rgba(0,0,0,0.22) calc(50% - 3px),
    rgba(0,0,0,0.35) 50%,
    rgba(0,0,0,0.22) calc(50% + 3px),
    rgba(0,0,0,0.10) calc(50% + 12px),
    rgba(0,0,0,0.04) calc(50% + 35px),
    transparent calc(50% + 50px),
    transparent 100%
  );
}

/* ---- all pages --------------------------------------------------- */
#fb-book .page {
  background: #fff;
}

/* ---- canvas ------------------------------------------------------ */
#fb-book .page canvas {
  display: block;
  position: relative;
  z-index: 1;
}

/* ---- page numbers ------------------------------------------------ */
#fb-book .page-number {
  color: #999;
  width: 100%;
  bottom: 25px;
  position: absolute;
  display: block;
  text-align: center;
  font-size: 11px;
  z-index: 3;
}
</style>

<script is:inline src="/js/jquery.min.js?v=1"></script>
<!-- PageFlip (open-source Turn.js replacement) -->
<script is:inline src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<script is:inline src="/js/flipbook-init.js?v=5"></script>
<script is:inline src="/js/flipbook-render.js?v=1"></script>

