---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import LinkedImage from '../components/LinkedImage.astro';

export async function getStaticPaths() {
  const categories = ['kabs', 'kabp', 'fw'];
  return categories.map((category) => ({ params: { category } }));
}

interface CategoryMeta {
  title: string;
  label: string;
}

const categories: Record<string, CategoryMeta> = {
  kabs: { title: 'Sakrale Kunst am Bau', label: 'Sakrale Kunst am Bau' },
  kabp: { title: 'Profane Kunst am Bau', label: 'Profane Kunst am Bau' },
  fw: { title: 'Freie Werke', label: 'Freie Werke' },
};

const { category } = Astro.params;
const meta = categories[category!];

const works = await getCollection('works', ({ id }) => id.startsWith(category! + '/'));
// Sortierung: Jahr absteigend; Werke ohne Datum (z. B. "t.b.d.") ans Ende.
const yearNum = (d: string) => { const m = d.match(/(\d{4})/); return m ? parseInt(m[1], 10) : 0; };
const sorted = [...works].sort((a, b) => yearNum(b.data.date) - yearNum(a.data.date));

// Import all images from assets eagerly
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.jpg',
  { eager: true }
);

function getHeroImage(dir: string) {
  // Try direct file match first (e.g. 'freie_werke/bubbles-ii.jpg')
  let key = Object.keys(allImages).find(k => k.endsWith(`/${dir}`));
  if (key) return allImages[key].default;
  // Fall back to directory with 1.jpg (e.g. 'atem' -> 'atem/1.jpg')
  key = Object.keys(allImages).find(k => k.includes(`/${dir}/1.jpg`));
  return key ? allImages[key].default : null;
}
---

<BaseLayout title={meta.title}>
  <section class="category">
    <h1 class="category__title">{meta.label}</h1>
    <div class="category__grid">
      {sorted.map((work) => {
        const slug = work.id.split('/').pop();
        const heroImg = getHeroImage(work.data.image_dir);
        return heroImg ? (
          <LinkedImage href={`/${category}/${slug}`} src={heroImg} alt={work.data.title} label={work.data.title} />
        ) : null;
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .category {
    max-width: var(--large);
    margin: 0 auto;
    padding: var(--margin) 0;
  }

  .category__title {
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
    margin: 0 0 var(--margin);
  }

  .category__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--margin);
  }

  @media (max-width: 980px) {
    .category__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .category__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

