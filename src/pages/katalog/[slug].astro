---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipbookViewer from '../../components/FlipbookViewer.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'glas' } },
    { params: { slug: 'malerei' } },
  ];
}

const { slug } = Astro.params;

const BASE_URL = import.meta.env.BASE_URL;

const catalogs: Record<string, { title: string; pdf: string }> = {
  glas: {
    title: 'Katalog Fusingglas',
    pdf: `${BASE_URL}kataloge/glas_split_vertically_and_scaled.pdf`,
  },
  malerei: {
    title: 'Katalog Malerei',
    pdf: `${BASE_URL}kataloge/malerei.pdf`,
  },
};

const catalog = catalogs[slug!];
---

<BaseLayout bodyClass="flipbook-page">
  <FlipbookViewer pdfUrl={catalog.pdf} />
</BaseLayout>

<style is:global>
  /* Flipbook page: einheitlicher Top-Abstand kommt aus #site-main
     (wie auf allen Unterseiten), unten bündig bis zum Footer. */
  .flipbook-page #site-main {
    padding-bottom: 0;
    max-width: none;
  }
</style>
