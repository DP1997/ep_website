---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlipbookViewer from '../../components/FlipbookViewer.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'glas' } },
    { params: { slug: 'malerei' } },
  ];
}

const { slug } = Astro.params;

const BASE_URL = import.meta.env.BASE_URL;

const catalogs: Record<string, { title: string; pdf: string }> = {
  glas: {
    title: 'Katalog Fusingglas',
    pdf: `${BASE_URL}kataloge/glas_split_vertically_and_scaled.pdf`,
  },
  malerei: {
    title: 'Katalog Malerei',
    pdf: `${BASE_URL}kataloge/malerei.pdf`,
  },
};

const catalog = catalogs[slug!];
---

<BaseLayout title={catalog.title} bodyClass="flipbook-page">
  <FlipbookViewer pdfUrl={catalog.pdf} />
</BaseLayout>

<style is:global>
  /* Flipbook page: keep site-wrapper padding for header breathing room,
     just remove #site-main padding so flipbook shell is flush between
     header and footer. */
  .flipbook-page #site-main {
    padding: 0;
    max-width: none;
  }
</style>
