---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import img1 from '../../assets/projektstudien/sportler-in-bewegung/1.png';
import img2 from '../../assets/projektstudien/sportler-in-bewegung/2.png';
import img3 from '../../assets/projektstudien/sportler-in-bewegung/3.png';
import img4 from '../../assets/projektstudien/sportler-in-bewegung/4.png';
---
<BaseLayout>
  <article class="ps-detail">
    <header class="ps-header">
      <h1 class="ps-title">„Sportler in Bewegung"</h1>
      <p class="ps-meta">Schulsporthalle Bad Bergzabern · Wandmalerei Foyer/Besuchereingang/Tribüne · ca. 14×2,70 m · 2020 · Projektstudie nicht ausgeführt</p>
    </header>
    <div class="ps-layout ps-layout--sportler">
      <div class="ps-images ps-wide">
        <Image src={img1} alt="Sportler in Bewegung – Standort 1, Gesamtansicht" widths={[1200]} sizes="100vw" />
      </div>
      <div class="ps-text ps-left">
        <h2>Standort 1</h2>
        <p>„Homo semper ludens – der Mensch spielt immer" ist das Leitmotiv der künstlerischen Ausgestaltung der Schulsporthalle in Bad Bergzabern. Dabei werden Menschen in sportlich spielerischer Aktion gezeigt. Der Entwurf sieht eine künstlerische Gestaltung an drei verschiedenen Standorten vor: im Foyer, im Besuchereingang und auf der Tribüne.</p>
      </div>
      <div class="ps-images ps-right">
        <Image src={img2} alt="Sportler in Bewegung – Standort 1, Detail" widths={[800]} sizes="50vw" />
      </div>
      <div class="ps-images ps-wide">
        <Image src={img3} alt="Sportler in Bewegung – Standort 2, Gesamtansicht" widths={[1200]} sizes="100vw" />
      </div>
      <div class="ps-text ps-left">
        <h2>Standort 2</h2>
        <p>Alle drei Entwürfe thematisieren Sportler in Bewegung, die Freude am Spiel, Dynamik und Konzentration zeigen.</p>
      </div>
      <div class="ps-images ps-right">
        <Image src={img4} alt="Sportler in Bewegung – Standort 2, Detail" widths={[800]} sizes="50vw" />
      </div>
    </div>
  </article>
</BaseLayout>
