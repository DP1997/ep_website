---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import img1 from '../../assets/projektstudien/stoerche-froesche/1.png';
import img2 from '../../assets/projektstudien/stoerche-froesche/2.png';
import img3 from '../../assets/projektstudien/stoerche-froesche/3.png';
import img4 from '../../assets/projektstudien/stoerche-froesche/4.png';
import img5 from '../../assets/projektstudien/stoerche-froesche/5.png';
import img6 from '../../assets/projektstudien/stoerche-froesche/6.png';
import img7 from '../../assets/projektstudien/stoerche-froesche/7.png';
import img8 from '../../assets/projektstudien/stoerche-froesche/8.png';
const varianten = [{ id: 'breit', label: 'BREIT - aktuelle Anordnung (Portraetband + Bildzeilen)', cls: '' }, { id: 'schmal', label: 'SCHMAL - mit diesem Material nicht rasterfaehig: das Portraetband plus das Grossbild erzwingen die Breite (5 Hochformate nebeneinander)', cls: 'ps-vs-sto' }];
---
<BaseLayout>
  {varianten.map((v) => (
    <section class={`ps-vorschau ${v.cls}`}>
      <p class="ps-vorschau-label">{v.label}</p>
      <article class="ps-detail ps-detail--stoerche">
    <div class="ps-stoerche">
      <div class="ps-stoerche-side">
        <div class="ps-text">
          <h1 class="ps-title">Störche &amp; Frösche</h1>
          <div class="ps-meta-block">
            <p class="ps-desc">Tierfigurinen aus Stahlblech, gewölbt, emailliert</p>
            <div class="ps-labels">
              <div class="ps-label">
                <span class="ps-label__key">Ort</span>
                <span class="ps-label__value">Offenbach an der Queich</span>
              </div>
              <div class="ps-label">
                <span class="ps-label__key">Jahr</span>
                <span class="ps-label__value">2003/2025</span>
              </div>
              <div class="ps-label">
                <span class="ps-label__key">Auftraggeber</span>
                <span class="ps-label__value">Verbandsgemeinde Offenbach</span>
              </div>
            </div>
          </div>
        </div>
        <div class="ps-stoerche-text">
          <p>Die Verbandsgemeine Offenbach wünschte sich die Darstellung ihrer Maskottchen „Störche &amp; Frösche" auf den Rankbögen der Ortseingänge. Ausgeführt sind die Figurinen mit emaillierten und gewölbten Stahlblechen, dauerhaft witterungsfest und in lichtechter&nbsp;Farbigkeit.</p>
        </div>
      </div>
      <!-- Referenzcollage: fuenf Hochformatbilder oben rechts -->
      <div class="ps-stoerche-row">
        <Image src={img2} alt="Störche & Frösche – Rankbogen mit Straße" widths={[400]} sizes="13vw" />
        <Image src={img4} alt="Störche & Frösche – Storchengasse" widths={[400]} sizes="13vw" />
        <Image src={img3} alt="Störche & Frösche – Storch auf Stange" widths={[400]} sizes="13vw" />
        <Image src={img1} alt="Störche & Frösche – Rankbogen" widths={[400]} sizes="13vw" />
        <Image src={img5} alt="Störche & Frösche – Detail" widths={[400]} sizes="13vw" />
      </div>
      <figure class="ps-stoerche-fig6">
        <Image src={img6} alt="Störche & Frösche – Rankbogen am Ortseingang" widths={[700]} sizes="34vw" />
      </figure>
      <figure class="ps-stoerche-fig7">
        <Image src={img7} alt="Störche & Frösche – Figurinen in der Werkstatt" widths={[900]} sizes="66vw" />
      </figure>
      <figure class="ps-stoerche-fig8">
        <Image src={img8} alt="Störche & Frösche – Frösche, Detail" widths={[200]} sizes="13vw" />
      </figure>
    </div>
  </article>
    </section>
  ))}
</BaseLayout>