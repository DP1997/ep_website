---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjektstudienNav from '../../components/ProjektstudienNav.astro';
import { Image } from 'astro:assets';
import img1 from '../../assets/projektstudien/balla-balla/1.png';
import img2 from '../../assets/projektstudien/balla-balla/2.png';
---
<BaseLayout>
  <article class="ps-detail ps-detail--balla">
    <div class="ps-balla">
      <figure class="ps-balla-figure">
        <Image src={img1} alt="Balla Balla – Standort 1, Sportlereingang" widths={[1200]} sizes="100vw" />
        <figcaption>Standort 1: Sportlereingang</figcaption>
      </figure>
      <div class="ps-balla-text-main">
        <p>„Balla-Balla" ist das Motto der künstlerischen Gestaltung für die neu renovierte Sporthalle. Das komplette Foyer ist mit Bällen unterschiedlicher Größe und Farben an Decke, Wand und Boden überzogen, auch die Glasfront wird in die Gestaltung miteinbezogen. Sie soll mit bunten Folien kaschiert werden und damit ein weithin sichtbares Zeichen nach Außen setzen. Sie will einladen in das fröhlich bunte Sport- und Spielgeschehen einzutauchen.</p>
        <p>Die Gestaltung soll Spaß machen und diesen auch vermitteln. Sie spricht besonders Kinder und Jugendliche an wegen des spielerisch, lustigen Motivs und ihrer bunten Farbigkeit. Aber auch die erwachsenen Sportler werden durch das Ballmotiv direkt auf das bevorstehende Spiel eingestimmt.</p>
        <p>Das Ballmotiv ist einfach zu verstehen, es wird mit Spiel und Spaß assoziiert. Jedes Kind spielt gerne Ball. Es macht schon als Kleinkind frühe körperliche Erfahrung mit dem Ballspiel, erlebt sich selbst und trainiert seine Geschicklichkeit. „Am Ball bleiben", „den Ball zuspielen", steht für Fairplay, Teamgeist, aber auch für Konzentration und Leistung.</p>
      </div>
      <div class="ps-balla-side">
        <header class="ps-balla-header">
          <div class="ps-text">
            <h1 class="ps-title">Balla Balla</h1>
            <div class="ps-meta-block">
              <p class="ps-desc">Wandgestaltung mit Malerei, Glasfolierung und plastischen Emailelementen, ca. 14 m x 2,70 m und 6,50 m x 3,50 m</p>
              <div class="ps-labels">
                <div class="ps-label">
                  <span class="ps-label__key">Ort</span>
                  <span class="ps-label__value">Verbandsgemeindesporthalle Bad Bergzabern</span>
                </div>
                <div class="ps-label">
                  <span class="ps-label__key">Jahr</span>
                  <span class="ps-label__value">2020</span>
                </div>
                <div class="ps-label">
                  <span class="ps-label__key">Auftraggeber</span>
                  <span class="ps-label__value">Verbandsgemeinde Bad Bergzabern</span>
                </div>
              </div>
            </div>
          </div>
        </header>
      </div>
      <div class="ps-balla-text-side">
        <p>Das Foyer des Sportlereingangs vermittelt durch die Rundumgestaltung (Decke – Wand – Boden – Glasfläche) ein sinnliches Erlebnis. Die bunte Farbigkeit und Dynamik der Ballformationen stimmt auf ein fröhliches Spiel und die kommende sportliche Betätigung ein.</p>
      </div>
      <figure class="ps-balla-figure2">
        <Image src={img2} alt="Balla Balla – Standort 2, Besuchereingang" widths={[900]} sizes="60vw" />
        <figcaption>Standort 2: Besuchereingang</figcaption>
      </figure>
    </div>
    <ProjektstudienNav slug="balla-balla" />
  </article>

  <script>
    // TEMPORAER: Rasterlinien + Rahmen zur Sichtpruefung.
    const drawBallaGrid = () => {
      return;
      document.querySelectorAll('.ps-grid-overlay').forEach((e) => e.remove());
      const q = (s) => document.querySelector(s);
      const sheet = q('.ps-balla');
      if (!sheet) return;
      const sb = sheet.getBoundingClientRect();
      const R = (s) => { const e = q(s); if (!e) return null; const b = e.getBoundingClientRect(); return { l: b.left - sb.left, r: b.right - sb.left, t: b.top - sb.top, b: b.bottom - sb.top }; };
      const band = R('.ps-balla-figure');
      const meta = R('.ps-balla-side');
      const main = R('.ps-balla-text-main');
      const side = R('.ps-balla-text-side');
      const fig2 = R('.ps-balla-figure2');
      if (!band || !meta || !main || !side || !fig2) return;
      const row1B = band.b;
      const row2T = Math.min(meta.t, main.t);
      const row2B = Math.max(meta.b, main.b);
      const row3T = Math.min(side.t, fig2.t);
      const row3B = Math.max(side.b, fig2.b);
      const y1 = (row1B + row2T) / 2;
      const y2 = (row2B + row3T) / 2;
      const x = (meta.r + main.l) / 2;
      const boxL = Math.min(meta.l, band.l, main.l);
      const boxT = Math.min(band.t, meta.t, main.t);
      const boxR = Math.max(main.r, band.r, fig2.r);
      const boxB = Math.max(side.b, fig2.b);
      const red = '#d40000';
      const add = (css) => { const d = document.createElement('div'); d.className = 'ps-grid-overlay'; Object.assign(d.style, css); sheet.appendChild(d); };
      const frame = (l, t, r, b) => add({ position: 'absolute', left: l + 'px', top: t + 'px', width: (r - l) + 'px', height: (b - t) + 'px', border: '2px solid ' + red, boxSizing: 'border-box', zIndex: '5000', pointerEvents: 'none' });
      // Nur die einzelnen Zellen umranden, keine Verbindungslinien.
      frame(boxL, boxT, boxR, row1B);       // R1: Bildband inkl. Unterschrift (spannt beide Spalten)
      frame(meta.l, row2T, meta.r, row2B);  // R2C1: Meta
      frame(main.l, row2T, main.r, row2B);  // R2C2: Inhaltstext
      frame(meta.l, row3T, meta.r, row3B);  // R3C1: Smalltext
      frame(main.l, row3T, main.r, row3B);  // R3C2: Bild 2
    };
    const scheduleGrid = () => requestAnimationFrame(() => requestAnimationFrame(drawBallaGrid));
    window.addEventListener('resize', scheduleGrid);
    window.addEventListener('load', scheduleGrid);
    document.fonts?.ready.then(scheduleGrid);
    scheduleGrid();
  </script>
</BaseLayout>