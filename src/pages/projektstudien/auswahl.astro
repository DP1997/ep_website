---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pages = [
  { slug: 'bubbles', name: 'Bubbles', note: 'breites Raster umgesetzt (1125 x 850), innen 95 %, Kanten 4/4' },
  { slug: 'balla-balla', name: 'Balla Balla', note: 'breites Raster B1 umgesetzt (1130 x 850)' },
  { slug: 'sportler-in-bewegung', name: 'Sportler in Bewegung', note: 'noch Bestand' },
  { slug: 'dschungel', name: 'Dschungel', note: 'schmales Raster umgesetzt (832 x 850), innen 93 %, Kanten 4/4' },
  { slug: 'stoerche-froesche', name: 'Störche & Frösche', note: 'noch Bestand' },
  { slug: 'entwicklung', name: 'Entwicklung', note: 'noch Bestand' },
  { slug: 'skydance', name: 'Skydance', note: 'noch Bestand' },
  { slug: 'stadttor', name: 'Stadttor', note: 'noch Bestand' },
];
---

<BaseLayout>
  <article class="ps-choice">
    <h1 class="ps-choice-title">Projektstudien – Auswahl schmal / breit</h1>
    <p class="ps-choice-intro">
      Für jede Projektstudie die gewünschte Variante wählen. Die Wahl wird lokal im Browser
      gespeichert und unten als JSON ausgegeben (zum Kopieren).
    </p>
    <div class="ps-choice-list" id="list">
      {pages.map((p) => (
        <div class="ps-choice-row" data-slug={p.slug}>
          <div class="ps-choice-name">{p.name}</div>
          <div class="ps-choice-note">{p.note}</div>
          <div class="ps-choice-radios">
            <label><input type="radio" name={p.slug} value="schmal" /> schmal</label>
            <label><input type="radio" name={p.slug} value="breit" /> breit</label>
          </div>
          <a class="ps-choice-link" href={`/ep_website/projektstudien/${p.slug}/`}>Seite</a>
        </div>
      ))}
    </div>
    <h2 class="ps-choice-sub">Ergebnis</h2>
    <pre class="ps-choice-out" id="out">{}</pre>
    <p class="ps-choice-actions">
      <button type="button" id="copy">JSON kopieren</button>
      <button type="button" id="reset">Zurücksetzen</button>
    </p>
  </article>
</BaseLayout>

<style>
  .ps-choice { max-width: 56rem; margin: 2rem auto; padding: 0 1.5rem; }
  .ps-choice-title { font-family: var(--font-sans-serif); font-size: 1.6rem; font-weight: 700; margin: 0 0 0.6rem; }
  .ps-choice-intro { font-family: var(--font-sans-serif); font-size: 0.95rem; line-height: 1.5; margin: 0 0 1.5rem; }
  .ps-choice-list { display: flex; flex-direction: column; border-top: 1px solid rgba(0,0,0,.12); }
  .ps-choice-row {
    display: grid; grid-template-columns: 1fr auto auto; gap: 1rem; align-items: center;
    padding: 0.9rem 0; border-bottom: 1px solid rgba(0,0,0,.12);
    font-family: var(--font-sans-serif);
  }
  .ps-choice-name { font-weight: 700; font-size: 1rem; }
  .ps-choice-note { grid-column: 1; font-size: 0.8rem; opacity: 0.65; }
  .ps-choice-radios { display: flex; gap: 1rem; font-size: 0.9rem; }
  .ps-choice-radios label { display: flex; gap: 0.35rem; align-items: center; cursor: pointer; }
  .ps-choice-link { font-size: 0.85rem; color: var(--color-primary); }
  .ps-choice-sub { font-family: var(--font-sans-serif); font-size: 1rem; font-weight: 700; margin: 1.6rem 0 0.5rem; }
  .ps-choice-out {
    font-family: ui-monospace, Menlo, monospace; font-size: 0.85rem; line-height: 1.5;
    background: rgba(0,0,0,.05); padding: 0.9rem 1rem; border-radius: 6px; margin: 0;
    white-space: pre-wrap; min-height: 3rem;
  }
  .ps-choice-actions { display: flex; gap: 0.6rem; margin: 0.8rem 0 2rem; }
  .ps-choice-actions button {
    font-family: var(--font-sans-serif); font-size: 0.85rem; padding: 0.45rem 0.9rem;
    border: 1px solid rgba(0,0,0,.25); background: transparent; border-radius: 4px; cursor: pointer;
  }
</style>

<script>
  const KEY = 'ps-auswahl';
  const list = document.getElementById('list');
  const out = document.getElementById('out');
  const render = () => {
    const state = JSON.parse(localStorage.getItem(KEY) || '{}');
    out.textContent = JSON.stringify(state, null, 2);
    for (const row of list.querySelectorAll('.ps-choice-row')) {
      const slug = row.dataset.slug;
      const val = state[slug];
      for (const r of row.querySelectorAll('input[type=radio]')) r.checked = r.value === val;
    }
  };
  list.addEventListener('change', (e) => {
    const el = e.target;
    if (el.type !== 'radio') return;
    const slug = el.closest('.ps-choice-row').dataset.slug;
    const state = JSON.parse(localStorage.getItem(KEY) || '{}');
    state[slug] = el.value;
    localStorage.setItem(KEY, JSON.stringify(state));
    render();
  });
  document.getElementById('copy').addEventListener('click', () => {
    navigator.clipboard.writeText(out.textContent || '');
  });
  document.getElementById('reset').addEventListener('click', () => {
    localStorage.removeItem(KEY);
    render();
  });
  render();
</script>
