---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Alle Werke laden, um kuratierte Auswahl dynamisch zu verknüpfen.
const allWorks = await getCollection('works');

// Alle Bilder eager importieren, um Hero-/Kartenbilder aufzulösen.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,JPG}',
  { eager: true }
);

// Basis-Pfad für interne Links (GitHub Pages: /ep_website/).
const BASE_URL = import.meta.env.BASE_URL;

// Bild zu einem Werk auflösen (direkter Datei-Match oder Verzeichnis/1.jpg).
function getHeroImage(dir: string) {
  let key = Object.keys(allImages).find((k) => k.endsWith(`/${dir}`));
  if (key) return allImages[key].default;
  key = Object.keys(allImages).find((k) => k.includes(`/${dir}/1.jpg`));
  return key ? allImages[key].default : null;
}

// Hero: alle Kunst-am-Bau-Projekte (Profan + Sakral).
const heroWorks = allWorks
  .filter((w) => w.data.tags.kategorie.includes('Kunst am Bau'))
  .map((w) => ({
    title: w.data.title,
    date: w.data.date,
    href: `${BASE_URL}${w.id.split('/')[0]}/${w.id.split('/').pop()}`,
    img: getHeroImage(w.data.image_dir),
  }))
  .filter((w) => w.img);

// Arbeitsprozess-Fotos numerisch sortiert (1..24).
const processImages = Object.keys(allImages)
  .filter((k) => k.includes('/arbeitsprozesse/'))
  .map((k) => ({ num: parseInt(k.match(/(\d+)\.(jpg|jpeg|png|JPG)$/)?.[1] ?? '0', 10), img: allImages[k].default }))
  .sort((a, b) => a.num - b.num);

// Freie Werke nach Material gruppieren (Glas oben, Malerei unten).
const freieWerke = allWorks.filter((w) => w.data.tags.kategorie.includes('Freies Werk'));

const glasWerke = freieWerke
  .filter((w) => w.data.tags.material.includes('Glas'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const malereiWerke = freieWerke
  .filter((w) => w.data.tags.material.includes('Malerei'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

function toCard(w: (typeof allWorks)[number]) {
  return {
    title: w.data.title,
    short: w.data.short,
    date: w.data.date,
    href: `${BASE_URL}${w.id.split('/')[0]}/${w.id.split('/').pop()}`,
    img: getHeroImage(w.data.image_dir),
  };
}

const glasCards = glasWerke.map(toCard).filter((w) => w.img);
const malereiCards = malereiWerke.map(toCard).filter((w) => w.img);

// Neueste Ausstellungen als „Aktuell"-Teaser (aus der Bio abgeleitet).
const aktuell = [
  { year: '2026', text: '„Auftakt". Arbeitsgemeinschaft Pfälzer Künstler. Villa Streccius, Landau' },
  { year: '2026', text: '„Wasserzeichen". Kunstgilde Bad Bergzabern, Stefan Kindel und Elke Pfaffmann' },
];
---

<BaseLayout>
  <!-- Hero: sanfter Crossfade von Kunst-am-Bau-Projekten -->
  <section class="hero" aria-label="Kunst am Bau">
    <div class="hero__slides">
      {heroWorks.map((w, i) => (
        <a
          href={w.href}
          class="hero__slide"
          class:list={[{ 'is-active': i === 0 }]}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <Image src={w.img} alt={w.title} widths={[640, 960, 1920]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} />
          <span class="hero__caption">
            <span class="hero__caption-kicker">Kunst am Bau</span>
            <span class="hero__caption-title">{w.title}</span>
            <span class="hero__caption-year">{w.date}</span>
          </span>
        </a>
      ))}
    </div>
    <button class="hero__nav hero__nav--prev" aria-label="Vorheriges Werk">
      <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="hero__nav hero__nav--next" aria-label="Nächstes Werk">
      <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="hero__dots" role="tablist" aria-label="Werke auswählen">
      {heroWorks.map((w, i) => (
        <button
          class="hero__dot"
          class:list={[{ 'is-active': i === 0 }]}
          aria-label={`Werk ${i + 1}: ${w.title}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          role="tab"
        ></button>
      ))}
    </div>
  </section>

  <!-- Intro + Link zur Biographie -->
  <section class="intro" data-reveal>
    <p class="intro__text">
      Elke Pfaffmann arbeitet seit 1991 als Künstlerin mit Schwerpunkt Kunst am Bau.
      Ihre Arbeiten aus Glas, Email und Malerei verbinden Licht, Farbe und Architektur
      zu Räumen, die berühren.
    </p>
    <a class="intro__link" href={`${BASE_URL}bio`}>Zur Biographie</a>
  </section>

  <!-- Arbeitsprozess: Perlenkette, endlos von links nach rechts -->
  <section class="process" data-reveal>
    <h2 class="section-title">Arbeitsprozess</h2>
    <div class="process__viewport" aria-label="Einblicke in den Arbeitsprozess">
      <div class="process__track">
        {processImages.map((p) => (
          <figure class="process__item">
            <Image src={p.img} alt={`Arbeitsprozess ${p.num}`} widths={[600]} sizes="320px" loading="lazy" />
          </figure>
        ))}
        {processImages.map((p) => (
          <figure class="process__item" aria-hidden="true">
            <Image src={p.img} alt="" widths={[600]} sizes="320px" loading="lazy" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Freie Werke: 2x3-Matrix (oben Glas, unten Malerei) -->
  <section class="freie" data-reveal>
    <h2 class="section-title">Freie Werke</h2>
    <div class="freie__row">
      <h3 class="freie__label">Glas</h3>
      <div class="freie__grid">
        {glasCards.map((w) => (
          <a href={w.href} class="freie__card">
            <div class="freie__image">
              <Image src={w.img} alt={w.title} widths={[600]} sizes="(max-width: 740px) 100vw, 33vw" loading="lazy" />
            </div>
            <div class="freie__meta">
              <span class="freie__year">{w.date}</span>
              <span class="freie__title">{w.title}</span>
              {w.short && <span class="freie__short">{w.short}</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="freie__row">
      <h3 class="freie__label">Malerei</h3>
      <div class="freie__grid">
        {malereiCards.map((w) => (
          <a href={w.href} class="freie__card">
            <div class="freie__image">
              <Image src={w.img} alt={w.title} widths={[600]} sizes="(max-width: 740px) 100vw, 33vw" loading="lazy" />
            </div>
            <div class="freie__meta">
              <span class="freie__year">{w.date}</span>
              <span class="freie__title">{w.title}</span>
              {w.short && <span class="freie__short">{w.short}</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
    <a class="freie__more" href={`${BASE_URL}work`}>Alle Werke ansehen</a>
  </section>

  <!-- Aktuell -->
  <section class="aktuell" data-reveal>
    <h2 class="section-title">Aktuell</h2>
    <ul class="aktuell__list">
      {aktuell.map((a) => (
        <li class="aktuell__item">
          <span class="aktuell__badge">{a.year}</span>
          <span class="aktuell__text">{a.text}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  // Hero-Crossfade mit manueller Steuerung (Pfeile, Punkte) und Pause-on-Hover.
  // Bei prefers-reduced-motion: kein Auto-Wechsel, manuelles Blättern bleibt möglich.
  function setupHero() {
    const hero = document.querySelector('.hero');
    if (!hero) return;
    const slides = Array.from(hero.querySelectorAll('.hero__slide'));
    const dots = Array.from(hero.querySelectorAll('.hero__dot'));
    const prev = hero.querySelector('.hero__nav--prev');
    const next = hero.querySelector('.hero__nav--next');
    if (slides.length < 2) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const interval = 6000;
    let current = 0;
    let timer = null;

    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === current;
        s.classList.toggle('is-active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((d, i) => {
        const active = i === current;
        d.classList.toggle('is-active', active);
        d.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    function start() {
      if (reduced) return;
      stop();
      timer = setInterval(() => show(current + 1), interval);
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
    }

    prev.addEventListener('click', () => { show(current - 1); start(); });
    next.addEventListener('click', () => { show(current + 1); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));

    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', start);

    start();
  }

  setupHero();
  document.addEventListener('astro:page-load', setupHero);

  // Scroll-Reveal: blendet Sektions-Blöcke sanft ein.
  // Respektiert prefers-reduced-motion — dann bleibt alles sofort sichtbar.
  function setupReveal() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const targets = Array.from(document.querySelectorAll('[data-reveal]'));
    if (targets.length === 0) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    targets.forEach((t) => io.observe(t));
  }

  setupReveal();
  document.addEventListener('astro:page-load', setupReveal);
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-top: var(--margin);
    height: 78vh;
    min-height: 420px;
    overflow: hidden;
    background: var(--color-base);
  }

  .hero__slides {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 1.6s ease;
    pointer-events: none;
  }

  .hero__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero__slides::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent 40%);
    pointer-events: none;
  }

  .hero__caption {
    position: absolute;
    left: 2rem;
    bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: #fff;
    z-index: 1;
  }

  .hero__caption-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: 0.02em;
    line-height: 1.15;
  }

  .hero__caption-kicker {
    font-family: var(--font-sans-serif);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    opacity: 0.8;
    margin-bottom: 0.2rem;
  }

  .hero__caption-year {
    font-family: var(--font-sans-serif);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    opacity: 0.85;
  }

  .hero__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none !important;
    color: rgba(255, 255, 255, 0.4) !important;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .hero__nav svg {
    width: 3rem;
    height: 3rem;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.4));
  }

  .hero__nav:hover {
    color: #fff !important;
    transform: translateY(-50%) scale(1.15);
  }

  .hero__nav--prev {
    left: 1.5rem;
  }

  .hero__nav--next {
    right: 1.5rem;
  }

  .hero__dots {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    gap: 0.5rem;
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    box-shadow: none !important;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease, width 0.3s ease;
  }

  .hero__dot:hover {
    background: rgba(255, 255, 255, 0.8);
  }

  .hero__dot.is-active {
    background: #fff;
    width: 22px;
    border-radius: 4px;
    transform: none;
  }

  /* Intro */
  .intro {
    max-width: 720px;
    margin: 0 auto;
    padding: calc(var(--margin) * 2) var(--margin);
    text-align: center;
  }

  .intro__text {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    line-height: 1.6;
    color: var(--color-base);
    margin: 0 0 1.5rem;
  }

  .intro__link {
    display: inline-block;
    font-family: var(--font-sans-serif);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: var(--color-base);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.6rem 1.5rem;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .intro__link:hover {
    background: var(--color-base);
    color: var(--color-bg);
    border-color: var(--color-base);
  }

  /* Section title */
  .section-title {
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: 1.6rem;
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin: 0 0 2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Arbeitsprozess: endlose Perlenkette */
  .process {
    max-width: var(--large);
    margin: 0 auto;
    padding: 0 var(--margin) calc(var(--margin) * 2);
  }

  .process__viewport {
    overflow: hidden;
    border-radius: var(--radius);
  }

  .process__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: process-scroll 60s linear infinite;
  }

  .process__viewport:hover .process__track {
    animation-play-state: paused;
  }

  @keyframes process-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .process__item {
    flex: 0 0 auto;
    width: 320px;
    margin: 0;
    line-height: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .process__item :global(img) {
    width: 100%;
    height: 240px;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .process__track {
      animation: none;
    }
  }

  /* Freie Werke: 2x3-Matrix */
  .freie {
    max-width: var(--large);
    margin: 0 auto;
    padding: 0 var(--margin) calc(var(--margin) * 2);
  }

  .freie__row {
    margin-bottom: 2.5rem;
  }

  .freie__label {
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: 1.4rem;
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
    color: var(--color-base);
    opacity: 0.5;
    margin: 0 0 1rem;
  }

  .freie__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .freie__card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .freie__card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    transform: translateY(-4px);
  }

  .freie__image {
    line-height: 0;
    overflow: hidden;
    height: 240px;
  }
  .freie__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
    transition: transform 0.5s ease;
  }

  .freie__card:hover .freie__image :global(img) {
    transform: scale(1.03);
  }

  .freie__meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.5rem;
  }

  .freie__year {
    font-family: var(--font-sans-serif);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
  }

  .freie__title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-base);
  }

  .freie__short {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-base);
    opacity: 0.7;
  }

  .freie__more {
    display: block;
    width: fit-content;
    margin: 0.5rem auto 0;
    font-family: var(--font-sans-serif);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: var(--color-base);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.6rem 1.5rem;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .freie__more:hover {
    background: var(--color-base);
    color: var(--color-bg);
    border-color: var(--color-base);
  }

  /* Aktuell */
  .aktuell {
    max-width: var(--large);
    margin: 0 auto;
    padding: 0 var(--margin) calc(var(--margin) * 2);
  }

  .aktuell__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .aktuell__item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.1rem 0;
  }

  .aktuell__badge {
    flex: 0 0 auto;
    font-family: var(--font-sans-serif);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-bg);
    background: var(--color-primary);
    border-radius: var(--radius);
    padding: 0.35rem 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .aktuell__text {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-base);
  }

  /* Scroll-Reveal: sanftes Einblenden der Sektionen */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Responsive */
  @media (max-width: 740px) {
    .hero {
      height: 60vh;
      min-height: 320px;
    }

    .hero__nav {
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.3rem;
    }

    .hero__nav--prev {
      left: 0.75rem;
    }

    .hero__nav--next {
      right: 0.75rem;
    }

    .hero__caption {
      left: 1rem;
      bottom: 3.5rem;
    }

    .hero__dots {
      bottom: 1rem;
    }

    .freie__grid {
      grid-template-columns: 1fr;
    }

    .process__item {
      width: 70vw;
    }

    .aktuell__item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>
