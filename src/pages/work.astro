    border-color: var(--color-primary) !important;
    box-shadow: none !important;
  }

  /* Tag-hidden cards */
  .bio-art-card.tag-hidden {
    display: none;
  }

  /* Category sections hidden when no matching cards */
  .category-section.category-hidden {
    display: none;
  }

  .bio-art-card.is-hidden {
    display: none;
  }



  /* .bio-art-card layout is defined globally in bio.css; do not override here */
  a.bio-art-card {
    text-decoration: none;
