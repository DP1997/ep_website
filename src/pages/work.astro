---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { compareWorks } from '../lib/sort';

const allWorks = await getCollection('works');

const BASE_URL = import.meta.env.BASE_URL;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,png}',
  { eager: true }
);

function getHeroImage(dir: string) {
  // Try direct file match first (e.g. 'freie_werke/bubbles-ii.jpg')
  let key = Object.keys(allImages).find(k => k.endsWith(`/${dir}`));
  if (key) return allImages[key].default;
  // Fall back to directory with 1.jpg (e.g. 'atem' -> 'atem/1.jpg')
  key = Object.keys(allImages).find(k => k.includes(`/${dir}/1.jpg`));
  return key ? allImages[key].default : null;
}

function getCatalogCover(id: string) {
  const key = Object.keys(allImages).find(k => k.includes(`/kataloge/${id}_cover.`));
  return key ? allImages[key].default : null;
}

// Schlüsselbegriffe: absteigend nach Relevanz sortieren, wobei Relevanz die
// Anzahl der Kunst-am-Bau-Projekte ist, die diesen Begriff teilen. Der Begriff
// mit den meisten Kunst-am-Bau-Treffern steht zuerst. Bei Gleichstand bleibt
// die Eingabereihenfolge (alphabetisch) erhalten — sort ist stabil.
const kabWorks = allWorks.filter(w => w.data.tags.kategorie.includes('Kunst am Bau'));

function sortByRelevanceDesc(tags: string[], key: string): string[] {
  const count = (tag: string) => kabWorks.filter(w => (w.data.tags as any)[key]?.includes(tag)).length;
  return tags.slice().sort((a, b) => count(b) - count(a));
}

const kategorieTags = sortByRelevanceDesc([...new Set(allWorks.flatMap(w => w.data.tags.kategorie).filter(Boolean))], 'kategorie');
const kontextTags = sortByRelevanceDesc([...new Set(allWorks.flatMap(w => w.data.tags.kontext).filter(Boolean))], 'kontext');
const gebaeudetypTags = sortByRelevanceDesc([...new Set(allWorks.flatMap(w => w.data.tags.gebaeudetyp).filter(Boolean))], 'gebaeudetyp');
const materialTags = sortByRelevanceDesc([...new Set(allWorks.flatMap(w => w.data.tags.material).filter(Boolean))], 'material');

// Trefferzahlen pro Schlüsselbegriff (Anzahl Werke, die den Begriff tragen).
// Wird am Chip als dezentes Label angezeigt (State of the Art bei Facet-Filtern).
function tagCount(tag: string, key: string): number {
  return allWorks.filter(w => (w.data.tags as any)[key]?.includes(tag)).length;
}
const materialCounts = Object.fromEntries(materialTags.map(t => [t, tagCount(t, 'material')]));
const kategorieCounts = Object.fromEntries(kategorieTags.map(t => [t, tagCount(t, 'kategorie')]));
const kontextCounts = Object.fromEntries(kontextTags.map(t => [t, tagCount(t, 'kontext')]));
const gebaeudetypCounts = Object.fromEntries(gebaeudetypTags.map(t => [t, tagCount(t, 'gebaeudetyp')]));
const tagCounts: Record<string, Record<string, number>> = {
  kategorie: kategorieCounts,
  kontext: kontextCounts,
  gebaeudetyp: gebaeudetypCounts,
  material: materialCounts,
};

// Tag groups for display
// single: XOR-Auswahl innerhalb der Gruppe — ein Werk ist nie gleichzeitig
// z. B. Schule und Kapelle, Sakral und Profan oder Kunst am Bau und frei.
// Material erlaubt Mehrfachwerte (Email + Stahl) und bleibt Multi-Select.
const tagGroups = [
  { label: 'Kategorie', key: 'kategorie', tags: kategorieTags, single: true },
  { label: 'Kontext', key: 'kontext', tags: kontextTags, single: true },
  { label: 'Gebäudetyp', key: 'gebaeudetyp', tags: gebaeudetypTags, single: true },
  { label: 'Material', key: 'material', tags: materialTags, single: false },
];

// Primary categories
const categories = [
  {
    id: 'kunst_am_bau',
    title: 'Kunst am Bau',
    isGroup: true,
    subsections: [
      { id: 'profan',  title: 'Profan',  tag: 'Profan' },
      { id: 'sakral',  title: 'Sakral',  tag: 'Sakral' },
    ],
  },
  {
    id: 'glas',
    title: 'Glas',
    isGroup: false,
    catalog: {
      title: 'Katalog Fusingglas',
      href: `${BASE_URL}katalog/glas`,
    },
    filter: (w: typeof allWorks[number]) =>
      w.data.tags.kategorie.includes('Freies Werk') && w.data.tags.material.includes('Glas'),
  },
  {
    id: 'malerei',
    title: 'Malerei',
    isGroup: false,
    catalog: {
      title: 'Katalog Malerei',
      href: `${BASE_URL}katalog/malerei`,
    },
    filter: (w: typeof allWorks[number]) =>
      w.data.tags.kategorie.includes('Freies Werk') && w.data.tags.material.includes('Malerei'),
  },
];

// Sort key: erste Jahreszahl; Werke ohne Datum (z. B. "t.b.d.") bekommen 0 und landen hinten.

// Build works per category
function getWorksForCategory(cat: typeof categories[number]) {
  if ('filter' in cat && cat.filter) {
    return allWorks.filter(cat.filter).sort(compareWorks);
  }
  if ('subsections' in cat && cat.subsections) {
    return []; // group categories don't have works directly
  }
  return [];
}

// Katalog-Karte als Filtertreffer: kombiniert Kategorie + Material-Tags,
// damit sie im gefilterten Ergebnis erscheint (z. B. „Freies Werk" + „Glas"
// zeigt den Glaskatalog zuerst an).
function catalogTags(cat: typeof categories[number]): string {
  if ('filter' in cat && cat.filter && cat.id === 'glas') return 'Freies Werk,Glas';
  if ('filter' in cat && cat.filter && cat.id === 'malerei') return 'Freies Werk,Malerei';
  return '';
}

const worksByCategory = Object.fromEntries(
  categories.map(cat => [cat.id, getWorksForCategory(cat)])
);

// Flat, date-sorted list of all works for the filtered result view
const allWorksSorted = [...allWorks].sort(compareWorks);
---

<BaseLayout>
  <div class="bio-section work-layout">
    <!-- Anker: vertikaler Papier-Tab, immer sichtbar, mittig am linken Rand.
         Linke Kante klebt an der Fuge --seam (== Drawer-Rechenkante). -->
      <button class="filter-anchor" id="filter-anchor" type="button" aria-expanded="false" aria-controls="filter-drawer">
        <span class="filter-anchor-ripple" aria-hidden="true">
          <span class="filter-anchor-ripple-wave"></span>
        </span>
        <span class="filter-anchor-label">
          <span class="filter-anchor-label-text">Filter</span>
        </span>
      </button>

    <!-- Scrim: deckt den Viewport ab, Klick schließt den Drawer.
         (Desktop nicht sichtbar — dort Layout-Push statt Overlay.) -->
    <div class="filter-scrim" id="filter-scrim" hidden></div>

    <!-- Drawer: Papier-Drawer von links. Eine einzige Quelle für die Chips —
         kein Duplikat, keine Sync-Probleme, Filter-Logik identisch.
         Rechte Kante klebt an derselben Fuge --seam wie der Anker. -->
    <dialog class="filter-drawer" id="filter-drawer">
      <div class="filter-drawer-header">
        <span class="filter-drawer-title">Filteroptionen</span>
        <button class="filter-drawer-close" id="filter-drawer-close" type="button" aria-label="Filter schließen">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="filter-drawer-body">
        <div class="filter-drawer-groups">
        {tagGroups.map(group => (
          <div class="tag-group">
            <span class="tag-group-label">
              {group.label}
            </span>
            <div class="tag-group-chips" data-single-select={group.single ? 'true' : 'false'}>
              {group.tags.map(tag => (
                <button class="tag-chip" data-tag-key={group.key} data-tag={tag} title={tag} aria-label={tag} aria-pressed="false">
                  <span class="tag-chip-text">{tag}</span>
                  <span class="tag-chip-count">({tagCounts[group.key]?.[tag] ?? 0})</span>
                </button>
              ))}
            </div>
          </div>
        ))}
        </div>
      </div>
    </dialog>
    <!-- Screenreader-/Status-Meldung für Filter-Hinweise (visuell verborgen,
         aber für assistive Technologien lesbar). -->
    <p id="filter-status" class="visually-hidden" aria-live="polite"></p>
    <!-- Sichtbarer Hinweis-Toast: erscheint kurz, wenn eine gesperrte
         Kombination (0 Treffer) angeklickt wird. -->
    <div id="filter-toast" class="filter-toast" role="status" aria-live="polite" hidden>
        <svg class="filter-toast-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <span id="filter-toast-text"></span>
      </div>

    <div class="work-content">
      <!-- Flat filtered results (shown only when a filter is active) -->
      <div class="filter-results" id="filter-results" hidden>
        <!-- Statuszeile: zeigt aktive Filter + Entfernen-Buttons (Vorschlag 4) -->
        <div class="filter-statusbar" id="filter-statusbar" hidden>
          <span class="filter-statusbar-label">Gefiltert nach:</span>
          <span class="filter-statusbar-chips" id="filter-statusbar-chips"></span>
        </div>
        <div class="bio-art-grid" id="filter-results-grid"></div>
      </div>

    {categories.map(cat => {
      if ('isGroup' in cat && cat.isGroup && 'subsections' in cat && cat.subsections) {
        return (
          <div class="category-section category-section--group" data-category={cat.id}>
            <h2 class="bio-section-title bio-section-title--group">{cat.title}</h2>
            {cat.subsections.map(sub => {
              const subWorks = allWorks
                .filter(w => w.data.tags.kontext.includes(sub.tag))
                .sort(compareWorks);
              const subId = cat.id + '_' + sub.id;
              return (
                <div class="category-section" data-category={subId} data-category-tag={sub.tag}>
                  <h3 class="bio-section-subtitle">{sub.title}</h3>
                  <div class="bio-art-grid" data-expand={subId}>
                    {subWorks.map((item) => {
                      const slug = item.id.split('/').pop();
                      const category = item.id.split('/')[0];
                      const heroImg = getHeroImage(item.data.image_dir);
                      const allTags = [
                        ...item.data.tags.kategorie,
                        ...item.data.tags.kontext,
                        ...item.data.tags.gebaeudetyp,
                        ...item.data.tags.material
                      ].filter(Boolean);
                      return (
                        <a href={`${BASE_URL}${category}/${slug}`} class="bio-art-card" data-tags={allTags.join(',')}>
                          {heroImg && (
                            <div class="bio-art-card-image">
                              <Image src={heroImg} alt={item.data.title} widths={[400]} sizes="280px" loading="lazy" />
                            </div>
                          )}
                          <div class="bio-art-card-year">{item.data.date}</div>
                          <div class="bio-art-card-title">{item.data.title}</div>
                          {item.data.location && <div class="bio-art-card-location">{item.data.location}</div>}
                          {item.data.short && <div class="bio-art-card-desc">{item.data.short}</div>}
                        </a>
                      );
                    })}
                  </div>
                  <button class="expand-btn" data-target={subId} aria-expanded="false">
                    <span class="expand-btn-text">Mehr anzeigen</span>
                    <svg class="expand-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </button>
                </div>
              );
            })}
          </div>
        );
      }
      
      // Regular (non-group) category
      const catalog = 'catalog' in cat ? cat.catalog : null;
      return (
        <div class="category-section" data-category={cat.id} data-category-tag={cat.id}>
          <h2 class="bio-section-title">{cat.title}</h2>
          <div class="bio-art-grid" data-expand={cat.id}>
            {catalog && (
              <a href="#" class="bio-art-card bio-art-card--catalog" data-catalog-id={cat.id} data-tags={catalogTags(cat)}>
                <span class="bio-art-card-badge">Katalog</span>
                {(() => {
                  const coverImg = getCatalogCover(cat.id);
                  return coverImg ? (
                    <div class="bio-art-card-image">
                      <Image src={coverImg} alt={catalog.title} widths={[400]} sizes="280px" loading="lazy" />
                    </div>
                  ) : null;
                })()}
                {(() => {
                  const catalogMeta = {
                    glas:    { year: '2016', title: 'Katalog Fusingglas', desc: 'Lichtblicke – Objekte aus Fusingglas' },
                    malerei: { year: '2021', title: 'Katalog Malerei',    desc: 'Spiegelbilder – Im Widerschein der Farbe' },
                  }[cat.id];
                  return catalogMeta ? (
                    <>
                      <div class="bio-art-card-year">{catalogMeta.year}</div>
                      <div class="bio-art-card-title">{catalogMeta.title}</div>
                      <div class="bio-art-card-desc">{catalogMeta.desc}</div>
                    </>
                  ) : (
                    <>
                      <div class="bio-art-card-year">Katalog</div>
                      <div class="bio-art-card-title">{catalog.title}</div>
                      <div class="bio-art-card-desc">Als Blätterkatalog durchstöbern</div>
                    </>
                  );
                })()}
              </a>
            )}
            {worksByCategory[cat.id].map((item) => {
              const slug = item.id.split('/').pop();
              const category = item.id.split('/')[0];
              const heroImg = getHeroImage(item.data.image_dir);
              const allTags = [
                ...item.data.tags.kategorie,
                ...item.data.tags.kontext,
                ...item.data.tags.gebaeudetyp,
                ...item.data.tags.material
              ].filter(Boolean);
              return (
                <a href={`${BASE_URL}${category}/${slug}`} class="bio-art-card" data-tags={allTags.join(',')}>
                  {heroImg && (
                    <div class="bio-art-card-image">
                      <Image src={heroImg} alt={item.data.title} widths={[400]} sizes="280px" loading="lazy" />
                    </div>
                  )}
                  <div class="bio-art-card-year">{item.data.date}</div>
                  <div class="bio-art-card-title">{item.data.title}</div>
                  {item.data.location && <div class="bio-art-card-location">{item.data.location}</div>}
                  {item.data.short && <div class="bio-art-card-desc">{item.data.short}</div>}
                </a>
              );
            })}
          </div>
          <button class="expand-btn" data-target={cat.id} aria-expanded="false">
            <span class="expand-btn-text">Mehr anzeigen</span>
            <svg class="expand-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>
      );
    })}
    </div>
  </div>
  
  <script is:inline>
  // Catalog card click handler — open modal instead of navigating
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-catalog-id]');
    if (!btn) return;
    var catalogId = btn.dataset.catalogId;
    if (!catalogId || !window.openCatalogModal) return;
    e.preventDefault();
    window.openCatalogModal(catalogId);
  });
</script>

</BaseLayout>

<script>
  function setupWorkPage() {
    // Doppelbindung unterbinden: Bei View-Transitions ersetzt Astro den body
    // (Guard verschwindet mit ihm), ein zweiter Aufruf desselben Documents
    // würde alle Listener doppelt binden. Das Attribut wird hier gesetzt.
    if (document.body.getAttribute('data-filter-init') === '1') return;
    document.body.setAttribute('data-filter-init', '1');
    // --- Tag Filter ---
    var chips = document.querySelectorAll('.tag-chip');
    var cards = document.querySelectorAll('.bio-art-card');
    var categorySections = document.querySelectorAll('.category-section');
    var filterAnchor = document.getElementById('filter-anchor');
    var filterDrawer = document.getElementById('filter-drawer');
    var filterDrawerClose = document.getElementById('filter-drawer-close');
    var filterScrim = document.getElementById('filter-scrim');
    var filterCount = null;
    var filterResults = document.getElementById('filter-results');
    var filterResultsGrid = document.getElementById('filter-results-grid');
    var filterStatus = document.getElementById('filter-status');
    var filterToast = document.getElementById('filter-toast');
    var filterToastTimer = null;
    var drawerFocusTimer = null;
    var closeTimer = null;
    var chipGrids = document.querySelectorAll('.tag-group-chips');
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Ripple nur beim Betreten der Werke-Übersicht (einmal pro Seitenaufruf),
    // nicht beim Klick/Drag.
    var ripplePlayed = false;
    // Zustandsquelle für den Drawer: aria-expanded wird erst nach der
    // Schließ-Animation zurückgesetzt — währenddessen muss ein Anker-Klick
    // trotzdem als „öffnen" erkannt werden.
    var drawerIsOpen = false;
    // Filter-State über View-Transitions hinweg (gleiche Tab-Session):
    // sessionStorage merkt sich aktive Chips + Drawer-Zustand. Zurück von
    // einer Detailseite/einer anderen Seite steht der Filter sofort wieder.
    var STORAGE_KEY = 'ep_filter_state';
    var restoredFilter = false;
    function saveFilterState(open) {
      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
          tags: getActiveTags(),
          drawerOpen: open !== undefined ? open : drawerIsOpen
        }));
      } catch (e) { /* private mode: kein State */ }
    }
    function loadFilterState() {
      try {
        var raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        var s = JSON.parse(raw);
        if (!s || !Array.isArray(s.tags)) return null;
        return { tags: s.tags.filter(Boolean), drawerOpen: !!s.drawerOpen };
      } catch (e) { return null; }
    }

    // Anker, Scrim und Drawer brauchen echtes Viewport-fixed. Ihr Vorfahr
    // .transition-fade (Astro View Transitions) trägt einen Transform, der
    // position:fixed relativ zu ihm macht statt zum Viewport — Anker und
    // Drawer würden mit der Seite scrollen. Deshalb an document.body heften.
    // Der Toast hat dasselbe Problem und wird gleich mit teleportiert.
    [filterAnchor, filterScrim, filterDrawer, filterToast].forEach(function(el) {
      if (el && el.parentElement && el.parentElement !== document.body) {
        document.body.appendChild(el);
      }
    });

    function showFilterToast(text) {
      if (!filterToast) return;
      var textEl = document.getElementById('filter-toast-text');
      if (textEl) textEl.textContent = text;
      else filterToast.textContent = text;
      filterToast.hidden = false;
      // Neue Einblendung startet die Verweildauer neu.
      if (filterToastTimer) clearTimeout(filterToastTimer);
      filterToastTimer = setTimeout(hideFilterToast, 2500);
    }

    // Gemeinsames Ausblenden: animiertes Herausfallen (gleiche Animation für
    // Timer-Ablauf und Karten-Hover), dann verstecken.
    function hideFilterToast() {
      if (!filterToast || filterToast.hidden) return;
      if (filterToastTimer) {
        clearTimeout(filterToastTimer);
        filterToastTimer = null;
      }
      filterToast.classList.add('filter-toast--out');
      setTimeout(function() {
        filterToast.classList.remove('filter-toast--out');
        filterToast.hidden = true;
      }, 300);
    }

    function getActiveTags() {
      // Returns flat array of all selected tag values
      var active = [];
      chips.forEach(function(chip) {
        if (chip.getAttribute('aria-pressed') === 'true') {
          active.push(chip.getAttribute('data-tag'));
        }
      });
      return active;
    }

    function applyTagFilter() {
      var activeTags = getActiveTags();
      var hasAnyFilter = activeTags.length > 0;

      if (hasAnyFilter) {
        // Flat result view: hide category sections, show a single sorted grid
        categorySections.forEach(function(section) {
          section.classList.add('category-hidden');
        });

        // Collect matching cards (exclude catalog cards without data-tags)
        var matches = [];
        cards.forEach(function(card) {
          var cardTags = (card.getAttribute('data-tags') || '').split(',');
          var ok = activeTags.every(function(tag) {
            return cardTags.indexOf(tag) !== -1;
          });
          if (ok) matches.push(card);
        });

        // Sort matches: Reihenfolge hängt von der Auswahl ab.
        // - Ist „Freies Werk" aktiv (ggf. + Glas/Malerei): Kataloge zuerst,
        //   dann Kunst am Bau, dann freie Werke.
        // - Ist nur Glas/Malerei aktiv (kein „Freies Werk"): Kunst-am-Bau-
        //   Projekte zuerst, direkt gefolgt von den Katalogen, dann freie Werke.
        // Innerhalb desselben Rangs: Jahr absteigend (undatierte ans Ende).
        var freeWorkActive = activeTags.indexOf('Freies Werk') !== -1;
        function cardRank(card) {
          var isCat = card.getAttribute('data-catalog-id') !== null;
          var isKab = (card.getAttribute('data-tags') || '').indexOf('Kunst am Bau') !== -1;
          if (freeWorkActive) {
            if (isCat) return 0;
            if (isKab) return 1;
            return 2;
          }
          if (isKab) return 0;
          if (isCat) return 1;
          return 2;
        }
        function yearNum(text) {
          var m = text.match(/(\d{4})/);
          return m ? parseInt(m[1], 10) : 0;
        }
        matches.sort(function(a, b) {
          var ra = cardRank(a);
          var rb = cardRank(b);
          if (ra !== rb) return ra - rb;
          var ta = (a.querySelector('.bio-art-card-year') || {}).textContent || '';
          var tb = (b.querySelector('.bio-art-card-year') || {}).textContent || '';
          return yearNum(tb) - yearNum(ta);
        });

        filterResultsGrid.innerHTML = '';
        matches.forEach(function(card) {
          var clone = card.cloneNode(true);
          clone.classList.remove('is-hidden', 'tag-hidden');
          filterResultsGrid.appendChild(clone);
        });
        filterResults.hidden = false;
      } else {
        // Browse view: restore category sections, clear flat grid
        filterResults.hidden = true;
        filterResultsGrid.innerHTML = '';
        categorySections.forEach(function(section) {
          section.classList.remove('category-hidden');
        });
        document.querySelectorAll('[data-expand]').forEach(function(grid) {
          updateGrid(grid);
        });
      }

      updateFilterUI(activeTags);
    }

    function updateFilterUI(activeTags) {
      // Vorschlag 1: Anker-Label petrol, wenn Filter aktiv.
      filterAnchor.classList.toggle('filter-anchor--active', activeTags.length > 0);
      // Vorschlag 4: Statuszeile mit aktiven Filtern + Entfernen-Buttons.
      var bar = document.getElementById('filter-statusbar');
      var barChips = document.getElementById('filter-statusbar-chips');
      if (bar && barChips) {
        barChips.innerHTML = '';
        activeTags.forEach(function(tag) {
          var chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'filter-statusbar-chip';
          chip.setAttribute('data-tag', tag);
          chip.setAttribute('aria-label', 'Filter ' + tag + ' entfernen');
          // Astro-scoped CSS matcht nur mit data-astro-cid-Attribut — das
          // statische HTML bekommt es automatisch, JS-erzeugte Elemente
          // müssen es selbst tragen.
          chip.setAttribute('data-astro-cid-r3bc3sjw', '');
          // Text + rotes X als eigene Spans (X klickbar, Text petrol/weiß).
          var text = document.createElement('span');
          text.className = 'filter-statusbar-chip-text';
          text.setAttribute('data-astro-cid-r3bc3sjw', '');
          text.textContent = tag;
          var x = document.createElement('span');
          x.className = 'filter-statusbar-chip-x';
          x.setAttribute('data-astro-cid-r3bc3sjw', '');
          x.setAttribute('aria-hidden', 'true');
          x.textContent = '×';
          chip.appendChild(text);
          chip.appendChild(x);
          chip.addEventListener('click', function() {
            // Entfernen: alle Chips mit diesem Tag deaktivieren.
            chips.forEach(function(c) {
              if (c.getAttribute('data-tag') === tag && c.getAttribute('aria-pressed') === 'true') {
                c.setAttribute('aria-pressed', 'false');
              }
            });
            updateFacetCounts();
            applyTagFilter();
            saveFilterState();
          });
          barChips.appendChild(chip);
        });
        bar.hidden = activeTags.length === 0;
      }
    }

    // Anker öffnet/schließt den Drawer. Beide hängen an derselben Variable
    // --seam (Drawer-Rechenkante == Anker-Linkskante) → synchron, nie Lücke.
    // instant=true (State-Restore): Drawer steht sofort offen, keine Slide-
    // Animation, kein Fokus auf den X-Button (der Petrol-Ring wäre sonst
    // sichtbar).
    function openDrawer(instant) {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      drawerIsOpen = true;
      saveFilterState(true);
      filterAnchor.setAttribute('aria-expanded', 'true');
      filterDrawer.setAttribute('open', '');
      // Desktop: Layout-Push statt Scrim — Content weicht für den Drawer Platz.
      // Mobile bleibt Overlay (Content wird nicht geschoben).
      if (window.matchMedia('(min-width: 851px)').matches) {
        var content = document.querySelector('.work-content');
        if (content) content.classList.add('drawer-pushed');
      } else {
        // Mobile bleibt Overlay: Scrim blenden und klickbar machen.
        filterScrim.hidden = false;
        requestAnimationFrame(function() {
          filterScrim.classList.add('filter-scrim--show');
        });
      }
      // Chips-2er-Grid messen und --drawer-w überschreiben (Anker-Wanderziel,
      // Drawer-Breite und Content-Margin folgen der tatsächlichen Drawer-Breite).
      syncDrawerWidth();
      if (instant) {
        // Sofort offen: Fuge direkt setzen, keine Transition.
        document.documentElement.style.setProperty('--seam', getSeamOpen());
        return;
      }
      // Reflow erzwingen: erst nach dem Sichtbarwerden die Fuge aufziehen,
      // sonst bündelt der Browser beide Zustände in einen Frame und die
      // Slide-In-Animation wird übersprungen.
      void filterDrawer.offsetWidth;
      requestAnimationFrame(function() {
        document.documentElement.style.setProperty('--seam', getSeamOpen());
      });
      // Erst nach dem Slide-In auf den Drawer fokussieren (Schließen per Escape
      // führt zurück zum Anker).
      if (drawerFocusTimer) clearTimeout(drawerFocusTimer);
      drawerFocusTimer = setTimeout(function() {
        drawerFocusTimer = null;
        var closeBtn = filterDrawer.querySelector('.filter-drawer-close');
        if (closeBtn && filterDrawer.open) closeBtn.focus();
      }, 450);
    }

    function getSeamOpen() {
      var w = getComputedStyle(document.documentElement).getPropertyValue('--drawer-w').trim();
      return w || '240px';
    }

    function closeDrawer() {
      if (drawerFocusTimer) {
        clearTimeout(drawerFocusTimer);
        drawerFocusTimer = null;
      }
      drawerIsOpen = false;
      saveFilterState(false);
      var content = document.querySelector('.work-content');
      if (content) content.classList.remove('drawer-pushed');
      if (filterScrim) {
        filterScrim.classList.remove('filter-scrim--show');
        filterScrim.hidden = true;
      }
      if (filterAnchor) filterAnchor.focus();
      // Fuge schließt: Drawer + Anker fahren gemeinsam zurück.
      document.documentElement.style.setProperty('--seam', '0px');
      // Nach der Schließ-Animation Zustand final zurücksetzen. Der Timer wird
      // beim erneuten Öffnen gecancelt, damit ein schnelles Öffnen→Schließen→
      // Öffnen nicht vom alten Timeout rückgängig gemacht wird.
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = setTimeout(function() {
        closeTimer = null;
        filterDrawer.removeAttribute('open');
        filterAnchor.setAttribute('aria-expanded', 'false');
      }, 450);
    }

    filterAnchor.addEventListener('click', function() {
      // Pointer-Tap/Drag hat den Zustand bereits umgeschaltet (dragHandled),
      // oder ein Drag hat geöffnet/geschlossen — nur noch der reine Klick
      // (ohne Pointer-Interaktion, z. B. Tastatur/Enter) toggelt hier.
      if (dragHandled) return;
      if (drawerIsOpen) {
        closeDrawer();
        return;
      }
      // Ripple läuft beim Betreten der Seite, nicht beim Klick.
      openDrawer();
    });
    filterDrawerClose.addEventListener('click', closeDrawer);
    // Scrim (Mobile-Overlay) und Drawer-Griff schließen symmetrisch per Drag.
    if (filterScrim) filterScrim.addEventListener('click', closeDrawer);

    // Drawer-Breite an die Chips koppeln: 2 nebeneinander, Breite = 2×
    // breitester Chip + Lücke + Padding, geclampt auf 180–320px.
    function syncDrawerWidth() {
      if (!chipGrids.length) return;
      var widest = 0;
      chipGrids.forEach(function(grid) {
        Array.prototype.forEach.call(grid.children, function(chip) {
          widest = Math.max(widest, chip.getBoundingClientRect().width);
        });
      });
      if (widest <= 0) return;
      var style = getComputedStyle(chipGrids[0]);
      var gap = parseFloat(style.columnGap) || parseFloat(style.gap) || 0.6 * 16;
      var width = Math.max(180, Math.min(320, widest * 2 + gap + 2 * 24));
      var w = window.matchMedia('(max-width: 850px)').matches
        ? Math.min(width, window.innerWidth * 0.88)
        : width;
      document.documentElement.style.setProperty('--drawer-w', w + 'px');
    }

    // Drag & Drop: Ziehen am Anker nach rechts öffnet den Drawer, nach links
    // schließt ihn (symmetrisch). Über Threshold (60px) loslassen = umschalten,
    // darunter federt der Drawer zurück. Während des Ziehens keine Transition.
    var dragState = {};
    var DRAG_THRESHOLD = 60;
    // Pointer-Tap/Drag ersetzt den Click-Handler für Maus+Touch. Der native
    // click feuert danach trotzdem — dieses Flag verhindert das Doppel-Toggle.
    var dragHandled = false;

    // Während des Drags keine Textauswahl, sonst Defaultverhalten.
    function setDraggingUserSelect(on) {
      document.body.classList.toggle('is-dragging', on);
    }

    function finishDrag() {
      dragState.dragging = false;
      dragState.pendingOpen = false;
      setDraggingUserSelect(false);
      // Transitionen reaktivieren, damit Drawer + Anker zum Ziel federn.
      filterDrawer.style.removeProperty('transition');
      filterAnchor.style.removeProperty('transition');
      filterDrawer.style.removeProperty('transform');
    }

    function playRippleOnce() {
      if (ripplePlayed || reduceMotion.matches) return;
      ripplePlayed = true;
      var ripple = filterAnchor.querySelector('.filter-anchor-ripple');
      if (ripple) {
        ripple.classList.remove('filter-anchor-ripple--play');
        void ripple.offsetWidth; // Restart der Animation
        ripple.classList.add('filter-anchor-ripple--play');
      }
    }

    // Ripple + Peek beim Betreten der Werke-Übersicht: einmalig, verzögert,
    // damit der Seitenaufbau erst zur Ruhe kommt. Der Drawer lupft langsam zu
    // 30% aus (äußere Chip-Spalte sichtbar) und fährt wieder zurück —
    // zeitgleich mit dem Ripple. Danach nie wieder (pro Aufruf).
    // Bei Rückkehr mit wiederhergestelltem Filter (z. B. von Biografie oder
    // einer Detailseite) entfällt beides — stattdessen steht der State direkt.
    setTimeout(function() {
      if (reduceMotion.matches) return;
      if (restoredFilter) {
        // Filter ist bereits aktiv: Drawer sofort offen (ohne Animation,
        // ohne Fokus auf X), kein Ripple/Peek — der Nutzer soll den
        // vorhandenen State direkt sehen.
        var s = loadFilterState();
        if (s && s.drawerOpen) openDrawer(true);
        return;
      }
      playRippleOnce();
      // Peek: nur anlupfen — Drawer + Anker fahren langsam zu 30% der
      // maximalen Ausziehung aus (die äußere Chip-Spalte wird sichtbar)
      // und wieder zurück.
      filterDrawer.setAttribute('open', '');
      var peekW = parseFloat(getComputedStyle(filterDrawer).width) * 0.3;
      document.documentElement.style.setProperty('--seam', peekW + 'px');
      setTimeout(function() {
        document.documentElement.style.setProperty('--seam', '0px');
        setTimeout(function() {
          filterDrawer.removeAttribute('open');
        }, 700);
      }, 1400);
    }, 600);

    // Hover-Preview: im eingeklappten Zustand lupft der Drawer beim Überfahren
    // des Ankers kurz zu 8% aus (Vorschau) und fährt beim Verlassen zurück.
    // Klick bleibt möglich: der Drawer schiebt sich unter die Maus, daher
    // öffnet auch ein Klick auf den Drawer-Bereich (Delegation).
    var hoverPeekTimer = null;
    filterAnchor.addEventListener('mouseenter', function() {
      if (drawerIsOpen || reduceMotion.matches) return;
      if (hoverPeekTimer) clearTimeout(hoverPeekTimer);
      filterDrawer.setAttribute('open', '');
      var peekW = parseFloat(getComputedStyle(filterDrawer).width) * 0.08;
      document.documentElement.style.setProperty('--seam', peekW + 'px');
    });
    filterAnchor.addEventListener('mouseleave', function(e) {
      if (drawerIsOpen || dragState.dragging) return;
      // Maus liegt nach dem Preview über dem Drawer (der unter sie rutscht):
      // dann nicht zurückfahren, sonst Oszillation enter/leave.
      var over = document.elementFromPoint(e.clientX, e.clientY);
      if (over && (over.closest('#filter-drawer') || over.closest('#filter-anchor'))) return;
      if (hoverPeekTimer) clearTimeout(hoverPeekTimer);
      document.documentElement.style.setProperty('--seam', '0px');
      hoverPeekTimer = setTimeout(function() {
        hoverPeekTimer = null;
        filterDrawer.removeAttribute('open');
      }, 700);
    });
    // Klick auf den Drawer (der beim Hover-Preview unter der Maus liegt)
    // öffnet den Drawer vollständig — der Anker ist durch den Preview
    // "weggerutscht", der Klick darf nicht ins Leere gehen.
    filterDrawer.addEventListener('click', function(e) {
      if (drawerIsOpen) return;
      if (e.target.closest && e.target.closest('.tag-chip')) return;
      if (e.target.closest && e.target.closest('.filter-drawer-close')) return;
      openDrawer();
    });
    // Drag auf dem Drawer (der beim Hover-Preview unter der Maus liegt):
    // pointerdown dort startet denselben Drag wie am Anker.
    function tryStartDrag(e) {
      if (e.button !== 0) return false;
      if (e.target.closest && e.target.closest('.tag-chip')) return false;
      if (e.target.closest && e.target.closest('.filter-drawer-close')) return false;
      if (hoverPeekTimer) {
        clearTimeout(hoverPeekTimer);
        hoverPeekTimer = null;
      }
      dragState.dragging = true;
      dragState.startX = e.clientX;
      dragState.dx = 0;
      dragState.active = false;
      dragState.id = e.pointerId;
      return true;
    }
    filterDrawer.addEventListener('pointerdown', function(e) {
      tryStartDrag(e);
    });
    // Erweiterter Griffbereich: Während des Hover-Previews rutscht der Anker
    // unter der Maus weg und die Maus liegt auf dem Body (vor dem Drawer).
    // pointerdown dort startet den Drag ebenfalls, damit Drag & Pull direkt
    // nach dem Hover funktioniert.
    document.addEventListener('pointerdown', function(e) {
      if (drawerIsOpen) return;              // voll geöffnet: nur Anker/Drawer ziehen
      if (!filterDrawer.hasAttribute('open')) return; // kein Hover-Preview aktiv
      if (e.target.closest && e.target.closest('#filter-drawer')) return; // Drawer-Handler greift
      if (e.target.closest && e.target.closest('#filter-anchor')) return; // Anker-Handler greift
      tryStartDrag(e);
    });

    filterAnchor.addEventListener('pointerdown', function(e) {
      if (e.button !== 0) return;
      // Hover-Preview-Timer abbrechen: ein Drag darf nicht vom mouseleave-
      // Timeout gestört werden (Drawer flackert sonst ein/aus).
      if (hoverPeekTimer) {
        clearTimeout(hoverPeekTimer);
        hoverPeekTimer = null;
      }
      dragState.dragging = true;
      dragState.startX = e.clientX;
      dragState.dx = 0;
      dragState.active = false;
      dragState.id = e.pointerId;
    });

    // move/up/cancel am window: setPointerCapture scheitert in einigen Um-
    // gebungen (Touch, CDP) und lässt die Events abbrechen, sobald der Zeiger
    // den Anker verlässt. window behält sie bis zum Loslassen.
    window.addEventListener('pointermove', function(e) {
      if (!dragState.dragging || e.pointerId !== dragState.id) return;
      var dx = e.clientX - dragState.startX;
      // Erst ab 6px als Ziehen werten (Klick/Tap bleibt sonst unzuverlässig).
      if (!dragState.active && Math.abs(dx) < 6) return;
      dragState.active = true;
      dragState.dx = dx;
      setDraggingUserSelect(true);
      // Während des Ziehens keine Transition (Drawer + Anker folgen live).
      filterDrawer.style.transition = 'none';
      filterAnchor.style.transition = 'none';
      var drawerW = parseFloat(getComputedStyle(filterDrawer).width) || 240;
      if (drawerIsOpen) {
        // Offen: Zug nach links zieht die Fuge zurück (nie unter 0).
        dragState.pendingOpen = false;
        document.documentElement.style.setProperty('--seam', Math.max(0, drawerW + dx) + 'px');
      } else if (dx > 0) {
        // Geschlossen: Zug nach rechts öffnet live; Rückwärts-Zug poppt nichts auf.
        filterDrawer.setAttribute('open', '');
        filterAnchor.setAttribute('aria-expanded', 'true');
        dragState.pendingOpen = true;
        document.documentElement.style.setProperty('--seam', Math.min(drawerW, dx) + 'px');
      }
    });

    window.addEventListener('pointerup', function(e) {
      if (!dragState.dragging || e.pointerId !== dragState.id) return;
      var shouldOpen = dragState.pendingOpen
        ? dragState.dx >= DRAG_THRESHOLD          // geschlossen: rechts über Threshold öffnet
        : dragState.dx >= -DRAG_THRESHOLD;        // offen: links über Threshold schließt, sonst bleibt er
      var wasActive = dragState.active;
      finishDrag();
      // Der native click nach Tap UND nach aktivem Drag würde den gerade
      // umgeschalteten Zustand erneut togglen — immer unterbinden.
      dragHandled = true;
      setTimeout(function() { dragHandled = false; }, 350);
      if (!wasActive) {
        // Kurzer Tap ohne Ziehen: wie gehabt öffnen/schließen.
        if (drawerIsOpen) {
          closeDrawer();
        } else {
          openDrawer();
        }
        return;
      }
      if (drawerIsOpen === shouldOpen) {
        // Zustand passt schon: ohne Animation auf den Zielzustand kippen.
        if (shouldOpen) {
          openDrawer();
        } else {
          closeDrawer();
        }
      } else if (shouldOpen) {
        openDrawer();
      } else {
        closeDrawer();
      }
    });

    window.addEventListener('pointercancel', function(e) {
      if (!dragState.dragging || e.pointerId !== dragState.id) return;
      finishDrag();
      if (drawerIsOpen) openDrawer(); else closeDrawer();
    });

    // Escape schließt den Drawer (Fokus kehrt zum Anker zurück). Ein
    // cancel-Event (modal-Dialog-Default) feuert bei non-modalen Dialogen
    // nicht — Deshalb ein eigener Keydown-Handler auf der Seite.
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawerIsOpen) {
        e.preventDefault();
        closeDrawer();
      }
    });

    // Live-Filter: Chip-Klick filtert sofort, der Drawer bleibt offen.
    // (applyTagFilter läuft über die chip-Handler unten — hier nichts nötig.)

    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        // Sicherheitsfeature: während des Hover-Previews (Drawer nicht voll
        // ausgefahren) sind Chips NICHT klickbar — der Klick fährt nur den
        // Drawer aus, er filtert nicht.
        if (!drawerIsOpen) {
          if (hoverPeekTimer) {
            clearTimeout(hoverPeekTimer);
            hoverPeekTimer = null;
          }
          openDrawer();
          return;
        }
        var isPressed = chip.getAttribute('aria-pressed') === 'true';
        var tagKey = chip.getAttribute('data-tag-key');
        var disabled = chip.getAttribute('aria-disabled') === 'true';
        // Gesperrter Chip (Kombination ergäbe 0 Treffer): kein Zustandswechsel,
        // nur Shake + Status-Meldung als Feedback.
        if (disabled && !isPressed) {
          chip.classList.add('tag-chip--shake');
          setTimeout(function() { chip.classList.remove('tag-chip--shake'); }, 500);
          var msg = '„' + chip.getAttribute('data-tag') + '" ergibt in dieser Kombination keine Treffer.';
          if (filterStatus) filterStatus.textContent = msg;
          showFilterToast(msg);
          return;
        }
        // XOR innerhalb einer Kategorie: ein bereits aktiver Schlüsselbegriff
        // in derselben Kategorie (z. B. Gebäudetyp) wird ersetzt statt ergänzt.
        if (!isPressed && tagKey && (chip.parentElement.getAttribute('data-single-select') === 'true')) {
          var siblings = chip.parentElement.querySelectorAll('.tag-chip[aria-pressed="true"]');
          siblings.forEach(function(sib) {
            sib.setAttribute('aria-pressed', 'false');
          });
        }
        chip.setAttribute('aria-pressed', isPressed ? 'false' : 'true');
        updateFacetCounts();
        applyTagFilter();
        saveFilterState();
      });
    });

    // Facet-Counts: Die Zahl neben jedem Schlüsselbegriff zeigt, wie viele
    // Treffer entstehen, wenn dieser Begriff zur aktuellen Auswahl hinzukäme
    // (nicht die isolierte Gesamtzahl). Material bleibt Multi-Select: eine
    // Kombination mit 0 Treffern sperrt den Chip und antwortet mit Shake +
    // Meldung statt Auswahl.
    function countMatches(selected) {
      return Array.prototype.filter.call(cards, function(card) {
        var cardTags = (card.getAttribute('data-tags') || '').split(',');
        return selected.every(function(t) { return cardTags.indexOf(t) !== -1; });
      }).length;
    }

    function updateFacetCounts() {
      var activeTags = getActiveTags();
      var activeByKey = {};
      chips.forEach(function(c) {
        if (c.getAttribute('aria-pressed') === 'true') {
          var key = c.getAttribute('data-tag-key');
          (activeByKey[key] = activeByKey[key] || []).push(c.getAttribute('data-tag'));
        }
      });
      chips.forEach(function(c) {
        var key = c.getAttribute('data-tag-key');
        var tag = c.getAttribute('data-tag');
        var isSingle = c.parentElement.getAttribute('data-single-select') === 'true';
        var own = activeByKey[key] || [];
        // Testauswahl: aktive Begriffe, wobei bei Single-Gruppen der evtl.
        // aktive Begriff derselben Gruppe durch diesen ersetzt wird.
        var test = isSingle
          ? activeTags.filter(function(t) { return own.indexOf(t) === -1; })
          : activeTags.slice();
        if (test.indexOf(tag) === -1) test.push(tag);
        var count = countMatches(test);
        var el = c.querySelector('.tag-chip-count');
        if (el) el.textContent = '(' + count + ')';
        // Sperren kategorieübergreifend: jeder Chip, dessen Kombination mit
        // der aktuellen Auswahl 0 Treffer liefert, wird ausgegraut. Aktive
        // Chips bleiben klickbar (Toggle off).
        var isPressed = c.getAttribute('aria-pressed') === 'true';
        if (!isPressed && count === 0 && test.length > 1) {
          c.setAttribute('aria-disabled', 'true');
        } else {
          c.setAttribute('aria-disabled', 'false');
        }
      });
    }

    updateFacetCounts();

    // Filter-State aus Session wiederherstellen (Rückkehr von Detailseite
    // oder einer anderen Seite): aktive Chips + Drawer-Zustand sofort setzen,
    // ohne erneuten Ripple/Peek.
    var savedState = loadFilterState();
    if (savedState && savedState.tags.length) {
      restoredFilter = true;
      chips.forEach(function(c) {
        var tag = c.getAttribute('data-tag');
        if (savedState.tags.indexOf(tag) !== -1) {
          c.setAttribute('aria-pressed', 'true');
        }
      });
      applyTagFilter();
      // drawerOpen des wiederhergestellten State bewahren (der Drawer ist
      // beim Setup noch geschlossen — applyTagFilter/save würden es auf
      // false setzen und die Rückkehr-Ansicht verlieren).
      saveFilterState(savedState.drawerOpen);
    }

    // Toast verdeckt keine Karte: Sobald der Nutzer eine Karte berührt,
    // verschwindet der Toast sofort mit derselben Animation wie beim
    // Timer-Ablauf. Delegation am Dokument, damit auch die geklonten Karten
    // im Filter-Ergebnis-Grid erfasst werden.
    document.addEventListener('mouseover', function(e) {
      if (e.target.closest && e.target.closest('.bio-art-card')) {
        hideFilterToast();
      }
    });

    // --- Expandable Grids ---
    var grids = document.querySelectorAll('[data-expand]');
    var buttons = document.querySelectorAll('.expand-btn');

    function countColumns(grid) {
      var style = getComputedStyle(grid);
      var gap = parseFloat(style.columnGap) || parseFloat(style.gap) || 0;
      var width = grid.clientWidth;
      return Math.max(1, Math.floor((width + gap) / (280 + gap)));
    }

    function hasActiveFilter() {
      return document.querySelectorAll('.tag-chip[aria-pressed="true"]').length > 0;
    }

    function updateGrid(grid) {
      var gridId = grid.getAttribute('data-expand');
      var btn = document.querySelector('.expand-btn[data-target="' + gridId + '"]');
      if (!btn) return;

      var visibleCards = Array.from(grid.querySelectorAll('.bio-art-card:not(.tag-hidden)'));
      var cols = countColumns(grid);
      var isExpanded = btn.getAttribute('aria-expanded') === 'true';
      var isFiltering = hasActiveFilter();

      // When a filter is active, show ALL matching cards (user knows what they want)
      // When no filter, use expand/collapse logic (show first row only)
      visibleCards.forEach(function(card, i) {
        if (isFiltering || isExpanded || i < cols) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });

      // Ensure tag-hidden cards stay hidden
      var hiddenByTag = Array.from(grid.querySelectorAll('.bio-art-card.tag-hidden'));
      hiddenByTag.forEach(function(card) {
        card.classList.add('is-hidden');
      });

      // Hide expand button when filtering (all cards already visible)
      if (isFiltering) {
        btn.style.display = 'none';
      } else {
        btn.style.display = visibleCards.length <= cols ? 'none' : '';
      }
    }

    grids.forEach(function(grid) { updateGrid(grid); });

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var targetId = btn.getAttribute('data-target');
        var grid = document.querySelector('[data-expand="' + targetId + '"]');
        if (!grid) return;

        var expanding = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', expanding ? 'true' : 'false');
        btn.querySelector('.expand-btn-text').textContent = expanding ? 'Weniger anzeigen' : 'Mehr anzeigen';
        btn.querySelector('.expand-btn-arrow').classList.toggle('rotated', expanding);

        updateGrid(grid);
      });
    });

    var observer = new ResizeObserver(function() {
      grids.forEach(function(grid) { updateGrid(grid); });
    });
    grids.forEach(function(grid) { observer.observe(grid); });
  }

  // Direkter Aufruf beim initialen Laden + astro:page-load für jede View-
  // Transition. setupWorkPage markiert den body selbst (Guard): Nach einer
  // View-Transition ersetzt Astro den body, der Guard zieht auf das frische
  // Document um und bindet die Listener an die neuen Elemente.
  setupWorkPage();
  document.addEventListener('astro:page-load', setupWorkPage);
</script>

<style>
  /* Anker: Linke Kante klebt an der Fuge --seam. rechte Kante ragt um die
     Ankerbreite über die Drawer-Rechenkante hinaus. padding schlank
     horizontal (1.2rem), hoch vertikal (3.2rem); radius 0 1.6rem lässt die
     rechte Kante flach in den Drawer überlaufen. */
  .filter-anchor {
    position: fixed;
    top: 50%;
    left: 0;
    z-index: 2001;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 4.6rem 0.7rem;
    /* Papier-Textur: exakt derselbe Gradient wie der Drawer (Radial-Schimmer
       + Linear), background-attachment: fixed → an der Fuge zeigen Anker und
       Drawer dieselbe Farbhöhe. Der Anker ist Teil des Papiers, kein separates
       Stück. */
    background:
      radial-gradient(ellipse at 12% 8%, rgba(255, 255, 255, 0.55), transparent 55%),
      linear-gradient(180deg, #FBF9F4, #F5F2EB);
    background-attachment: fixed;
    border: 1px solid #E0E0E0;
    border-right: 1px solid #E0E0E0;
    /* Linke Kante liegt an der Drawer-Rechenkante an — keine eigene Border,
       sonst entsteht an der Fuge ein doppelter grauer Strich. */
    border-left: 0;
    /* 1px Überlappung: der Anker schiebt sich über die Drawer-Border, damit
       an der Fuge keine Linie sichtbar bleibt. */
    margin-left: -1px;
    border-radius: 0 2.4rem 2.4rem 0;
    /* Kein eigener Schatten: der Drawer-Schatten fällt nach rechts und wird
       im Anker-Bereich vom Anker überdeckt → ein Stück Papier mit Schatten
       nur an der rechten Kante, kein "angeklebtes" separates Element. */
    box-shadow: none;
    /* Basis dunkel (wie profan/sakral); petrol nur bei aktivem Filter
       (siehe .filter-anchor--active). */
    color: var(--color-base) !important;
    font-family: var(--font-sans-serif);
    cursor: pointer;
    /* Geschrieben statt verdreht: vertikal von unten nach oben. */
    writing-mode: vertical-rl;
    text-orientation: mixed;
    /* Anker folgt der Fuge per transform (translateX) — dieselbe
       Animations-Property wie der Drawer (transform), beide GPU-beschleunigt
       und frame-synchron → keine Lücke beim Herausziehen. */
    transform: translateY(-50%) translateX(var(--seam));
    transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
    /* Ripple-Container: Wellen an der rechten Außenseite des Tabs. */
    overflow: visible;
    /* Doppeltipp-Zoom vermeiden; pan-y erlaubt vertikales Scrollen, blockt
       aber pan-x, damit der horizontale Touch-Drag am Anker nicht als
       pointercancel endet. */
    touch-action: pan-y;
  }

  .filter-anchor-label {
    /* writing-mode explizit horizontal: der Anker erbt vertical-rl, sonst
       würde die flex-row vertikal laufen und der Count unter dem Text
       statt daneben stehen. */
    writing-mode: horizontal-tb;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    /* Gleiche Größe wie der Drawer-Titel "Filter" und die Unterabschnitts-
       Titel (profan/sakral): clamp(1.3rem, 2vw, 1.7rem) → 1.7rem.
       font-weight 400 wie profan/sakral — kein Bold. */
    font-size: 1.7rem;
    font-weight: 400;
    /* 1px wie profan/sakral (0.12em wäre bei 1.7rem 2px — zu weit) */
    letter-spacing: 1px;
    text-transform: lowercase;
    font-variant: small-caps;
    line-height: 1.2;
  }

  .filter-anchor-label-text {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  /* Vorschlag 1: Anker-Label petrol, wenn Filter aktiv. */
  .filter-anchor--active .filter-anchor-label-text {
    color: var(--color-primary);
  }

  /* Ripple: exakt das Katalog-Muster, nur kräftiger (Start 16px, 70% Farbe,
     Wellen bis 110px) und Zentrum an der rechten Außenseite des Tabs. */
  .filter-anchor-ripple {
    position: absolute;
    top: 50%;
    right: 1px;
    width: 0;
    height: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
  }

  .filter-anchor-ripple::before,
  .filter-anchor-ripple::after,
  .filter-anchor-ripple .filter-anchor-ripple-wave {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--color-primary) 70%, transparent);
    transform: translate(-50%, -50%);
  }

  .filter-anchor-ripple--play {
    opacity: 1;
  }

  .filter-anchor-ripple--play::before {
    animation: anchor-ripple 1.6s ease-out 0s 1 forwards;
  }

  .filter-anchor-ripple--play::after {
    animation: anchor-ripple 1.6s ease-out 0.5s 1 forwards;
  }

  .filter-anchor-ripple--play .filter-anchor-ripple-wave {
    animation: anchor-ripple 1.6s ease-out 1s 1 forwards;
  }

  @keyframes anchor-ripple {
    0%   { width: 16px; height: 16px; opacity: 0.6; }
    100% { width: 110px; height: 110px; opacity: 0; }
  }

  /* Geöffnet: Fuge auf --drawer-w (JS setzt --seam). Der Anker hängt an
     derselben Variable — diese Klasse wird nicht mehr gebraucht. */
  /* Scrim: deckt nur auf Mobile den Viewport ab (Overlay-Verhalten),
     Klick schließt den Drawer. JS steuert hidden + --show nur mobile. */
  .filter-scrim {
    position: fixed;
    inset: 0;
    z-index: 1999;
    background: rgba(30, 30, 30, 0.4);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .filter-scrim--show {
    opacity: 1;
  }

  .filter-scrim[hidden] {
    display: none;
  }

  /* Drawer-Breite: Default 240px, wird von JS aus den Chips gemessen und
     überschrieben (clamp 180–320px). Anker-Link-Kante, Anker-Wanderziel und
     Content-Margin lesen dieselbe Variable. */
  :root {
    --drawer-w: 240px;
   /* Fuge --seam: Drawer-Rechenkante == Anker-Linkskante (exakt dieselbe
      Position). 0 geschlossen, --drawer-w offen; während des Ziehens folgt
      sie dem Finger. Drawer (transform) und Anker (left) hängen an derselben
      Variable → synchrones Ein-/Ausfahren und Ziehen, nie eine Lücke. */
    --seam: 0px;
  }

  /* Drawer: Papier von links. Rechte Kante folgt --seam: translateX =
     seam - 100% → Kante exakt bei seam. Gleiche Fuge wie Anker-Lin-
     skante → synchrones Ein-/Ausfahren, nie Lücke. */
  .filter-drawer {
    position: fixed;
    top: 12.5%;
    left: 0;
    bottom: auto;
    width: var(--drawer-w);
    max-width: 88vw;
    margin: 0;
    padding: 0;
    border: 0;
    border-right: 1px solid #E0E0E0;
    border-radius: 0 1rem 1rem 0;
    /* Papier-Textur: feiner Radial-/Lineargradient auf Off-White.
       background-attachment: fixed → an der Fuge (rechte Kante) zeigt der
       Drawer dieselbe Farbhöhe des Verlaufs wie der Anker. */
    background:
      radial-gradient(ellipse at 12% 8%, rgba(255, 255, 255, 0.55), transparent 55%),
      linear-gradient(180deg, #FBF9F4, #F5F2EB);
    background-attachment: fixed;
    box-shadow: 8px 0 32px rgba(0, 0, 0, 0.22);
    color: #1A1A1A;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    /* 75% der Viewport-Höhe, vertikal zentriert: obere und untere Kante
       haben Abstand zum Viewport-Rand (12.5% je Seite). */
    height: 75vh;
    /* Geschlossen: translateX(-100%) → Rechteck-Kante bei 0 (--seam 0). */
    transform: translateX(calc(var(--seam) - 100%));
    transition: transform 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .filter-drawer:not([open]) {
    display: none; /* <dialog> ohne open bleibt im DOM verborgen */
  }

  .filter-drawer[open] {
    display: flex; /* Dialog-Default überschreiben */
  }

  .filter-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .filter-drawer-title {
    font-family: var(--font-sans-serif);
    /* Exakt wie der Anker-Schriftzug "Filter": 1.7rem, weight 400,
       1px letter-spacing, lowercase small-caps. */
    font-size: 1.7rem;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: lowercase;
    font-variant: small-caps;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .filter-drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: transparent !important;
    border: 1px solid var(--color-border) !important;
    border-radius: 50% !important;
    box-shadow: none !important;
    color: var(--color-base) !important;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  /* Hover im Site-Button-Stil: füllt mit Primärfarbe, Icon invertiert. */
  .filter-drawer-close:hover {
    background: var(--color-primary) !important;
    border-color: var(--color-primary) !important;
    color: var(--color-bg) !important;
  }

  .filter-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.5rem 1.5rem;
    /* verhindert Scroll-Chaining an die dahinterliegende Seite */
    overscroll-behavior: contain;
    /* Gruppen füllen die volle Body-Höhe → alle Chips ohne Scrollen sichtbar */
    display: flex;
  }

  .filter-drawer-groups {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .filter-drawer-body .tag-group {
    margin-bottom: 1.25rem;
  }

  .filter-drawer-body .tag-group:last-child {
    margin-bottom: 0;
  }
  /* Vorschlag 4: Statuszeile über dem gefilterten Ergebnis — aktive Filter
     als Petrol-Chips (wie in den Filteroptionen), weißer Text, rotes X zum
     Entfernen. */
  .filter-statusbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans-serif);
    font-size: 1rem;
    color: #888;
  }

  .filter-statusbar-label {
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
  }

  .filter-statusbar-chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-statusbar-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    background-color: var(--color-primary) !important;
    border: 1px solid var(--color-primary) !important;
    border-radius: 999px !important;
    box-shadow: none !important;
    color: var(--color-bg) !important;
    font-family: var(--font-sans-serif);
    font-size: 0.95rem;
    height: auto;
    line-height: 1.4;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .filter-statusbar-chip:hover {
    background-color: var(--color-bg) !important;
    color: var(--color-primary) !important;
    border-color: var(--color-primary) !important;
  }

  .filter-statusbar-chip-text {
    white-space: nowrap;
  }

  /* Weißes X: dezent, passt zum weißem Chip-Text. Bei Hover auf dem Chip
     färbt sich das X rot — signalisiert "Klick entfernt den Filter". */
  .filter-statusbar-chip-x {
    color: #fff;
    font-size: 1.1rem;
    line-height: 1;
    font-weight: 600;
  }

  .filter-statusbar-chip:hover .filter-statusbar-chip-x {
    color: #b3382e;
  }

  .filter-statusbar[hidden] {
    display: none;
  }

  /* Hybrid-Layout entfällt: der Drawer braucht keinen Grid-Platz mehr. */
  .work-layout {
    display: block;
  }

  /* Desktop: Content weicht beim Öffnen für den Drawer zur Seite
     (echtes Layout-Push statt Overlay), gleiche Transition wie der Drawer. */
  .work-content {
    transition: margin-left 0.8s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .work-content.drawer-pushed {
    /* Push = aktuelle Fugenposition: animiert mit der --seam-Transition,
       sodass Drawer, Anker und Content synchron fahren. */
    margin-left: var(--seam);
  }

  /* Während des Ziehens am Anker keine Textauswahl (per body-Klasse). */
  body.is-dragging {
    user-select: none;
  }

  .tag-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .tag-group-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: 1.3rem;
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
    /* Abweichung zu .bio-section-subtitle: eingefärbt statt grau. */
    color: var(--color-primary);
  }

  .tag-group-chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    width: 100%;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 1.3rem;
    background: transparent !important;
    border: 1px solid var(--color-border) !important;
    border-radius: 999px !important;
    box-shadow: none !important;
    color: var(--color-base) !important;
    font-family: var(--font-sans-serif) !important;
    font-size: 1.1rem !important;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.4 !important;
    height: auto !important;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    /* Lange Labels bleiben einzeilig, Ellipsis kürzt (voller Text per
       title/aria-label). */
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Text + Count horizontal zentriert; Ellipsis greift nur am Text. */
  .tag-chip-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tag-chip:hover {
    background: transparent !important;
    color: var(--color-primary) !important;
    border-color: var(--color-primary) !important;
    box-shadow: none !important;
  }

  /* Dezente Trefferzahl pro Schlüsselbegriff (Facet-Filter-Standard),
     in Klammern. */
  .tag-chip-count {
    flex-shrink: 0;
    font-size: 0.85rem;
    opacity: 0.55;
    /* vertikal mittig zur Chip-Textzeile (line-height 1.4 des Chips) */
    line-height: 1;
    align-self: center;
  }

  /* Gesperrter Chip: Kombination ergäbe 0 Treffer — ausgegraut.
     Klicks bleiben möglich (kein pointer-events), damit der Handler
     mit Shake + Status-Meldung antworten statt zu deaktivieren.
     Hover in Rot: signalisiert "ungültige Auswahl" statt aktivierbar. */
  .tag-chip[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .tag-chip[aria-disabled='true']:hover {
    opacity: 0.75;
    color: #b3382e !important;
    border-color: #b3382e !important;
    box-shadow: none !important;
  }

  .tag-chip[aria-disabled='true'] .tag-chip-count {
    color: #b3382e;
  }

  /* Shake-Feedback beim Klick auf einen gesperrten Chip. */
  .tag-chip--shake {
    animation: chip-shake 0.45s ease;
  }

  @keyframes chip-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-4px); }
    40% { transform: translateX(4px); }
    60% { transform: translateX(-3px); }
    80% { transform: translateX(2px); }
  }

  /* [hidden] muss das display:flex des Toasts überschreiben, sonst ist der
     Toast permanent sichtbar (Default [hidden] = display:none gilt nur, wenn
     kein eigenes display gesetzt ist). */
  .filter-toast[hidden] {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Hinweis-Toast bei Klick auf eine gesperrte Kombination.
     In den Site-Farben: Papier-Hintergrund, dunkle Schrift, Petrol-Akzent,
     weicher Schatten. Slide-up + Fade beim Einblenden (mit reduziertem
     Motion-Respekt); Ausblenden per [hidden]. */
  .filter-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3000;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    /* Breite schrumpft auf den Inhalt: Der Rahmen umschließt den Text immer
       vollständig. Kappung nur gegen den Viewport — eine kleinere Kappung
       würde den Einzeiler rechts überstehen lassen. */
    width: fit-content;
    max-width: 92vw;
    /* padding-left um die Border-Differenz reduziert (4px Akzent vs. 1px):
       Abstand Icon→linke Kante == Abstand Textende→rechte Kante. */
    padding: 1.2rem 1.6rem 1.2rem calc(1.6rem - 3px);
    background: var(--color-card-bg);
    color: var(--color-base);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 0.6rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
    font-family: var(--font-sans-serif);
    font-size: 1.3rem;
    line-height: 1.5;
    text-align: left;
    white-space: nowrap;
    /* Rein informativ: Hover/Maus geht direkt an die Karten darunter,
       der Toast verdeckt sie nicht. */
    pointer-events: none;
    animation: toast-in 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .filter-toast-icon {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  /* Herausfallen beim Ausblenden (Spiegelbild des Einfliegens). */
  .filter-toast--out {
    animation: toast-out 0.3s cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  @keyframes toast-out {
    from {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    to {
      opacity: 0;
      transform: translateX(-50%) translateY(1.2rem);
    }
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(1.2rem);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-toast,
    .filter-toast--out {
      animation: none;
      transition: none;
    }

    /* Drawer + Anker schalten ohne Animation um. Content-Push ebenfalls
       ohne Animation. */
    .filter-drawer,
    .filter-anchor,
    .filter-scrim,
    .work-content {
      transition: none;
    }

    .filter-anchor-ripple--play::before,
    .filter-anchor-ripple--play::after,
    .filter-anchor-ripple--play .filter-anchor-ripple-wave {
      animation: none;
    }
  }

  /* Sektionsüberschriften: alle (Gruppen wie Glas/Malerei) einheitlich
     formatiert wie „Kunst am Bau". */
  .bio-section-title,
  .bio-section-title--group {
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
    margin: 0 0 2rem;
    /* Line-Height + Padding so bemessen, dass die Trennlinie auf exakt
       derselben Höhe liegt wie die Linie unter den Sidebar-Labels. */
    line-height: 24px;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .bio-section-subtitle {
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
    margin: 0 0 1.5rem;
    color: #888;
  }

  .category-section--group {
    margin-bottom: 3rem;
  }

  .tag-chip[aria-pressed='true'] {
    background: var(--color-primary) !important;
    color: var(--color-bg) !important;
    border-color: var(--color-primary) !important;
    box-shadow: none !important;
  }

  /* Tag-hidden cards */
  .bio-art-card.tag-hidden {
    display: none;
  }

  /* Category sections hidden when no matching cards */
  .category-section.category-hidden {
    display: none;
  }

  .bio-art-card.is-hidden {
    display: none;
  }



  /* .bio-art-card layout is defined globally in bio.css; do not override here */
  a.bio-art-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .bio-art-card-image {
    margin: -1.5rem -1.5rem 1rem -1.5rem;
    line-height: 0;
    overflow: hidden;
    height: 200px;
    /* Ecken oben an der Kartenrundung angleichen */
    border-radius: 0.9rem 0.9rem 0 0;
  }

  /* Katalog-Karten: Petrol-Rahmen + Badge oben rechts, um sie von
     Werk-Detailkarten zu unterscheiden (öffnen ein Blätterkatalog-Modal). */
  .bio-art-card--catalog {
    position: relative;
    border-width: 2px;
    border-color: var(--color-primary);
  }

  .bio-art-card--catalog .bio-art-card-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    padding: 0.3rem 0.7rem;
    background: var(--color-primary);
    color: var(--color-bg);
    font-family: var(--font-sans-serif);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 999px;
  }

  .bio-art-card-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0 !important;
  }

  /* Expand button overrides â€” counteract global buttons.css */
  .expand-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 2rem auto 0;
    padding: 0.6rem 1.5rem;
    background: transparent !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius);
    box-shadow: none !important;
    color: var(--color-base) !important;
    font-family: var(--font-sans-serif);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    font-variant: small-caps;
