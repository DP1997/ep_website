---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allWorks = await getCollection('works');

const BASE_URL = import.meta.env.BASE_URL;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,png}',
  { eager: true }
);

function getHeroImage(dir: string) {
  // Try direct file match first (e.g. 'freie_werke/bubbles-ii.jpg')
  let key = Object.keys(allImages).find(k => k.endsWith(`/${dir}`));
  if (key) return allImages[key].default;
  // Fall back to directory with 1.jpg (e.g. 'atem' -> 'atem/1.jpg')
  key = Object.keys(allImages).find(k => k.includes(`/${dir}/1.jpg`));
  return key ? allImages[key].default : null;
}

function getCatalogCover(id: string) {
  const key = Object.keys(allImages).find(k => k.includes(`/kataloge/${id}_cover.`));
  return key ? allImages[key].default : null;
}

// Schlüsselbegriffe: absteigend nach Relevanz sortieren, wobei Relevanz die
// Anzahl der Kunst-am-Bau-Projekte ist, die diesen Begriff teilen. Der Begriff
// mit den meisten Kunst-am-Bau-Treffern steht zuerst. Bei Gleichstand bleibt
// die Eingabereihenfolge (alphabetisch) erhalten — sort ist stabil.
const kabWorks = allWorks.filter(w => w.data.tags.kategorie.includes('Kunst am Bau'));

function sortByRelevanceDesc(tags: string[], key: string): string[] {
  const count = (tag: string) => kabWorks.filter(w => (w.data.tags as any)[key]?.includes(tag)).length;
  return tags.slice().sort((a, b) => count(b) - count(a));
}

const kategorieTags = sortByRelevanceDesc([...new Set(allWorks.flatMap(w => w.data.tags.kategorie).filter(Boolean))], 'kategorie');
const kontextTags = sortByRelevanceDesc([...new Set(allWorks.flatMap(w => w.data.tags.kontext).filter(Boolean))], 'kontext');
const gebaeudetypTags = sortByRelevanceDesc([...new Set(allWorks.flatMap(w => w.data.tags.gebaeudetyp).filter(Boolean))], 'gebaeudetyp');
const materialTags = sortByRelevanceDesc([...new Set(allWorks.flatMap(w => w.data.tags.material).filter(Boolean))], 'material');

// Trefferzahlen pro Schlüsselbegriff (Anzahl Werke, die den Begriff tragen).
// Wird am Chip als dezentes Label angezeigt (State of the Art bei Facet-Filtern).
function tagCount(tag: string, key: string): number {
  return allWorks.filter(w => (w.data.tags as any)[key]?.includes(tag)).length;
}
const materialCounts = Object.fromEntries(materialTags.map(t => [t, tagCount(t, 'material')]));
const kategorieCounts = Object.fromEntries(kategorieTags.map(t => [t, tagCount(t, 'kategorie')]));
const kontextCounts = Object.fromEntries(kontextTags.map(t => [t, tagCount(t, 'kontext')]));
const gebaeudetypCounts = Object.fromEntries(gebaeudetypTags.map(t => [t, tagCount(t, 'gebaeudetyp')]));
const tagCounts: Record<string, Record<string, number>> = {
  kategorie: kategorieCounts,
  kontext: kontextCounts,
  gebaeudetyp: gebaeudetypCounts,
  material: materialCounts,
};

// Tag groups for display
// single: XOR-Auswahl innerhalb der Gruppe — ein Werk ist nie gleichzeitig
// z. B. Schule und Kapelle, Sakral und Profan oder Kunst am Bau und frei.
// Material erlaubt Mehrfachwerte (Email + Stahl) und bleibt Multi-Select.
const tagGroups = [
  { label: 'Kategorie', key: 'kategorie', tags: kategorieTags, single: true },
  { label: 'Kontext', key: 'kontext', tags: kontextTags, single: true },
  { label: 'Gebäudetyp', key: 'gebaeudetyp', tags: gebaeudetypTags, single: true },
  { label: 'Material', key: 'material', tags: materialTags, single: false },
];

// Primary categories
const categories = [
  {
    id: 'kunst_am_bau',
    title: 'Kunst am Bau',
    isGroup: true,
    subsections: [
      { id: 'profan',  title: 'Profan',  tag: 'Profan' },
      { id: 'sakral',  title: 'Sakral',  tag: 'Sakral' },
    ],
  },
  {
    id: 'glas',
    title: 'Glas',
    isGroup: false,
    catalog: {
      title: 'Katalog Fusingglas',
      href: `${BASE_URL}katalog/glas`,
    },
    filter: (w: typeof allWorks[number]) =>
      w.data.tags.kategorie.includes('Freies Werk') && w.data.tags.material.includes('Glas'),
  },
  {
    id: 'malerei',
    title: 'Malerei',
    isGroup: false,
    catalog: {
      title: 'Katalog Malerei',
      href: `${BASE_URL}katalog/malerei`,
    },
    filter: (w: typeof allWorks[number]) =>
      w.data.tags.kategorie.includes('Freies Werk') && w.data.tags.material.includes('Malerei'),
  },
];

// Sort key: erste Jahreszahl; Werke ohne Datum (z. B. "t.b.d.") bekommen 0 und landen hinten.
function yearNum(date: string): number {
  const m = date.match(/(\d{4})/);
  return m ? parseInt(m[1], 10) : 0;
}

function sortByDateDesc(a: typeof allWorks[number], b: typeof allWorks[number]) {
  return yearNum(b.data.date) - yearNum(a.data.date);
}

// Build works per category
function getWorksForCategory(cat: typeof categories[number]) {
  if ('filter' in cat && cat.filter) {
    return allWorks.filter(cat.filter).sort(sortByDateDesc);
  }
  if ('subsections' in cat && cat.subsections) {
    return []; // group categories don't have works directly
  }
  return [];
}

// Katalog-Karte als Filtertreffer: kombiniert Kategorie + Material-Tags,
// damit sie im gefilterten Ergebnis erscheint (z. B. „Freies Werk" + „Glas"
// zeigt den Glaskatalog zuerst an).
function catalogTags(cat: typeof categories[number]): string {
  if ('filter' in cat && cat.filter && cat.id === 'glas') return 'Freies Werk,Glas';
  if ('filter' in cat && cat.filter && cat.id === 'malerei') return 'Freies Werk,Malerei';
  return '';
}

const worksByCategory = Object.fromEntries(
  categories.map(cat => [cat.id, getWorksForCategory(cat)])
);

// Flat, date-sorted list of all works for the filtered result view
const allWorksSorted = [...allWorks].sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout>
  <div class="bio-section work-layout">
    <aside class="work-sidebar">
      <!-- Überschrift: benennt die Sidebar als Filterbereich.
           Nur Desktop sichtbar — im Mobile-Overlay übernimmt der Dialog-Header. -->
      <h2 class="work-sidebar-title">Filteroptionen</h2>

      <!-- Filter Bar (nur Mobile: öffnet das Dialog-Overlay) -->
      <div class="filter-bar">
        <button class="filter-toggle" id="filter-toggle" aria-expanded="false" aria-controls="filter-dialog">
          <span class="filter-toggle-label">Filter</span>
          <span class="filter-toggle-count" id="filter-count" hidden>0</span>
        </button>
      </div>

      <!-- Filter-Dialog: Desktop als sticky Sidebar, Mobile als Overlay.
           Eine einzige Quelle für die Chips — kein Duplikat, keine Sync-Probleme. -->
      <dialog class="filter-dialog" id="filter-dialog">
        <div class="filter-dialog-header">
          <span class="filter-dialog-title">Filter</span>
          <button class="filter-dialog-close" id="filter-dialog-close" aria-label="Filter schließen">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="filter-dialog-body">
          {tagGroups.map(group => (
            <div class="tag-group">
              <span class="tag-group-label">
                {group.label}
              </span>
              <div class="tag-group-chips" data-single-select={group.single ? 'true' : 'false'}>
                {group.tags.map(tag => (
                  <button class="tag-chip" data-tag-key={group.key} data-tag={tag} aria-pressed="false">
                    {tag}
                    <span class="tag-chip-count">{tagCounts[group.key]?.[tag] ?? 0}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="filter-dialog-footer">
          <button class="filter-dialog-apply" id="filter-dialog-apply">Anwenden</button>
        </div>
      </dialog>
      <!-- Screenreader-/Status-Meldung für Filter-Hinweise (visuell verborgen,
           aber für assistive Technologien lesbar). -->
      <p id="filter-status" class="visually-hidden" aria-live="polite"></p>
      <!-- Sichtbarer Hinweis-Toast: erscheint kurz, wenn eine gesperrte
           Kombination (0 Treffer) angeklickt wird. -->
      <div id="filter-toast" class="filter-toast" role="status" aria-live="polite" hidden>
        <svg class="filter-toast-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        <span id="filter-toast-text"></span>
      </div>
    </aside>

    <div class="work-content">
      <!-- Flat filtered results (shown only when a filter is active) -->
      <div class="filter-results" id="filter-results" hidden>
        <div class="bio-art-grid" id="filter-results-grid"></div>
      </div>

    {categories.map(cat => {
      if ('isGroup' in cat && cat.isGroup && 'subsections' in cat && cat.subsections) {
        return (
          <div class="category-section category-section--group" data-category={cat.id}>
            <h2 class="bio-section-title bio-section-title--group">{cat.title}</h2>
            {cat.subsections.map(sub => {
              const subWorks = allWorks
                .filter(w => w.data.tags.kontext.includes(sub.tag))
                .sort(sortByDateDesc);
              const subId = cat.id + '_' + sub.id;
              return (
                <div class="category-section" data-category={subId} data-category-tag={sub.tag}>
                  <h3 class="bio-section-subtitle">{sub.title}</h3>
                  <div class="bio-art-grid" data-expand={subId}>
                    {subWorks.map((item) => {
                      const slug = item.id.split('/').pop();
                      const category = item.id.split('/')[0];
                      const heroImg = getHeroImage(item.data.image_dir);
                      const allTags = [
                        ...item.data.tags.kategorie,
                        ...item.data.tags.kontext,
                        ...item.data.tags.gebaeudetyp,
                        ...item.data.tags.material
                      ].filter(Boolean);
                      return (
                        <a href={`${BASE_URL}${category}/${slug}`} class="bio-art-card" data-tags={allTags.join(',')}>
                          {heroImg && (
                            <div class="bio-art-card-image">
                              <Image src={heroImg} alt={item.data.title} widths={[400]} sizes="280px" loading="lazy" />
                            </div>
                          )}
                          <div class="bio-art-card-year">{item.data.date}</div>
                          <div class="bio-art-card-title">{item.data.title}</div>
                          {item.data.short && <div class="bio-art-card-desc">{item.data.short}</div>}
                        </a>
                      );
                    })}
                  </div>
                  <button class="expand-btn" data-target={subId} aria-expanded="false">
                    <span class="expand-btn-text">Mehr anzeigen</span>
                    <svg class="expand-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </button>
                </div>
              );
            })}
          </div>
        );
      }
      
      // Regular (non-group) category
      const catalog = 'catalog' in cat ? cat.catalog : null;
      return (
        <div class="category-section" data-category={cat.id} data-category-tag={cat.id}>
          <h2 class="bio-section-title">{cat.title}</h2>
          <div class="bio-art-grid" data-expand={cat.id}>
            {catalog && (
              <a href="#" class="bio-art-card bio-art-card--catalog" data-catalog-id={cat.id} data-tags={catalogTags(cat)}>
                <span class="bio-art-card-badge">Katalog</span>
                {(() => {
                  const coverImg = getCatalogCover(cat.id);
                  return coverImg ? (
                    <div class="bio-art-card-image">
                      <Image src={coverImg} alt={catalog.title} widths={[400]} sizes="280px" loading="lazy" />
                    </div>
                  ) : null;
                })()}
                {(() => {
                  const catalogMeta = {
                    glas:    { year: '2016', title: 'Katalog Fusingglas', desc: 'Lichtblicke – Objekte aus Fusingglas' },
                    malerei: { year: '2021', title: 'Katalog Malerei',    desc: 'Spiegelbilder – Im Widerschein der Farbe' },
                  }[cat.id];
                  return catalogMeta ? (
                    <>
                      <div class="bio-art-card-year">{catalogMeta.year}</div>
                      <div class="bio-art-card-title">{catalogMeta.title}</div>
                      <div class="bio-art-card-desc">{catalogMeta.desc}</div>
                    </>
                  ) : (
                    <>
                      <div class="bio-art-card-year">Katalog</div>
                      <div class="bio-art-card-title">{catalog.title}</div>
                      <div class="bio-art-card-desc">Als Blätterkatalog durchstöbern</div>
                    </>
                  );
                })()}
              </a>
            )}
            {worksByCategory[cat.id].map((item) => {
              const slug = item.id.split('/').pop();
              const category = item.id.split('/')[0];
              const heroImg = getHeroImage(item.data.image_dir);
              const allTags = [
                ...item.data.tags.kategorie,
                ...item.data.tags.kontext,
                ...item.data.tags.gebaeudetyp,
                ...item.data.tags.material
              ].filter(Boolean);
              return (
                <a href={`${BASE_URL}${category}/${slug}`} class="bio-art-card" data-tags={allTags.join(',')}>
                  {heroImg && (
                    <div class="bio-art-card-image">
                      <Image src={heroImg} alt={item.data.title} widths={[400]} sizes="280px" loading="lazy" />
                    </div>
                  )}
                  <div class="bio-art-card-year">{item.data.date}</div>
                  <div class="bio-art-card-title">{item.data.title}</div>
                  {item.data.short && <div class="bio-art-card-desc">{item.data.short}</div>}
                </a>
              );
            })}
          </div>
          <button class="expand-btn" data-target={cat.id} aria-expanded="false">
            <span class="expand-btn-text">Mehr anzeigen</span>
            <svg class="expand-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>
      );
    })}
    </div>
  </div>
  
  <script is:inline>
  // Catalog card click handler — open modal instead of navigating
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-catalog-id]');
    if (!btn) return;
    var catalogId = btn.dataset.catalogId;
    if (!catalogId || !window.openCatalogModal) return;
    e.preventDefault();
    window.openCatalogModal(catalogId);
  });
</script>

</BaseLayout>

<script>
  function setupWorkPage() {
    // --- Tag Filter ---
    var chips = document.querySelectorAll('.tag-chip');
    var cards = document.querySelectorAll('.bio-art-card');
    var categorySections = document.querySelectorAll('.category-section');
    var filterToggle = document.getElementById('filter-toggle');
    var filterDialog = document.getElementById('filter-dialog');
    var filterDialogClose = document.getElementById('filter-dialog-close');
    var filterDialogApply = document.getElementById('filter-dialog-apply');
    var filterCount = document.getElementById('filter-count');
    var filterResults = document.getElementById('filter-results');
    var filterResultsGrid = document.getElementById('filter-results-grid');
    var filterStatus = document.getElementById('filter-status');
    var filterToast = document.getElementById('filter-toast');
    var filterToastTimer = null;

    function showFilterToast(text) {
      if (!filterToast) return;
      var textEl = document.getElementById('filter-toast-text');
      if (textEl) textEl.textContent = text;
      else filterToast.textContent = text;
      filterToast.hidden = false;
      // Neue Einblendung startet die Verweildauer neu.
      if (filterToastTimer) clearTimeout(filterToastTimer);
      filterToastTimer = setTimeout(hideFilterToast, 2500);
    }

    // Gemeinsames Ausblenden: animiertes Herausfallen (gleiche Animation für
    // Timer-Ablauf und Karten-Hover), dann verstecken.
    function hideFilterToast() {
      if (!filterToast || filterToast.hidden) return;
      if (filterToastTimer) {
        clearTimeout(filterToastTimer);
        filterToastTimer = null;
      }
      filterToast.classList.add('filter-toast--out');
      setTimeout(function() {
        filterToast.classList.remove('filter-toast--out');
        filterToast.hidden = true;
      }, 300);
    }

    function getActiveTags() {
      // Returns flat array of all selected tag values
      var active = [];
      chips.forEach(function(chip) {
        if (chip.getAttribute('aria-pressed') === 'true') {
          active.push(chip.getAttribute('data-tag'));
        }
      });
      return active;
    }

    function applyTagFilter() {
      var activeTags = getActiveTags();
      var hasAnyFilter = activeTags.length > 0;

      if (hasAnyFilter) {
        // Flat result view: hide category sections, show a single sorted grid
        categorySections.forEach(function(section) {
          section.classList.add('category-hidden');
        });

        // Collect matching cards (exclude catalog cards without data-tags)
        var matches = [];
        cards.forEach(function(card) {
          var cardTags = (card.getAttribute('data-tags') || '').split(',');
          var ok = activeTags.every(function(tag) {
            return cardTags.indexOf(tag) !== -1;
          });
          if (ok) matches.push(card);
        });

        // Sort matches: Reihenfolge hängt von der Auswahl ab.
        // - Ist „Freies Werk" aktiv (ggf. + Glas/Malerei): Kataloge zuerst,
        //   dann Kunst am Bau, dann freie Werke.
        // - Ist nur Glas/Malerei aktiv (kein „Freies Werk"): Kunst-am-Bau-
        //   Projekte zuerst, direkt gefolgt von den Katalogen, dann freie Werke.
        // Innerhalb desselben Rangs: Jahr absteigend (undatierte ans Ende).
        var freeWorkActive = activeTags.indexOf('Freies Werk') !== -1;
        function cardRank(card) {
          var isCat = card.getAttribute('data-catalog-id') !== null;
          var isKab = (card.getAttribute('data-tags') || '').indexOf('Kunst am Bau') !== -1;
          if (freeWorkActive) {
            if (isCat) return 0;
            if (isKab) return 1;
            return 2;
          }
          if (isKab) return 0;
          if (isCat) return 1;
          return 2;
        }
        function yearNum(text) {
          var m = text.match(/(\d{4})/);
          return m ? parseInt(m[1], 10) : 0;
        }
        matches.sort(function(a, b) {
          var ra = cardRank(a);
          var rb = cardRank(b);
          if (ra !== rb) return ra - rb;
          var ta = (a.querySelector('.bio-art-card-year') || {}).textContent || '';
          var tb = (b.querySelector('.bio-art-card-year') || {}).textContent || '';
          return yearNum(tb) - yearNum(ta);
        });

        filterResultsGrid.innerHTML = '';
        matches.forEach(function(card) {
          var clone = card.cloneNode(true);
          clone.classList.remove('is-hidden', 'tag-hidden');
          filterResultsGrid.appendChild(clone);
        });
        filterResults.hidden = false;
      } else {
        // Browse view: restore category sections, clear flat grid
        filterResults.hidden = true;
        filterResultsGrid.innerHTML = '';
        categorySections.forEach(function(section) {
          section.classList.remove('category-hidden');
        });
        document.querySelectorAll('[data-expand]').forEach(function(grid) {
          updateGrid(grid);
        });
      }

      updateFilterUI(activeTags);
    }

    function updateFilterUI(activeTags) {
      // Count badge: zeigt die Anzahl aktiver Schlüsselbegriffe.
      // Die Chips selbst bleiben schwarz eingefärbt, solange sie aktiv sind —
      // das genügt als visuelle Signalisierung, keine zusätzlichen Pills nötig.
      if (activeTags.length > 0) {
        filterCount.textContent = activeTags.length;
        filterCount.hidden = false;
      } else {
        filterCount.hidden = true;
      }
    }

    // Dialog öffnen (Mobile-Overlay; auf Desktop ist der Dialog als Sidebar
    // dauerhaft sichtbar und der Toggle ausgeblendet).
    filterToggle.addEventListener('click', function() {
      filterToggle.setAttribute('aria-expanded', 'true');
      filterDialog.showModal();
    });

    filterDialogClose.addEventListener('click', function() {
      filterDialog.close();
      filterToggle.setAttribute('aria-expanded', 'false');
    });

    // Anwenden: Filter anwenden und Overlay schließen.
    filterDialogApply.addEventListener('click', function() {
      applyTagFilter();
      filterDialog.close();
      filterToggle.setAttribute('aria-expanded', 'false');
    });

    // Klick auf den Backdrop schließt das Overlay.
    filterDialog.addEventListener('click', function(e) {
      if (e.target === filterDialog) {
        filterDialog.close();
        filterToggle.setAttribute('aria-expanded', 'false');
      }
    });

    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        var isPressed = chip.getAttribute('aria-pressed') === 'true';
        var tagKey = chip.getAttribute('data-tag-key');
        var disabled = chip.getAttribute('aria-disabled') === 'true';
        // Gesperrter Chip (Kombination ergäbe 0 Treffer): kein Zustandswechsel,
        // nur Shake + Status-Meldung als Feedback.
        if (disabled && !isPressed) {
          chip.classList.add('tag-chip--shake');
          setTimeout(function() { chip.classList.remove('tag-chip--shake'); }, 500);
          var msg = '„' + chip.getAttribute('data-tag') + '" ergibt in dieser Kombination keine Treffer.';
          if (filterStatus) filterStatus.textContent = msg;
          showFilterToast(msg);
          return;
        }
        // XOR innerhalb einer Kategorie: ein bereits aktiver Schlüsselbegriff
        // in derselben Kategorie (z. B. Gebäudetyp) wird ersetzt statt ergänzt.
        if (!isPressed && tagKey && (chip.parentElement.getAttribute('data-single-select') === 'true')) {
          var siblings = chip.parentElement.querySelectorAll('.tag-chip[aria-pressed="true"]');
          siblings.forEach(function(sib) {
            sib.setAttribute('aria-pressed', 'false');
          });
        }
        chip.setAttribute('aria-pressed', isPressed ? 'false' : 'true');
        updateFacetCounts();
        applyTagFilter();
      });
    });

    // Facet-Counts: Die Zahl neben jedem Schlüsselbegriff zeigt, wie viele
    // Treffer entstehen, wenn dieser Begriff zur aktuellen Auswahl hinzukäme
    // (nicht die isolierte Gesamtzahl). Material bleibt Multi-Select: eine
    // Kombination mit 0 Treffern sperrt den Chip und antwortet mit Shake +
    // Meldung statt Auswahl.
    function countMatches(selected) {
      return Array.prototype.filter.call(cards, function(card) {
        var cardTags = (card.getAttribute('data-tags') || '').split(',');
        return selected.every(function(t) { return cardTags.indexOf(t) !== -1; });
      }).length;
    }

    function updateFacetCounts() {
      var activeTags = getActiveTags();
      var activeByKey = {};
      chips.forEach(function(c) {
        if (c.getAttribute('aria-pressed') === 'true') {
          var key = c.getAttribute('data-tag-key');
          (activeByKey[key] = activeByKey[key] || []).push(c.getAttribute('data-tag'));
        }
      });
      chips.forEach(function(c) {
        var key = c.getAttribute('data-tag-key');
        var tag = c.getAttribute('data-tag');
        var isSingle = c.parentElement.getAttribute('data-single-select') === 'true';
        var own = activeByKey[key] || [];
        // Testauswahl: aktive Begriffe, wobei bei Single-Gruppen der evtl.
        // aktive Begriff derselben Gruppe durch diesen ersetzt wird.
        var test = isSingle
          ? activeTags.filter(function(t) { return own.indexOf(t) === -1; })
          : activeTags.slice();
        if (test.indexOf(tag) === -1) test.push(tag);
        var count = countMatches(test);
        var el = c.querySelector('.tag-chip-count');
        if (el) el.textContent = count;
        // Sperren kategorieübergreifend: jeder Chip, dessen Kombination mit
        // der aktuellen Auswahl 0 Treffer liefert, wird ausgegraut. Aktive
        // Chips bleiben klickbar (Toggle off).
        var isPressed = c.getAttribute('aria-pressed') === 'true';
        if (!isPressed && count === 0 && test.length > 1) {
          c.setAttribute('aria-disabled', 'true');
        } else {
          c.setAttribute('aria-disabled', 'false');
        }
      });
    }

    updateFacetCounts();

    // Toast verdeckt keine Karte: Sobald der Nutzer eine Karte berührt,
    // verschwindet der Toast sofort mit derselben Animation wie beim
    // Timer-Ablauf. Delegation am Dokument, damit auch die geklonten Karten
    // im Filter-Ergebnis-Grid erfasst werden.
    document.addEventListener('mouseover', function(e) {
      if (e.target.closest && e.target.closest('.bio-art-card')) {
        hideFilterToast();
      }
    });

    // --- Expandable Grids ---
    var grids = document.querySelectorAll('[data-expand]');
    var buttons = document.querySelectorAll('.expand-btn');

    function countColumns(grid) {
      var style = getComputedStyle(grid);
      var gap = parseFloat(style.columnGap) || parseFloat(style.gap) || 0;
      var width = grid.clientWidth;
      return Math.max(1, Math.floor((width + gap) / (280 + gap)));
    }

    function hasActiveFilter() {
      return document.querySelectorAll('.tag-chip[aria-pressed="true"]').length > 0;
    }

    function updateGrid(grid) {
      var gridId = grid.getAttribute('data-expand');
      var btn = document.querySelector('.expand-btn[data-target="' + gridId + '"]');
      if (!btn) return;

      var visibleCards = Array.from(grid.querySelectorAll('.bio-art-card:not(.tag-hidden)'));
      var cols = countColumns(grid);
      var isExpanded = btn.getAttribute('aria-expanded') === 'true';
      var isFiltering = hasActiveFilter();

      // When a filter is active, show ALL matching cards (user knows what they want)
      // When no filter, use expand/collapse logic (show first row only)
      visibleCards.forEach(function(card, i) {
        if (isFiltering || isExpanded || i < cols) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });

      // Ensure tag-hidden cards stay hidden
      var hiddenByTag = Array.from(grid.querySelectorAll('.bio-art-card.tag-hidden'));
      hiddenByTag.forEach(function(card) {
        card.classList.add('is-hidden');
      });

      // Hide expand button when filtering (all cards already visible)
      if (isFiltering) {
        btn.style.display = 'none';
      } else {
        btn.style.display = visibleCards.length <= cols ? 'none' : '';
      }
    }

    grids.forEach(function(grid) { updateGrid(grid); });

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var targetId = btn.getAttribute('data-target');
        var grid = document.querySelector('[data-expand="' + targetId + '"]');
        if (!grid) return;

        var expanding = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', expanding ? 'true' : 'false');
        btn.querySelector('.expand-btn-text').textContent = expanding ? 'Weniger anzeigen' : 'Mehr anzeigen';
        btn.querySelector('.expand-btn-arrow').classList.toggle('rotated', expanding);

        updateGrid(grid);
      });
    });

    var observer = new ResizeObserver(function() {
      grids.forEach(function(grid) { updateGrid(grid); });
    });
    grids.forEach(function(grid) { observer.observe(grid); });
  }

  setupWorkPage();
  document.addEventListener('astro:page-load', setupWorkPage);
</script>

<style>
  /* Filter Bar: nur auf Mobile sichtbar (öffnet das Dialog-Overlay).
     Auf Desktop ist die Sidebar dauerhaft sichtbar. */
  .filter-bar {
    position: relative;
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .filter-bar {
      display: flex;
    }
  }

  .filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.5rem;
    background: transparent !important;
    border: 1px solid var(--color-primary) !important;
    border-radius: var(--radius) !important;
    box-shadow: none !important;
    color: var(--color-primary) !important;
    font-family: var(--font-sans-serif);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    font-variant: small-caps;
    line-height: 1.4 !important;
    /* Feste Höhe: der Count-Badge (22px) ist höher als die Textzeile und
       würde den Button sonst aufklappen, sobald ein Filter aktiv ist. */
    height: 38px !important;
    box-sizing: border-box;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .filter-toggle:hover {
    background: var(--color-primary) !important;
    color: var(--color-bg) !important;
    border-color: var(--color-primary) !important;
    box-shadow: none !important;
  }

  .filter-toggle-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .filter-toggle:hover .filter-toggle-count {
    background: var(--color-bg);
    color: var(--color-primary);
  }

  .filter-toggle-count[hidden] {
    display: none;
  }

  /* Hybrid-Layout: Desktop = Sidebar links + Grid rechts, Mobile = Dialog-Overlay. */
  .work-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .work-sidebar {
    position: sticky;
    top: 2rem;
    /* Linkskante bündig mit dem Nav-Text (Seitenrand 38px + 10px = 48px). */
    margin-left: 10px;
  }

  .work-sidebar-title {
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: 1.3rem;
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
    color: var(--color-primary);
    /* Aus dem Flow genommen: schwebt über dem Kasten, mit etwas Luft zur
       oberen Rahmenkante (nicht mehr exakt bündig mit „Kunst am Bau"). */
    position: absolute;
    top: 6px;
    left: 0;
    margin: 0;
  }

  .work-content {
    min-width: 0;
  }

  /* Filter-Dialog: Desktop als Sidebar, Mobile als Overlay. */
  .filter-dialog {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1.5rem;
    margin: 0;
    /* Kasten um die Filteroptionen: gleicher Strichtyp wie die Trennlinien.
       Obere Kante exakt bündig mit dem Trennstrich unter „Kunst am Bau":
       Grid-Oberkante (91.9px) + 30px = 121.9px = Unterkante des Sektions-Titels. */
    margin-top: 30px;
    border: 1px solid var(--color-border);
    background: transparent;
    max-width: none;
    max-height: none;
    width: auto;
    height: auto;
    /* Geschlossene <dialog> sind per Default position:absolute und fallen
       aus dem Flow — auf Desktop in den Flow zurückholen, damit die Pills
       sauber unter den Chips erscheinen. */
    position: static;
  }

  .filter-dialog-header,
  .filter-dialog-footer {
    display: none;
  }

  .filter-dialog-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  /* Mobile: Overlay über dem Inhalt (Airbnb-Stil). */
  @media (max-width: 900px) {
    .work-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .work-sidebar {
      position: static;
      border-right: 0;
      padding-right: 0;
    }

    .work-sidebar-title {
      display: none;
    }

    .filter-dialog {
      position: fixed;
      inset: 0;
      z-index: 1000;
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: var(--color-bg);
      box-shadow: none;
    }

    .filter-dialog[open] {
      display: flex;
    }

    .filter-dialog-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--color-border);
    }

    .filter-dialog-title {
      font-family: var(--font-sans-serif);
      font-size: 1.2rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: lowercase;
      font-variant: small-caps;
      color: var(--color-primary);
    }

    .filter-dialog-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      padding: 0;
      background: transparent !important;
      border: 1px solid var(--color-border) !important;
      border-radius: 50% !important;
      box-shadow: none !important;
      color: var(--color-base) !important;
      cursor: pointer;
    }

    .filter-dialog-body {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
    }

    .filter-dialog-footer {
      display: block;
      padding: 1rem 1.5rem;
      border-top: 1px solid var(--color-border);
    }

    .filter-dialog-apply {
      display: block;
      width: 100%;
      padding: 0.9rem 1.5rem;
      background: var(--color-primary) !important;
      border: 1px solid var(--color-primary) !important;
      border-radius: var(--radius) !important;
      box-shadow: none !important;
      color: var(--color-bg) !important;
      font-family: var(--font-sans-serif);
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: lowercase;
      font-variant: small-caps;
      line-height: 1.4 !important;
      height: auto !important;
      cursor: pointer;
    }

    .filter-dialog-apply:hover {
      background: color-mix(in srgb, var(--color-primary) 85%, #000) !important;
      border-color: var(--color-primary) !important;
    }
  }

  .tag-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .tag-group-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: 1.3rem;
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
    /* Abweichung zu .bio-section-subtitle: eingefärbt statt grau. */
    color: var(--color-primary);
  }

  .tag-group-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1.3rem;
    background: transparent !important;
    border: 1px solid var(--color-border) !important;
    border-radius: 999px !important;
    box-shadow: none !important;
    color: var(--color-base) !important;
    font-family: var(--font-sans-serif) !important;
    font-size: 1.1rem !important;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.4 !important;
    height: auto !important;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .tag-chip:hover {
    background: transparent !important;
    color: var(--color-primary) !important;
    border-color: var(--color-primary) !important;
    box-shadow: none !important;
  }

  /* Dezente Trefferzahl pro Schlüsselbegriff (Facet-Filter-Standard). */
  .tag-chip-count {
    margin-left: 0.5rem;
    font-size: 0.85rem;
    opacity: 0.55;
  }

  /* Gesperrter Chip: Kombination ergäbe 0 Treffer — ausgegraut.
     Klicks bleiben möglich (kein pointer-events), damit der Handler
     mit Shake + Status-Meldung antworten statt zu deaktivieren.
     Hover in Rot: signalisiert "ungültige Auswahl" statt aktivierbar. */
  .tag-chip[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .tag-chip[aria-disabled='true']:hover {
    opacity: 0.75;
    color: #b3382e !important;
    border-color: #b3382e !important;
    box-shadow: none !important;
  }

  .tag-chip[aria-disabled='true'] .tag-chip-count {
    color: #b3382e;
  }

  /* Shake-Feedback beim Klick auf einen gesperrten Chip. */
  .tag-chip--shake {
    animation: chip-shake 0.45s ease;
  }

  @keyframes chip-shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-4px); }
    40% { transform: translateX(4px); }
    60% { transform: translateX(-3px); }
    80% { transform: translateX(2px); }
  }

  /* [hidden] muss das display:flex des Toasts überschreiben, sonst ist der
     Toast permanent sichtbar (Default [hidden] = display:none gilt nur, wenn
     kein eigenes display gesetzt ist). */
  .filter-toast[hidden] {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Hinweis-Toast bei Klick auf eine gesperrte Kombination.
     In den Site-Farben: Papier-Hintergrund, dunkle Schrift, Petrol-Akzent,
     weicher Schatten. Slide-up + Fade beim Einblenden (mit reduziertem
     Motion-Respekt); Ausblenden per [hidden]. */
  .filter-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3000;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    /* Breite schrumpft auf den Inhalt: Der Rahmen umschließt den Text immer
       vollständig. Kappung nur gegen den Viewport — eine kleinere Kappung
       würde den Einzeiler rechts überstehen lassen. */
    width: fit-content;
    max-width: 92vw;
    /* padding-left um die Border-Differenz reduziert (4px Akzent vs. 1px):
       Abstand Icon→linke Kante == Abstand Textende→rechte Kante. */
    padding: 1.2rem 1.6rem 1.2rem calc(1.6rem - 3px);
    background: var(--color-card-bg);
    color: var(--color-base);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 0.6rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
    font-family: var(--font-sans-serif);
    font-size: 1.3rem;
    line-height: 1.5;
    text-align: left;
    white-space: nowrap;
    /* Rein informativ: Hover/Maus geht direkt an die Karten darunter,
       der Toast verdeckt sie nicht. */
    pointer-events: none;
    animation: toast-in 0.4s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .filter-toast-icon {
    flex-shrink: 0;
    color: var(--color-primary);
  }

  /* Herausfallen beim Ausblenden (Spiegelbild des Einfliegens). */
  .filter-toast--out {
    animation: toast-out 0.3s cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  @keyframes toast-out {
    from {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    to {
      opacity: 0;
      transform: translateX(-50%) translateY(1.2rem);
    }
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(1.2rem);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-toast,
    .filter-toast--out {
      animation: none;
      transition: none;
    }
  }

  /* Sektionsüberschriften: alle (Gruppen wie Glas/Malerei) einheitlich
     formatiert wie „Kunst am Bau". */
  .bio-section-title,
  .bio-section-title--group {
    font-family: var(--font-sans-serif);
