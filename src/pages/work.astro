  /* Katalog-Karten: Petrol-Rahmen + Badge oben rechts, um sie von
     Werk-Detailkarten zu unterscheiden (öffnen ein Blätterkatalog-Modal). */
  .bio-art-card--catalog {
    position: relative;
    border-width: 2px;
    border-color: var(--color-primary);
  }

  .bio-art-card--catalog .bio-art-card-badge {
    position: absolute;
