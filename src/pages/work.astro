---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allWorks = await getCollection('works');

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,png}',
  { eager: true }
);

function getHeroImage(dir: string) {
  // Try direct file match first (e.g. 'freie_werke/bubbles-ii.jpg')
  let key = Object.keys(allImages).find(k => k.endsWith(`/${dir}`));
  if (key) return allImages[key].default;
  // Fall back to directory with 1.jpg (e.g. 'atem' -> 'atem/1.jpg')
  key = Object.keys(allImages).find(k => k.includes(`/${dir}/1.jpg`));
  return key ? allImages[key].default : null;
}

function getCatalogCover(id: string) {
  const key = Object.keys(allImages).find(k => k.includes(`/kataloge/${id}_cover.`));
  return key ? allImages[key].default : null;
}

// Collect unique tags per group from all works
const kategorieTags = [...new Set(allWorks.flatMap(w => w.data.tags.kategorie).filter(Boolean))].sort();
const kontextTags = [...new Set(allWorks.flatMap(w => w.data.tags.kontext).filter(Boolean))].sort();
const gebaeudetypTags = [...new Set(allWorks.flatMap(w => w.data.tags.gebaeudetyp).filter(Boolean))].sort();
const materialTags = [...new Set(allWorks.flatMap(w => w.data.tags.material).filter(Boolean))].sort();

// Tag groups for display
const tagGroups = [
  { label: 'Kategorie', key: 'kategorie', tags: kategorieTags },
  { label: 'Kontext', key: 'kontext', tags: kontextTags },
  { label: 'Gebäudetyp', key: 'gebaeudetyp', tags: gebaeudetypTags },
  { label: 'Material', key: 'material', tags: materialTags },
];

// Primary categories
const categories = [
  {
    id: 'kunst_am_bau',
    title: 'Kunst am Bau',
    isGroup: true,
    subsections: [
      { id: 'profan',  title: 'Profan',  tag: 'Profan' },
      { id: 'sakral',  title: 'Sakral',  tag: 'Sakral' },
    ],
  },
  {
    id: 'glas',
    title: 'Glas',
    isGroup: false,
    catalog: {
      title: 'Katalog Fusingglas',
      href: '/katalog/glas',
    },
    filter: (w: typeof allWorks[number]) =>
      w.data.tags.kategorie.includes('Freies Werk') && w.data.tags.material.includes('Glas'),
  },
  {
    id: 'malerei',
    title: 'Malerei',
    isGroup: false,
    catalog: {
      title: 'Katalog Malerei',
      href: '/katalog/malerei',
    },
    filter: (w: typeof allWorks[number]) =>
      w.data.tags.kategorie.includes('Freies Werk') && w.data.tags.material.includes('Malerei'),
  },
];

// Sort key: erste Jahreszahl; Werke ohne Datum (z. B. "t.b.d.") bekommen 0 und landen hinten.
function yearNum(date: string): number {
  const m = date.match(/(\d{4})/);
  return m ? parseInt(m[1], 10) : 0;
}

function sortByDateDesc(a: typeof allWorks[number], b: typeof allWorks[number]) {
  return yearNum(b.data.date) - yearNum(a.data.date);
}

// Build works per category
function getWorksForCategory(cat: typeof categories[number]) {
  if ('filter' in cat && cat.filter) {
    return allWorks.filter(cat.filter).sort(sortByDateDesc);
  }
  if ('subsections' in cat && cat.subsections) {
    return []; // group categories don't have works directly
  }
  return [];
}

const worksByCategory = Object.fromEntries(
  categories.map(cat => [cat.id, getWorksForCategory(cat)])
);

// Flat, date-sorted list of all works for the filtered result view
const allWorksSorted = [...allWorks].sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout>
  <div class="bio-section work-layout">
    <aside class="work-sidebar">
      <!-- Überschrift: benennt die Sidebar als Filterbereich.
           Nur Desktop sichtbar — im Mobile-Overlay übernimmt der Dialog-Header. -->
      <h2 class="work-sidebar-title">Filteroptionen</h2>

      <!-- Filter Bar (nur Mobile: öffnet das Dialog-Overlay) -->
      <div class="filter-bar">
        <button class="filter-toggle" id="filter-toggle" aria-expanded="false" aria-controls="filter-dialog">
          <span class="filter-toggle-label">Filter</span>
          <span class="filter-toggle-count" id="filter-count" hidden>0</span>
        </button>
      </div>

      <!-- Filter-Dialog: Desktop als sticky Sidebar, Mobile als Overlay.
           Eine einzige Quelle für die Chips — kein Duplikat, keine Sync-Probleme. -->
      <dialog class="filter-dialog" id="filter-dialog">
        <div class="filter-dialog-header">
          <span class="filter-dialog-title">Filter</span>
          <button class="filter-dialog-close" id="filter-dialog-close" aria-label="Filter schließen">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="filter-dialog-body">
          {tagGroups.map(group => (
            <div class="tag-group">
              <span class="tag-group-label">
                {group.label}
              </span>
              <div class="tag-group-chips">
                {group.tags.map(tag => (
                  <button class="tag-chip" data-tag-key={group.key} data-tag={tag} aria-pressed="false">
                    {tag}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="filter-dialog-footer">
          <button class="filter-dialog-apply" id="filter-dialog-apply">Anwenden</button>
        </div>
      </dialog>
    </aside>

    <div class="work-content">
      <!-- Flat filtered results (shown only when a filter is active) -->
      <div class="filter-results" id="filter-results" hidden>
        <div class="bio-art-grid" id="filter-results-grid"></div>
      </div>

    {categories.map(cat => {
      if ('isGroup' in cat && cat.isGroup && 'subsections' in cat && cat.subsections) {
        return (
          <div class="category-section category-section--group" data-category={cat.id}>
            <h2 class="bio-section-title bio-section-title--group">{cat.title}</h2>
            {cat.subsections.map(sub => {
              const subWorks = allWorks
                .filter(w => w.data.tags.kontext.includes(sub.tag))
                .sort(sortByDateDesc);
              const subId = cat.id + '_' + sub.id;
              return (
                <div class="category-section" data-category={subId} data-category-tag={sub.tag}>
                  <h3 class="bio-section-subtitle">{sub.title}</h3>
                  <div class="bio-art-grid" data-expand={subId}>
                    {subWorks.map((item) => {
                      const slug = item.id.split('/').pop();
                      const category = item.id.split('/')[0];
                      const heroImg = getHeroImage(item.data.image_dir);
                      const allTags = [
                        ...item.data.tags.kategorie,
                        ...item.data.tags.kontext,
                        ...item.data.tags.gebaeudetyp,
                        ...item.data.tags.material
                      ].filter(Boolean);
                      return (
                        <a href={`/${category}/${slug}`} class="bio-art-card" data-tags={allTags.join(',')}>
                          {heroImg && (
                            <div class="bio-art-card-image">
                              <Image src={heroImg} alt={item.data.title} widths={[400]} sizes="280px" loading="lazy" />
                            </div>
                          )}
                          <div class="bio-art-card-year">{item.data.date}</div>
                          <div class="bio-art-card-title">{item.data.title}</div>
                          {item.data.short && <div class="bio-art-card-desc">{item.data.short}</div>}
                        </a>
                      );
                    })}
                  </div>
                  <button class="expand-btn" data-target={subId} aria-expanded="false">
                    <span class="expand-btn-text">Mehr anzeigen</span>
                    <svg class="expand-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </button>
                </div>
              );
            })}
          </div>
        );
      }
      
      // Regular (non-group) category
      const catalog = 'catalog' in cat ? cat.catalog : null;
      return (
        <div class="category-section" data-category={cat.id} data-category-tag={cat.id}>
          <h2 class="bio-section-title">{cat.title}</h2>
          <div class="bio-art-grid" data-expand={cat.id}>
            {catalog && (
              <a href="#" class="bio-art-card" data-catalog-id={cat.id}>
                {(() => {
                  const coverImg = getCatalogCover(cat.id);
                  return coverImg ? (
                    <div class="bio-art-card-image">
                      <Image src={coverImg} alt={catalog.title} widths={[400]} sizes="280px" loading="lazy" />
                    </div>
                  ) : null;
                })()}
                {(() => {
                  const catalogMeta = {
                    glas:    { year: '2016', title: 'Katalog Fusingglas', desc: 'Lichtblicke – Objekte aus Fusingglas' },
                    malerei: { year: '2021', title: 'Katalog Malerei',    desc: 'Spiegelbilder – Im Widerschein der Farbe' },
                  }[cat.id];
                  return catalogMeta ? (
                    <>
                      <div class="bio-art-card-year">{catalogMeta.year}</div>
                      <div class="bio-art-card-title">{catalogMeta.title}</div>
                      <div class="bio-art-card-desc">{catalogMeta.desc}</div>
                    </>
                  ) : (
                    <>
                      <div class="bio-art-card-year">Katalog</div>
                      <div class="bio-art-card-title">{catalog.title}</div>
                      <div class="bio-art-card-desc">Als Blätterkatalog durchstöbern</div>
                    </>
                  );
                })()}
              </a>
            )}
            {worksByCategory[cat.id].map((item) => {
              const slug = item.id.split('/').pop();
              const category = item.id.split('/')[0];
              const heroImg = getHeroImage(item.data.image_dir);
              const allTags = [
                ...item.data.tags.kategorie,
                ...item.data.tags.kontext,
                ...item.data.tags.gebaeudetyp,
                ...item.data.tags.material
              ].filter(Boolean);
              return (
                <a href={`/${category}/${slug}`} class="bio-art-card" data-tags={allTags.join(',')}>
                  {heroImg && (
                    <div class="bio-art-card-image">
                      <Image src={heroImg} alt={item.data.title} widths={[400]} sizes="280px" loading="lazy" />
                    </div>
                  )}
                  <div class="bio-art-card-year">{item.data.date}</div>
                  <div class="bio-art-card-title">{item.data.title}</div>
                  {item.data.short && <div class="bio-art-card-desc">{item.data.short}</div>}
                </a>
              );
            })}
          </div>
          <button class="expand-btn" data-target={cat.id} aria-expanded="false">
            <span class="expand-btn-text">Mehr anzeigen</span>
            <svg class="expand-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>
      );
    })}
    </div>
  </div>
  
  <script is:inline>
  // Catalog card click handler — open modal instead of navigating
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-catalog-id]');
    if (!btn) return;
    var catalogId = btn.dataset.catalogId;
    if (!catalogId || !window.openCatalogModal) return;
    e.preventDefault();
    window.openCatalogModal(catalogId);
  });
</script>

</BaseLayout>

<script>
  function setupWorkPage() {
    // --- Tag Filter ---
    var chips = document.querySelectorAll('.tag-chip');
    var cards = document.querySelectorAll('.bio-art-card');
    var categorySections = document.querySelectorAll('.category-section');
    var filterToggle = document.getElementById('filter-toggle');
    var filterDialog = document.getElementById('filter-dialog');
    var filterDialogClose = document.getElementById('filter-dialog-close');
    var filterDialogApply = document.getElementById('filter-dialog-apply');
    var filterCount = document.getElementById('filter-count');
    var filterResults = document.getElementById('filter-results');
    var filterResultsGrid = document.getElementById('filter-results-grid');

    function getActiveTags() {
      // Returns flat array of all selected tag values
      var active = [];
      chips.forEach(function(chip) {
        if (chip.getAttribute('aria-pressed') === 'true') {
          active.push(chip.getAttribute('data-tag'));
        }
      });
      return active;
    }

    function applyTagFilter() {
      var activeTags = getActiveTags();
      var hasAnyFilter = activeTags.length > 0;

      if (hasAnyFilter) {
        // Flat result view: hide category sections, show a single sorted grid
        categorySections.forEach(function(section) {
          section.classList.add('category-hidden');
        });

        // Collect matching cards (exclude catalog cards without data-tags)
        var matches = [];
        cards.forEach(function(card) {
          var cardTags = (card.getAttribute('data-tags') || '').split(',');
          var ok = activeTags.every(function(tag) {
            return cardTags.indexOf(tag) !== -1;
          });
          if (ok) matches.push(card);
        });

        // Sort matches: Kunst am Bau vor Freien Werken, dann Jahr absteigend (undatierte ans Ende)
        function yearNum(text) {
          var m = text.match(/(\d{4})/);
          return m ? parseInt(m[1], 10) : 0;
        }
        matches.sort(function(a, b) {
          var ta = (a.querySelector('.bio-art-card-year') || {}).textContent || '';
          var tb = (b.querySelector('.bio-art-card-year') || {}).textContent || '';
          var katA = (a.getAttribute('data-tags') || '').indexOf('Kunst am Bau') !== -1 ? 0 : 1;
          var katB = (b.getAttribute('data-tags') || '').indexOf('Kunst am Bau') !== -1 ? 0 : 1;
          if (katA !== katB) return katA - katB;
          return yearNum(tb) - yearNum(ta);
        });

        filterResultsGrid.innerHTML = '';
        matches.forEach(function(card) {
          var clone = card.cloneNode(true);
          clone.classList.remove('is-hidden', 'tag-hidden');
          filterResultsGrid.appendChild(clone);
        });
        filterResults.hidden = false;
      } else {
        // Browse view: restore category sections, clear flat grid
        filterResults.hidden = true;
        filterResultsGrid.innerHTML = '';
        categorySections.forEach(function(section) {
          section.classList.remove('category-hidden');
        });
        document.querySelectorAll('[data-expand]').forEach(function(grid) {
          updateGrid(grid);
        });
      }

      updateFilterUI(activeTags);
    }

    function updateFilterUI(activeTags) {
      // Count badge: zeigt die Anzahl aktiver Schlüsselbegriffe.
      // Die Chips selbst bleiben schwarz eingefärbt, solange sie aktiv sind —
      // das genügt als visuelle Signalisierung, keine zusätzlichen Pills nötig.
      if (activeTags.length > 0) {
        filterCount.textContent = activeTags.length;
        filterCount.hidden = false;
      } else {
        filterCount.hidden = true;
      }
    }

    // Dialog öffnen (Mobile-Overlay; auf Desktop ist der Dialog als Sidebar
    // dauerhaft sichtbar und der Toggle ausgeblendet).
    filterToggle.addEventListener('click', function() {
      filterToggle.setAttribute('aria-expanded', 'true');
      filterDialog.showModal();
    });

    filterDialogClose.addEventListener('click', function() {
      filterDialog.close();
      filterToggle.setAttribute('aria-expanded', 'false');
    });

    // Anwenden: Filter anwenden und Overlay schließen.
    filterDialogApply.addEventListener('click', function() {
      applyTagFilter();
      filterDialog.close();
      filterToggle.setAttribute('aria-expanded', 'false');
    });

    // Klick auf den Backdrop schließt das Overlay.
    filterDialog.addEventListener('click', function(e) {
      if (e.target === filterDialog) {
        filterDialog.close();
        filterToggle.setAttribute('aria-expanded', 'false');
      }
    });

    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        var isPressed = chip.getAttribute('aria-pressed') === 'true';
        chip.setAttribute('aria-pressed', isPressed ? 'false' : 'true');
        applyTagFilter();
      });
    });

    // --- Expandable Grids ---
    var grids = document.querySelectorAll('[data-expand]');
    var buttons = document.querySelectorAll('.expand-btn');

    function countColumns(grid) {
      var style = getComputedStyle(grid);
      var gap = parseFloat(style.columnGap) || parseFloat(style.gap) || 0;
      var width = grid.clientWidth;
      return Math.max(1, Math.floor((width + gap) / (280 + gap)));
    }

    function hasActiveFilter() {
      return document.querySelectorAll('.tag-chip[aria-pressed="true"]').length > 0;
    }

    function updateGrid(grid) {
      var gridId = grid.getAttribute('data-expand');
      var btn = document.querySelector('.expand-btn[data-target="' + gridId + '"]');
      if (!btn) return;

      var visibleCards = Array.from(grid.querySelectorAll('.bio-art-card:not(.tag-hidden)'));
      var cols = countColumns(grid);
      var isExpanded = btn.getAttribute('aria-expanded') === 'true';
      var isFiltering = hasActiveFilter();

      // When a filter is active, show ALL matching cards (user knows what they want)
      // When no filter, use expand/collapse logic (show first row only)
      visibleCards.forEach(function(card, i) {
        if (isFiltering || isExpanded || i < cols) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });

      // Ensure tag-hidden cards stay hidden
      var hiddenByTag = Array.from(grid.querySelectorAll('.bio-art-card.tag-hidden'));
      hiddenByTag.forEach(function(card) {
        card.classList.add('is-hidden');
      });

      // Hide expand button when filtering (all cards already visible)
      if (isFiltering) {
        btn.style.display = 'none';
      } else {
        btn.style.display = visibleCards.length <= cols ? 'none' : '';
      }
    }

    grids.forEach(function(grid) { updateGrid(grid); });

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var targetId = btn.getAttribute('data-target');
        var grid = document.querySelector('[data-expand="' + targetId + '"]');
        if (!grid) return;

        var expanding = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', expanding ? 'true' : 'false');
        btn.querySelector('.expand-btn-text').textContent = expanding ? 'Weniger anzeigen' : 'Mehr anzeigen';
        btn.querySelector('.expand-btn-arrow').classList.toggle('rotated', expanding);

        updateGrid(grid);
      });
    });

    var observer = new ResizeObserver(function() {
      grids.forEach(function(grid) { updateGrid(grid); });
    });
    grids.forEach(function(grid) { observer.observe(grid); });
  }

  setupWorkPage();
  document.addEventListener('astro:page-load', setupWorkPage);
</script>

<style>
  /* Filter Bar: nur auf Mobile sichtbar (öffnet das Dialog-Overlay).
     Auf Desktop ist die Sidebar dauerhaft sichtbar. */
  .filter-bar {
    position: relative;
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 900px) {
    .filter-bar {
      display: flex;
    }
  }

  .filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.5rem;
    background: transparent !important;
    border: 1px solid var(--color-primary) !important;
    border-radius: var(--radius) !important;
    box-shadow: none !important;
    color: var(--color-primary) !important;
    font-family: var(--font-sans-serif);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    font-variant: small-caps;
    line-height: 1.4 !important;
    /* Feste Höhe: der Count-Badge (22px) ist höher als die Textzeile und
       würde den Button sonst aufklappen, sobald ein Filter aktiv ist. */
    height: 38px !important;
    box-sizing: border-box;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .filter-toggle:hover {
    background: var(--color-primary) !important;
    color: var(--color-bg) !important;
    border-color: var(--color-primary) !important;
    box-shadow: none !important;
  }

  .filter-toggle-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .filter-toggle:hover .filter-toggle-count {
    background: var(--color-bg);
    color: var(--color-primary);
  }

  .filter-toggle-count[hidden] {
    display: none;
  }

  /* Hybrid-Layout: Desktop = Sidebar links + Grid rechts, Mobile = Dialog-Overlay. */
  .work-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .work-sidebar {
    position: sticky;
    top: 2rem;
    /* Linkskante bündig mit dem Nav-Text (Seitenrand 38px + 10px = 48px). */
    margin-left: 10px;
  }

  .work-sidebar-title {
    font-family: var(--font-sans-serif);
    font-weight: 400;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    text-transform: lowercase;
    font-variant: small-caps;
    letter-spacing: 1px;
    color: var(--color-primary);
    /* Aus dem Flow genommen: schwebt über dem Kasten, mit etwas Luft zur
       oberen Rahmenkante (nicht mehr exakt bündig mit „Kunst am Bau"). */
    position: absolute;
    top: 6px;
    left: 0;
    margin: 0;
  }

  .work-content {
    min-width: 0;
  }

  /* Filter-Dialog: Desktop als Sidebar, Mobile als Overlay. */
  .filter-dialog {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1.5rem;
    margin: 0;
    /* Kasten um die Filteroptionen: gleicher Strichtyp wie die Trennlinien.
       Obere Kante exakt bündig mit dem Trennstrich unter „Kunst am Bau":
       Grid-Oberkante (91.9px) + 30px = 121.9px = Unterkante des Sektions-Titels. */
    margin-top: 30px;
    border: 1px solid var(--color-border);
    background: transparent;
    max-width: none;
    max-height: none;
    width: auto;
    height: auto;
    /* Geschlossene <dialog> sind per Default position:absolute und fallen
       aus dem Flow — auf Desktop in den Flow zurückholen, damit die Pills
       sauber unter den Chips erscheinen. */
    position: static;
  }

  .filter-dialog-header,
  .filter-dialog-footer {
    display: none;
  }

  .filter-dialog-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  /* Mobile: Overlay über dem Inhalt (Airbnb-Stil). */
  @media (max-width: 900px) {
    .work-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .work-sidebar {
      position: static;
      border-right: 0;
      padding-right: 0;
    }

    .work-sidebar-title {
      display: none;
    }

    .filter-dialog {
      position: fixed;
      inset: 0;
      z-index: 1000;
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: var(--color-bg);
      box-shadow: none;
    }

    .filter-dialog[open] {
      display: flex;
    }

    .filter-dialog-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--color-border);
    }

    .filter-dialog-title {
      font-family: var(--font-sans-serif);
      font-size: 1.2rem;
      font-weight: 500;
      letter-spacing: 0.12em;
