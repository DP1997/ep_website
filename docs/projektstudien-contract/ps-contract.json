    "metaInkMin": 0.75,
    "metaInkHard": false,
    "optimizationRequired": true,
    "minCandidates": 2,
    "labelGapSpreadPx": 1,
    "imageHeightMax": "100svh",
    "widthFirstNarrowVw": 60,
    "dimMustDiffer": true
