    "name": "s",
    "definition": "1 s = 1 % der Blattbreite (Frame = .ps-detail.clientWidth)",
    "css": "--ps-s: calc(var(--ps-frame-w) / 100)",
    "referenceWidth": "clientWidth"
  },
  "scope": {
    "compositionMinWidth": 1360,
    "tabletStack": "901-1359 px: stack-Fallback (validiert: Sheet/Center/Footer/Typo/Bild/Overlap/H-Scroll)",
    "mobile": "<=900 px: laeuft als stack-Fallback; eigener Mobile-Modus spaeter (ausserhalb des Vertrags)",
    "wide": ">1920 px: ausserhalb des Vertrags; Implementierung waechst mit"
  },
