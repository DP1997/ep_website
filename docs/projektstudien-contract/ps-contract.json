  "gaps": {
    "horizontal": {
      "s": 1.5,
      "px1440": 17.4
    },
    "vertical": "fit-bound (min 1.0 s, slack 2:1)",
    "caption": 0.5
  },
  "rules": [
    "IRONCLAD: 2D-Raster aus Spalten und Zeilen; jede Zelle zugewiesen",
    "IRONCLAD: Dichte fill = Inhaltsflaeche/BBox >= 0.70 (Ziel 0.78); lokale Luecken erlaubt, kein perfektes Rechteck noetig",
    "IRONCLAD: gleiche Spalte -> linke/rechte Aussenkante buendig; gleiche Zeile -> obere/untere Aussenkante buendig (Flush <= 3 px, Ziel <= 1 px)",
    "IRONCLAD: Feld = Buendigkeitsreferenz; Glyphen duerfen um 1-2 px (Half-Leading) abweichen",
    "IRONCLAD: Schriftgroessen = normierte Tokens; Lesbarkeits-Floor 12 px",
    "IRONCLAD: caption.family = sans; caption s = tokens.caption (PS 1.25, Werk 1.119)",
    "IRONCLAD: sheet.width <= clientWidth - 2*(44 + 2*3% client); sheet.center = clientWidth/2; content.center = sheet.center",
    "IRONCLAD: Bilder natuerlich; deklarierter Crop erlaubt; keine Verzerrung; Upscaling <= 1.5x (Ausnahmen deklariert)",
    "IRONCLAD: overlap = 0; hscroll = 0",
    "IRONCLAD: footer.gap = max(24px, 3% clientWidth) ab tiefster sichtbarer Kante inkl. Caption",
    "IRONCLAD: Spalten-Gaps = 1.5 s; Zeilen-Gaps fit-gebunden",
    "IRONCLAD: Text wird als Glyphenbox gemessen; Buendigkeitsreferenz bleibt das Feld (A4); keine kuenstliche Streckung ueber Spalte/Viewport",
    "OPTIONAL: Labels einzeilig (Umbruch erlaubt)",
    "OPTIONAL: Meta strecken ueber desc.margin/label-gap (F1), Wortabstaende (F2), Leading-Ausgleich (F3)",
    "OPTIONAL: Key/Value-Labels ueber die Spaltenbreite (F6); Spalte verengen statt Woerter spreizen (F8)",
    "OPTIONAL: hero.visible nur hart, solange das Blatt im Viewport liegt; im Stack/scrollend soft",
    "OPTIONAL: at a glance max(sheet.b, footer.b) <= min(780, viewport.h)",
    "IRONCLAD: Width first - Blatt waechst zuerst in die Breite; Verengung nur durch Bild-Constraint (§18.1)",
    "IRONCLAD: jedes Bild passt bei 100 % Zoom vollstaendig in den Viewport (Hoehe <= 100svh)",
    "IRONCLAD: Hero ist das flaechengroesste Bild (>= 1.3x jedes andere, Ziel 1.4x) - auch bei Band-Layouts (§18.2)",
    "IRONCLAD: Copy-Zeile uebernimmt das Spaltenraster der Bildzeile; Meta unter schmaler, Body unter breiter Spalte (§18.3)",
    "SOFT: Meta-Ink-Ziel 0.75 (Diagnose); Flushness hat Vorrang (§18.4)",
    "IRONCLAD: Meta-/Textfeld oben und unten buendig mit seiner Zeile/Zelle; spannende Felder werden gestreckt, F5 entfaellt (§18.4)",
    "IRONCLAD: Layout-Optimierung - nicht das erste gueltige Layout, sondern das dichteste unter allen harten Constraints; mindestens 2 Kandidaten vergleichen (§19)",
    "IRONCLAD: Copy-Felder als Band in EINER Zeile (Meta | Body); Stapeln nur deklariert, wenn die Dichte gehalten wird (§18.4)",
    "IRONCLAD: Textblock horizontal zentrieren, wenn schmaler als die Spalte (gleiche Seitenabstaende) (§18.4)",
    "IRONCLAD: Copy-Feld flush mit genau einer Spalte; Mehrspalten-Span nur voll (links erste, rechts letzte), kein 1,5-Spalten-Span (§18.3)",
    "SOFT: Meta steht links vom Body; sonst Meta ueber Body (Lesefluss), nie rechts/unten (§18.3)",
    "IRONCLAD: Dim-Variante unterscheidet sich in Zeilen-/Spaltenzahl signifikant von der Basis (§18.6)",
    "IRONCLAD: Crops nur deklariert (Seite, Selektor, Ziel-Aspekt, Grund, Freigabe) (§18.5)"
  ],
  "deviations": [
    {
      "rule": "A2 (obere/untere Aussenkante)",
      "page": "villa_fuss, villa_fuss-dim",
      "selector": ".wc-copy--split .wc-aside",
      "reason": "Viewport-normierte Typografie macht die Textzeile hoeher als das deklarierte Bild (copy_image_h 0.1544). Das Bild sitzt mittig; die Luecke oben/unten ist eine lokale Luecke nach A3 (Nutzerentscheidung c).",
      "expiry": "offen"
    }
  ],
  "declared": {
    "crops": [
      {
        "page": "bubbles",
        "selector": ".ps-bubbles-details img",
        "reason": "PDF-Referenz zeigt quadratische Detailkacheln (PDF-Rects ~127x121 vs. natuerlich 169x241)"
      },
      {
        "page": "bademaxx",
        "selector": ".ps-bademaxx-shot--crop img",
        "reason": "3:2-Detail auf 4:3 der uebrigen vier Detailbilder beschnitten (Reihengleichheit)"
      },
      {
        "page": "aufbruch",
        "selector": ".ps-ct-tall img",
        "reason": "PDF-Scan: schwarzer Rahmen/Bildunterschrift entfernt; Hoehe an den Hero angeglichen (0,662)"
      },
      {
        "page": "aufbruch (KAB)",
        "selector": ".wv-heroside .wc-fit-crop img",
        "reason": "Hochformat vertikal beschnitten (ca. 57 px / 6,6 %), damit Ober-/Unterkante mit dem Hero buendig ist (Nutzerfreigabe 22.11.2026)"
      },
      {
        "page": "aufbruch (KAB dim)",
        "selector": ".wv-dstack .wc-fig--crop img",
        "reason": "Hero auf Aspekt 0,9 und Bild 5 auf 0,573 beschnitten (Nutzerfreigabe), damit das Blatt breiter wird und Meta/Text mehr Platz haben"
      },
      {
        "page": "saeulen",
        "selector": ".ps-ct-hero img",
        "reason": "Hero auf die Hoehe der Textspalte beschnitten (erste Zeile unterkantengleich)"
      }
    ],
    "upscales": [
      {
        "page": "bubbles",
        "selector": ".ps-bubbles-details img",
        "reason": "Quellbild nur 169 px breit; Kachel rendert 229-300 px"
      },
      {
        "page": "stoerche-froesche",
        "selector": ".ps-stoerche-fig8 img",
        "reason": "Quellbild nur 134 px breit; Detailkachel rendert bis ~334 px (Desktop)"
      }
    ]
  },
