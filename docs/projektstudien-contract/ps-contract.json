    "textBox": "glyph extents (Range.getClientRects), kein Element-/Spaltenkasten",
    "captionExcludedFromFlush": true,
    "captionIncludedInFooter": true,
    "footerGap": "max(24, 3% clientWidth)",
    "frame": {
      "color": "#d40000",
      "width": 2,
      "boxSizing": "border-box",
      "targets": [
        "image-pixels",
        "text-glyphs"
      ],
      "tight": true,
      "devOnly": true
    },
    "densityBox": "glyph line boxes + image boxes, alle Textknoten im Blatt"
  },
